<div class="@($"flex {HeightClass} w-full items-center justify-center !bg-slate-100")">
    <div class="flex flex-col items-center">
        <div class="relative flex !h-20 !w-20 items-center justify-center">
            <div class="absolute inset-0 !rounded-full !border-4 !border-slate-200"></div>
            <div class="absolute inset-0 animate-spin !rounded-full !border-4 !border-transparent !border-t-slate-900"></div>

            <div class="flex !h-14 !w-14 items-center justify-center !rounded-2xl !bg-slate-900 !text-white shadow-sm">
                <span class="text-xl font-black">P</span>
            </div>
        </div>

        <p class="!mt-5 text-base font-black tracking-[-0.04em] text-slate-900 uppercase">
            PICKLECHIC
        </p>
    </div>
</div>

@code {
    [Parameter] public string HeightClass { get; set; } = "min-h-screen";
}