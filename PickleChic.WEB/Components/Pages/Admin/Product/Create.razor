@attribute [Route(RouterConfig.Admin.CreateProduct)]
@layout AdminLayout

<PageTitle>@Constant.metaDataAdmin Create Product</PageTitle>

<div class="mx-auto w-full max-w-5xl !space-y-6">
    <div class="flex flex-col !gap-4 md:flex-row md:items-center md:justify-between">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">Tạo sản phẩm</h1>
        </div>

        <a href="@RouterConfig.Admin.Products"
           class="inline-flex items-center justify-center !gap-2 !rounded-xl !border !border-slate-200 !bg-white !px-5 !py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:!bg-slate-50">
            <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" />
            Quay lại
        </a>
    </div>

    @if (_isLoadingOptions)
    {
        <EditPageSkeleton FieldCount="4" />
    }
    else
    {
        <div class="!rounded-2xl !border !border-slate-200 !bg-white !p-6 shadow-sm md:!p-8">
            <MudForm @ref="_form"
                     Model="@_model"
                     Validation="@_validator.ValidateValue">
                <div class="!space-y-6">
                    <div>
                        <h2 class="text-lg font-bold text-slate-900">Thông tin sản phẩm</h2>
                    </div>

                    <div class="grid !gap-5 md:grid-cols-2">
                        <div class="md:col-span-2">
                            <MudTextField @bind-Value="_model.ProductName"
                                          For="@(() => _model.ProductName)"
                                          Label="Tên sản phẩm"
                                          Placeholder="Nhập tên sản phẩm"
                                          Variant="Variant.Outlined"
                                          Required="true"
                                          Immediate="true" />
                        </div>

                        <MudSelect T="int"
                                   @bind-Value="_model.CategoryId"
                                   For="@(() => _model.CategoryId)"
                                   Label="Thể loại"
                                   Variant="Variant.Outlined"
                                   Required="true">
                            @foreach (var category in _categories)
                            {
                                <MudSelectItem T="int" Value="@category.Id">@category.Name</MudSelectItem>
                            }
                        </MudSelect>

                        <MudSelect T="int"
                                   @bind-Value="_model.BrandId"
                                   For="@(() => _model.BrandId)"
                                   Label="Thương hiệu"
                                   Variant="Variant.Outlined"
                                   Required="true">
                            @foreach (var brand in _brands)
                            {
                                <MudSelectItem T="int" Value="@brand.Id">@brand.Name</MudSelectItem>
                            }
                        </MudSelect>

                        <div class="md:col-span-2">
                            <MudTextField @bind-Value="_model.Description"
                                          For="@(() => _model.Description)"
                                          Label="Mô tả"
                                          Placeholder="Nhập mô tả sản phẩm"
                                          Variant="Variant.Outlined"
                                          Lines="4"
                                          Immediate="true" />
                        </div>

                        <div class="md:col-span-2">
                            <MudAlert Severity="Severity.Info"
                                      Variant="Variant.Outlined"
                                      Class="!rounded-xl">
                                Sản phẩm mới sẽ tự động ở trạng thái <strong>Tạm ẩn</strong>
                            </MudAlert>
                        </div>
                    </div>

                    <div class="flex justify-end !border-t !border-slate-200 !pt-6">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Save"
                                   OnClick="SubmitAsync"
                                   Disabled="@_isSubmitting"
                                   Class="!rounded-xl !px-6 !py-2.5 !normal-case">
                            @(_isSubmitting ? "Đang lưu.." : "Lưu")
                        </MudButton>
                    </div>
                </div>
            </MudForm>
        </div>
    }
</div>

@code {
    private MudForm? _form;

    private readonly ProductModel _model = new();

    private readonly ProductSchema.CreateUpdate _validator = new();

    private List<CategoryResponse> _categories = new();

    private List<BrandResponse> _brands = new();

    private bool _isLoadingOptions = true;

    private bool _isSubmitting;

    protected override async Task OnInitializedAsync()
    {
        await LoadOptionsAsync();
    }

    private async Task LoadOptionsAsync()
    {
        _isLoadingOptions = true;

        try
        {
            var categoryResult = await _adminCategoryService.GetAllAsync();
            var brandResult = await _adminBrandService.GetAllAsync();

            if (!categoryResult.Success)
            {
                _snackbar.Add("Không thể tải danh sách thể loại", Severity.Error);
                return;
            }

            if (!brandResult.Success)
            {
                _snackbar.Add("Không thể tải danh sách thương hiệu", Severity.Error);
                return;
            }

            _categories = categoryResult.Data?.Where(c => c.IsActive).ToList() ?? new();
            _brands = brandResult.Data?.Where(b => b.IsActive).ToList() ?? new();

            if (_categories.Count > 0)
            {
                _model.CategoryId = _categories[0].Id;
            }

            if (_brands.Count > 0)
            {
                _model.BrandId = _brands[0].Id;
            }
        }
        finally
        {
            _isLoadingOptions = false;
        }
    }

    private async Task SubmitAsync()
    {
        if (_form is null || _isSubmitting)
        {
            return;
        }

        await _form.ValidateAsync();

        if (!_form.IsValid)
        {
            return;
        }

        _isSubmitting = true;

        try
        {
            _model.Status = 0;

            var result = await _adminProductService.CreateAsync(_model);

            if (!result.Success || result.Data is null)
            {
                _snackbar.Add(ConvertProductErrorMessage(result.Message), Severity.Error);
                return;
            }

            _snackbar.Add("Tạo sản phẩm thành công", Severity.Success);

            _navigation.NavigateTo(RouterConfig.BuildRoute(RouterConfig.Admin.ProductDetail, result.Data.Id));
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private static string ConvertProductErrorMessage(string message)
    {
        return message switch
        {
            "Db Error" => "Không thể tạo sản phẩm",
            "TokenExpired" => "Phiên đăng nhập đã hết hạn",
            "InvalidToken" => "Phiên đăng nhập không hợp lệ",
            _ => string.IsNullOrWhiteSpace(message)
                ? "Có lỗi xảy ra. Vui lòng thử lại"
                : message
        };
    }
}
