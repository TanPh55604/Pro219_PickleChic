@attribute [Route(RouterConfig.Admin.ProductDetail)]
@layout AdminLayout

<PageTitle>@Constant.metaDataAdmin Product Detail</PageTitle>

@if (_isLoading)
{
    <DetailPageSkeleton MaxWidthClass="max-w-7xl"
                        ShowSubtitle="true"
                        InfoFieldCount="5"
                        DescriptionBlockCount="1"
                        TableRowCount="3" />
}
else
{
    <div class="mx-auto w-full max-w-7xl !space-y-6">
        <div class="flex flex-col !gap-4 md:flex-row md:items-center md:justify-between">
            <div>
                <h1 class="text-2xl font-bold text-slate-900">Chi tiết sản phẩm</h1>
            </div>

            <div class="flex flex-wrap !gap-3">
                <a href="@RouterConfig.Admin.Products"
                   class="inline-flex items-center justify-center !gap-2 !rounded-xl !border !border-slate-200 !bg-white !px-5 !py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:!bg-slate-50">
                    <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" />
                    Quay lại
                </a>

                <a href="@RouterConfig.BuildRoute(RouterConfig.Admin.EditProduct, Id)"
                   class="inline-flex items-center justify-center !gap-2 !rounded-xl !bg-[#A05AFF] !px-5 !py-2.5 text-sm font-semibold !text-white shadow-sm transition hover:!bg-[#8B3FE6]">
                    <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" />
                    Cập nhật
                </a>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.Delete"
                           OnClick="OpenDeleteProductDialog"
                           Class="!rounded-xl !px-5 !py-2.5 !normal-case">
                    Xóa
                </MudButton>
            </div>
        </div>

        <div class="!rounded-2xl !border !border-slate-200 !bg-white shadow-sm">
            <div class="!border-b !border-slate-200 !p-6 md:!p-8">
                <div class="flex flex-col !gap-5 md:flex-row md:items-center md:justify-between">
                    <div>
                        <h2 class="text-2xl font-bold text-slate-900">
                            @_model.ProductName
                        </h2>

                        <p class="!mt-2 text-sm text-slate-500">
                            @(_model.CategoryName ?? "—") · @(_model.BrandName ?? "—")
                        </p>
                    </div>

                    @if (_model.IsActive)
                    {
                        <span class="inline-flex items-center !rounded-full !bg-green-50 !px-4 !py-2 text-sm font-bold !text-green-700">
                            Đang hoạt động
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex items-center !rounded-full !bg-slate-100 !px-4 !py-2 text-sm font-bold !text-slate-700">
                            Tạm ẩn
                        </span>
                    }
                </div>
            </div>

            <div class="!p-6 md:!p-8">
                <h3 class="text-lg font-bold text-slate-900">
                    Thông tin sản phẩm
                </h3>

                <div class="!mt-5 grid !gap-4 md:grid-cols-2 xl:grid-cols-3">
                    <div class="!rounded-xl !bg-slate-50 !p-4">
                        <p class="text-sm text-slate-500">Thể loại</p>
                        <p class="!mt-2 text-base font-semibold text-slate-900">
                            @(_model.CategoryName ?? "—")
                        </p>
                    </div>

                    <div class="!rounded-xl !bg-slate-50 !p-4">
                        <p class="text-sm text-slate-500">Thương hiệu</p>
                        <p class="!mt-2 text-base font-semibold text-slate-900">
                            @(_model.BrandName ?? "—")
                        </p>
                    </div>

                    <div class="!rounded-xl !bg-slate-50 !p-4">
                        <p class="text-sm text-slate-500">Trạng thái</p>
                        <p class="!mt-2 text-base font-semibold text-slate-900">
                            @(_model.IsActive ? "Đang hoạt động" : "Tạm ẩn")
                        </p>
                    </div>

                    <div class="!rounded-xl !bg-slate-50 !p-4">
                        <p class="text-sm text-slate-500">Ngày tạo</p>
                        <p class="!mt-2 text-base font-semibold text-slate-900">
                            @_model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                        </p>
                    </div>

                    <div class="!rounded-xl !bg-slate-50 !p-4">
                        <p class="text-sm text-slate-500">Ngày cập nhật</p>
                        <p class="!mt-2 text-base font-semibold text-slate-900">
                            @(_model.UpdatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa cập nhật")
                        </p>
                    </div>

                    <div class="!rounded-xl !bg-slate-50 !p-4">
                        <p class="text-sm text-slate-500">Người cập nhật</p>
                        <p class="!mt-2 text-base font-semibold text-slate-900">
                            @(string.IsNullOrWhiteSpace(_model.UpdatedBy) ? "—" : _model.UpdatedBy)
                        </p>
                    </div>
                </div>

                <div class="!mt-6 !rounded-2xl !border !border-slate-200 !p-5">
                    <p class="text-sm font-medium text-slate-500">Mô tả</p>
                    <p class="!mt-3 text-base leading-8 text-slate-800">
                        @(string.IsNullOrWhiteSpace(_model.Description) ? "Chưa có mô tả" : _model.Description)
                    </p>
                </div>
            </div>
        </div>

        <div class="!rounded-2xl !border !border-slate-200 !bg-white !p-5 shadow-sm md:!p-6">
            <div class="!mb-5 flex flex-col !gap-3 md:flex-row md:items-center md:justify-between">
                <div>
                    <h3 class="text-lg font-bold text-slate-900">Biến thể sản phẩm</h3>
                    <p class="!mt-1 text-sm text-slate-500">
                        @_variants.Count biến thể
                    </p>
                </div>

                <a href="@GetCreateVariantUrl()"
                   class="inline-flex items-center justify-center !gap-2 !rounded-xl !bg-[#A05AFF] !px-4 !py-2.5 text-sm font-semibold !text-white shadow-sm transition hover:!bg-[#8B3FE6]">
                    <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
                    Thêm biến thể
                </a>
            </div>

            @if (_variants.Count == 0)
            {
                <div class="!rounded-xl !border !border-dashed !border-slate-300 !p-10 text-center text-sm text-slate-500">
                    Chưa có biến thể nào
                </div>
            }
            else
            {
                <MudTable Items="_variants"
                          Hover="true"
                          Elevation="0"
                          Dense="true">
                    <HeaderContent>
                        <MudTh>STT</MudTh>
                        <MudTh>Ảnh</MudTh>
                        <MudTh>SKU</MudTh>
                        <MudTh>Tên biến thể</MudTh>
                        <MudTh>Thuộc tính</MudTh>
                        <MudTh>Giá</MudTh>
                        <MudTh>Tồn kho</MudTh>
                        <MudTh>Trạng thái</MudTh>
                        <MudTh Class="text-right">Thao tác</MudTh>
                    </HeaderContent>

                    <RowTemplate>
                        <MudTd DataLabel="STT">
                            @(_variants.IndexOf(context) + 1)
                        </MudTd>

                        <MudTd DataLabel="Ảnh">
                            @if (!string.IsNullOrWhiteSpace(context.MainImageUrl))
                            {
                                <img src="@context.MainImageUrl"
                                     alt="@context.SKU"
                                     class="!h-10 !w-10 !rounded-lg !border !border-slate-200 object-cover" />
                            }
                            else
                            {
                                <div class="flex !h-10 !w-10 items-center justify-center !rounded-lg !bg-slate-100 text-slate-400">
                                    <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Small" />
                                </div>
                            }
                        </MudTd>

                        <MudTd DataLabel="SKU">
                            <span class="font-bold text-slate-900">@context.SKU</span>
                        </MudTd>

                        <MudTd DataLabel="Tên biến thể">
                            <span class="text-sm text-slate-700">
                                @(string.IsNullOrWhiteSpace(context.VariantName) ? "—" : context.VariantName)
                            </span>
                        </MudTd>

                        <MudTd DataLabel="Thuộc tính">
                            <span class="text-sm text-slate-600">@context.AttributesDisplay</span>
                        </MudTd>

                        <MudTd DataLabel="Giá">
                            <span class="font-semibold text-slate-900">
                                @context.Price.ToString("N0") đ
                            </span>
                        </MudTd>

                        <MudTd DataLabel="Tồn kho">
                            <span class="text-sm text-slate-700">@context.StockQuantity</span>
                        </MudTd>

                        <MudTd DataLabel="Trạng thái">
                            @if (context.IsActive)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">
                                    Hoạt động
                                </MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">
                                    Tạm ẩn
                                </MudChip>
                            }
                        </MudTd>

                        <MudTd DataLabel="Thao tác" Class="text-right">
                            <div class="flex justify-end !gap-1">
                                <a href="@RouterConfig.BuildRoute(RouterConfig.Admin.EditProductVariant, context.Id)"
                                   title="Sửa"
                                   class="inline-flex !h-9 !w-9 items-center justify-center !rounded-lg text-[#4BCBEB] transition hover:!bg-[#4BCBEB]/15 hover:text-[#4BCBEB]">
                                    <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" />
                                </a>

                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               title="Xóa"
                                               OnClick="@(() => OpenDeleteVariantDialog(context))" />
                            </div>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private ProductDetailResponse _model = new();

    private List<ProductVariantSummaryResponse> _variants = new();

    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadProductAsync();
    }

    private async Task LoadProductAsync()
    {
        _isLoading = true;

        try
        {
            var result = await _adminProductService.GetByIdWithDetailsAsync(Id);

            if (!result.Success || result.Data is null)
            {
                _snackbar.Add(ConvertProductErrorMessage(result.Message), Severity.Error);
                _navigation.NavigateTo(RouterConfig.Admin.Products, replace: true);
                return;
            }

            _model = result.Data;
            _variants = result.Data.ProductVariants ?? new();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string GetCreateVariantUrl()
    {
        return $"{RouterConfig.Admin.CreateProductVariant}?productId={Id}";
    }

    private async Task OpenDeleteProductDialog()
    {
        var parameters = new DialogParameters<ProductDeleteDialog>
        {
            { x => x.Product, _model }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.ExtraSmall,
            FullWidth = true
        };

        var dialog = await _dialogService.ShowAsync<ProductDeleteDialog>("Xóa sản phẩm", parameters, options);
        var dialogResult = await dialog.Result;

        if (dialogResult is null || dialogResult.Canceled)
        {
            return;
        }

        var result = await _adminProductService.DeleteAsync(Id);

        if (!result.Success)
        {
            _snackbar.Add(ConvertProductErrorMessage(result.Message), Severity.Error);
            return;
        }

        _snackbar.Add("Xóa sản phẩm thành công", Severity.Success);

        _navigation.NavigateTo(RouterConfig.Admin.Products, replace: true);
    }

    private async Task OpenDeleteVariantDialog(ProductVariantSummaryResponse variant)
    {
        var parameters = new DialogParameters<ProductVariantDeleteDialog>
        {
            { x => x.ProductVariantItem, variant }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.ExtraSmall,
            FullWidth = true
        };

        var dialog = await _dialogService.ShowAsync<ProductVariantDeleteDialog>("Xóa biến thể", parameters, options);
        var dialogResult = await dialog.Result;

        if (dialogResult is null || dialogResult.Canceled)
        {
            return;
        }

        var result = await _adminProductVariantService.DeleteAsync(variant.Id);

        if (!result.Success)
        {
            _snackbar.Add(ConvertProductErrorMessage(result.Message), Severity.Error);
            return;
        }

        _snackbar.Add("Xóa biến thể thành công", Severity.Success);

        await LoadProductAsync();
    }

    private static string ConvertProductErrorMessage(string message)
    {
        return message switch
        {
            "Không tìm thấy" => "Không tìm thấy sản phẩm",
            "Db Error" => "Không thể xử lý dữ liệu sản phẩm",
            "TokenExpired" => "Phiên đăng nhập đã hết hạn",
            "InvalidToken" => "Phiên đăng nhập không hợp lệ",
            _ => string.IsNullOrWhiteSpace(message)
                ? "Có lỗi xảy ra. Vui lòng thử lại"
                : message
        };
    }
}
