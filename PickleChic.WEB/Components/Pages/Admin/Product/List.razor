@attribute [Route(RouterConfig.Admin.Products)]
@layout AdminLayout

<PageTitle>@Constant.metaDataAdmin Products</PageTitle>

<div class="!space-y-5">
    <div class="flex flex-col !gap-3 md:flex-row md:items-center md:justify-between">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">Sản phẩm</h1>
        </div>

        <a href="@RouterConfig.Admin.CreateProduct"
           class="inline-flex items-center justify-center !gap-2 !rounded-xl !bg-slate-900 !px-4 !py-2.5 text-sm font-semibold !text-white shadow-sm transition hover:!bg-slate-800">
            <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
            Thêm sản phẩm
        </a>
    </div>

    <div class="!rounded-2xl !border !border-slate-200 !bg-white !p-5 shadow-sm">
        <div class="!mb-4 flex flex-col !gap-3 md:flex-row md:items-center md:justify-between">
            <div class="flex w-full flex-col !gap-2 md:max-w-xl md:flex-row">
                <MudTextField @bind-Value="_searchText"
                              Placeholder="Tìm kiếm theo tên sản phẩm.."
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              OnKeyDown="HandleSearchKeyDown"
                              Class="flex-1" />

                <MudButton Variant="Variant.Filled"
                           Color="Color.Dark"
                           StartIcon="@Icons.Material.Filled.Search"
                           OnClick="SearchAsync"
                           Disabled="@_isLoading"
                           Class="!rounded-xl !px-5 !normal-case">
                    Tìm kiếm
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="ResetSearchAsync"
                           Disabled="@_isLoading"
                           Class="!rounded-xl !px-5 !normal-case">
                    Làm mới
                </MudButton>
            </div>
        </div>

        <MudTable Items="_products"
                  Loading="@_isLoading"
                  Hover="true"
                  Elevation="0"
                  FixedHeader="true"
                  Height="calc(100vh - 340px)"
                  RowsPerPage="10">
            <HeaderContent>
                <MudTh>STT</MudTh>
                <MudTh>Tên sản phẩm</MudTh>
                <MudTh>Thể loại</MudTh>
                <MudTh>Thương hiệu</MudTh>
                <MudTh>Biến thể</MudTh>
                <MudTh>Trạng thái</MudTh>
                <MudTh Class="text-right">Chi tiết</MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd DataLabel="STT">
                    <span class="font-medium text-slate-700">
                        @(_products.IndexOf(context) + 1)
                    </span>
                </MudTd>

                <MudTd DataLabel="Tên sản phẩm">
                    <a href="@RouterConfig.BuildRoute(RouterConfig.Admin.ProductDetail, context.Id)"
                       class="font-semibold text-slate-900 transition hover:text-slate-600">
                        @context.ProductName
                    </a>
                </MudTd>

                <MudTd DataLabel="Thể loại">
                    <span class="text-sm text-slate-600">@(context.CategoryName ?? "—")</span>
                </MudTd>

                <MudTd DataLabel="Thương hiệu">
                    <span class="text-sm text-slate-600">@(context.BrandName ?? "—")</span>
                </MudTd>

                <MudTd DataLabel="Biến thể">
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">
                        @context.ProductVariants.Count biến thể
                    </MudChip>
                </MudTd>

                <MudTd DataLabel="Trạng thái">
                    @if (context.IsActive)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">
                            Đang hoạt động
                        </MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">
                            Tạm ẩn
                        </MudChip>
                    }
                </MudTd>

                <MudTd DataLabel="Chi tiết" Class="text-right">
                    <a href="@RouterConfig.BuildRoute(RouterConfig.Admin.ProductDetail, context.Id)"
                       class="inline-flex !h-9 !w-9 items-center justify-center !rounded-lg text-slate-500 transition hover:!bg-slate-100 hover:text-slate-900">
                        <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
                    </a>
                </MudTd>
            </RowTemplate>

            <NoRecordsContent>
                <div class="!py-10 text-center text-slate-500">
                    Không có sản phẩm nào
                </div>
            </NoRecordsContent>

            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 5, 10, 20 }" />
            </PagerContent>
        </MudTable>
    </div>
</div>

@code {
    private string _searchText = string.Empty;

    private bool _isLoading = true;

    private List<ProductDetailResponse> _products = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadProductsAsync();
    }

    private async Task LoadProductsAsync()
    {
        _isLoading = true;

        try
        {
            var result = await _adminProductService.GetAllWithDetailsAsync(_searchText);

            if (!result.Success)
            {
                _snackbar.Add(ConvertProductErrorMessage(result.Message), Severity.Error);
                return;
            }

            _products = result.Data ?? new();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SearchAsync()
    {
        await LoadProductsAsync();
    }

    private async Task ResetSearchAsync()
    {
        _searchText = string.Empty;
        await LoadProductsAsync();
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await SearchAsync();
        }
    }

    private static string ConvertProductErrorMessage(string message)
    {
        return message switch
        {
            "Db Error" => "Không thể tải danh sách sản phẩm",
            "TokenExpired" => "Phiên đăng nhập đã hết hạn",
            "InvalidToken" => "Phiên đăng nhập không hợp lệ",
            _ => string.IsNullOrWhiteSpace(message)
                ? "Có lỗi xảy ra. Vui lòng thử lại"
                : message
        };
    }
}
