@attribute [Route(RouterConfig.Admin.EditCategory)]
@layout AdminLayout

<PageTitle>@Constant.metaDataAdmin Edit Category</PageTitle>

@if (_isLoading)
{
    <EditPageSkeleton FieldCount="4" />
}
else
{
    <div class="mx-auto w-full max-w-5xl !space-y-6">
        <div class="flex flex-col !gap-4 md:flex-row md:items-center md:justify-between">
            <div>
                <h1 class="text-2xl font-bold text-slate-900">Cập nhật thể loại</h1>
            </div>

            <a href="@RouterConfig.BuildRoute(RouterConfig.Admin.CategoryDetail, Id)"
               class="inline-flex items-center justify-center !gap-2 !rounded-xl !border !border-slate-200 !bg-white !px-5 !py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:!bg-slate-50">
                <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" />
                Quay lại
            </a>
        </div>

        <div class="!rounded-2xl !border !border-slate-200 !bg-white !p-6 shadow-sm md:!p-8">
            <MudForm @ref="_form"
                     Model="@_model"
                     Validation="@_validator.ValidateValue">
                <div class="!space-y-6">
                    <div>
                        <h2 class="text-lg font-bold text-slate-900">Thông tin thể loại</h2>
                    </div>

                    <div class="grid !gap-5 md:grid-cols-2">
                        <MudTextField @bind-Value="_model.Name"
                                      For="@(() => _model.Name)"
                                      Label="Tên thể loại"
                                      Placeholder="Nhập tên thể loại"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      Immediate="true" />

                        <MudSelect T="int"
                                   @bind-Value="_model.Status"
                                   For="@(() => _model.Status)"
                                   Label="Trạng thái"
                                   Variant="Variant.Outlined">
                            <MudSelectItem T="int" Value="1">Đang hoạt động</MudSelectItem>
                            <MudSelectItem T="int" Value="0">Tạm ẩn</MudSelectItem>
                        </MudSelect>

                        <div class="md:col-span-2">
                            <CategoryImagePicker CategoryId="Id"
                                                 LinkImage="_model.LinkImage"
                                                 LinkImageChanged="OnLinkImageChanged" />
                        </div>

                        <div class="md:col-span-2">
                            <MudTextField @bind-Value="_model.Description"
                                          For="@(() => _model.Description)"
                                          Label="Mô tả"
                                          Placeholder="Nhập mô tả"
                                          Variant="Variant.Outlined"
                                          Lines="4"
                                          Immediate="true" />
                        </div>
                    </div>

                    <div class="flex justify-end !border-t !border-slate-200 !pt-6">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Save"
                                   OnClick="SubmitAsync"
                                   Disabled="@_isSubmitting"
                                   Class="!rounded-xl !px-6 !py-2.5 !normal-case">
                            @(_isSubmitting ? "Đang cập nhật.." : "Cập nhật")
                        </MudButton>
                    </div>
                </div>
            </MudForm>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private MudForm? _form;

    private CategoryModel _model = new();

    private readonly CategorySchema.CreateUpdate _validator = new();

    private bool _isLoading = true;

    private bool _isSubmitting;

    protected override async Task OnInitializedAsync()
    {
        await LoadCategoryAsync();
    }

    private async Task LoadCategoryAsync()
    {
        _isLoading = true;

        try
        {
            var result = await _adminCategoryService.GetByIdAsync(Id);

            if (!result.Success || result.Data is null)
            {
                _snackbar.Add(ConvertCategoryErrorMessage(result.Message), Severity.Error);
                _navigation.NavigateTo(RouterConfig.Admin.Categories, replace: true);
                return;
            }

            _model = MapToModel(result.Data);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static CategoryModel MapToModel(CategoryResponse response)
    {
        return new CategoryModel
        {
            Id = response.Id,
            Name = response.Name,
            LinkImage = response.LinkImage,
            Description = response.Description,
            Status = response.Status
        };
    }

    private Task OnLinkImageChanged(string? linkImage)
    {
        _model.LinkImage = linkImage;
        return Task.CompletedTask;
    }

    private async Task SubmitAsync()
    {
        if (_form is null || _isSubmitting)
        {
            return;
        }

        await _form.ValidateAsync();

        if (!_form.IsValid)
        {
            return;
        }

        _isSubmitting = true;

        try
        {
            var result = await _adminCategoryService.UpdateAsync(_model);

            if (!result.Success)
            {
                _snackbar.Add(ConvertCategoryErrorMessage(result.Message), Severity.Error);
                return;
            }

            _snackbar.Add("Cập nhật thể loại thành công", Severity.Success);

            _navigation.NavigateTo(RouterConfig.BuildRoute(RouterConfig.Admin.CategoryDetail, Id));
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private static string ConvertCategoryErrorMessage(string message)
    {
        return message switch
        {
            "Không tìm thấy" => "Không tìm thấy thể loại",
            "Db Error" => "Không thể xử lý dữ liệu thể loại",
            "TokenExpired" => "Phiên đăng nhập đã hết hạn",
            "InvalidToken" => "Phiên đăng nhập không hợp lệ",
            _ => string.IsNullOrWhiteSpace(message)
                ? "Có lỗi xảy ra. Vui lòng thử lại"
                : message
        };
    }
}