@attribute [Route(RouterConfig.Admin.CreateCategory)]
@layout AdminLayout

<PageTitle>@Constant.metaDataAdmin Create Category</PageTitle>

<div class="mx-auto w-full max-w-5xl !space-y-6">
    <div class="flex flex-col !gap-4 md:flex-row md:items-center md:justify-between">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">Tạo thể loại</h1>
        </div>

        <a href="@RouterConfig.Admin.Categories"
           class="inline-flex items-center justify-center !gap-2 !rounded-xl !border !border-slate-200 !bg-white !px-5 !py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:!bg-slate-50">
            <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" />
            Quay lại
        </a>
    </div>

    <div class="!rounded-2xl !border !border-slate-200 !bg-white !p-6 shadow-sm md:!p-8">
        <MudForm @ref="_form"
                 Model="@_model"
                 Validation="@_validator.ValidateValue">
            <div class="!space-y-6">
                <div>
                    <h2 class="text-lg font-bold text-slate-900">Thông tin thể loại</h2>
                </div>

                <div class="grid !gap-5 md:grid-cols-2">
                    <MudTextField @bind-Value="_model.Name"
                                  For="@(() => _model.Name)"
                                  Label="Tên thể loại"
                                  Placeholder="Nhập tên thể loại"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  Immediate="true" />

                    <MudSelect T="int"
                               @bind-Value="_model.Status"
                               For="@(() => _model.Status)"
                               Label="Trạng thái"
                               Variant="Variant.Outlined">
                        <MudSelectItem T="int" Value="1">Đang hoạt động</MudSelectItem>
                        <MudSelectItem T="int" Value="0">Tạm ẩn</MudSelectItem>
                    </MudSelect>

                    <div class="md:col-span-2">
                        <MudTextField @bind-Value="_model.Description"
                                      For="@(() => _model.Description)"
                                      Label="Mô tả"
                                      Placeholder="Nhập mô tả"
                                      Variant="Variant.Outlined"
                                      Lines="4"
                                      Immediate="true" />
                    </div>
                </div>

                <div class="flex justify-end !border-t !border-slate-200 !pt-6">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Save"
                               OnClick="SubmitAsync"
                               Disabled="@_isSubmitting"
                               Class="!rounded-xl !px-6 !py-2.5 !normal-case">
                        @(_isSubmitting ? "Đang lưu.." : "Lưu")
                    </MudButton>
                </div>
            </div>
        </MudForm>
    </div>
</div>

@code {
    private MudForm? _form;

    private readonly CategoryModel _model = new()
    {
        Status = 1
    };

    private readonly CategorySchema.CreateUpdate _validator = new();

    private bool _isSubmitting;

    private async Task SubmitAsync()
    {
        if (_form is null || _isSubmitting)
        {
            return;
        }

        await _form.ValidateAsync();

        if (!_form.IsValid)
        {
            return;
        }

        _isSubmitting = true;

        try
        {
            var result = await _adminCategoryService.CreateAsync(_model);

            if (!result.Success || result.Data is null)
            {
                _snackbar.Add(ConvertCategoryErrorMessage(result.Message), Severity.Error);
                return;
            }

            _snackbar.Add("Tạo thể loại thành công", Severity.Success);

            _navigation.NavigateTo(RouterConfig.BuildRoute(RouterConfig.Admin.CategoryDetail, result.Data.Id));
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private static string ConvertCategoryErrorMessage(string message)
    {
        return message switch
        {
            "Db Error" => "Không thể tạo thể loại",
            "TokenExpired" => "Phiên đăng nhập đã hết hạn",
            "InvalidToken" => "Phiên đăng nhập không hợp lệ",
            _ => string.IsNullOrWhiteSpace(message)
                ? "Có lỗi xảy ra. Vui lòng thử lại"
                : message
        };
    }
}