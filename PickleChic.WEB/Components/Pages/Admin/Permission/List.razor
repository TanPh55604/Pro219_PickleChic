@attribute [Route(RouterConfig.Admin.Permissions)]
@layout AdminLayout

<PageTitle>@Constant.metaDataAdmin Permissions</PageTitle>

<div class="!space-y-5">
    <div class="flex flex-col !gap-3 md:flex-row md:items-center md:justify-between">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">Phân quyền</h1>
            <p class="!mt-1 text-sm text-slate-500">Quản lý vai trò và quyền truy cập theo chức năng</p>
        </div>

        <AuthorizeControl Action="@Constant.ActionButton.Create">
            <a href="@RouterConfig.Admin.CreatePermission"
               class="inline-flex items-center justify-center !gap-2 !rounded-xl !bg-[#A05AFF] !px-4 !py-2.5 text-sm font-semibold !text-white shadow-sm transition hover:!bg-[#8B3FE6]">
                <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
                Thêm vai trò
            </a>
        </AuthorizeControl>
    </div>

    <div class="!rounded-2xl !border !border-slate-200 !bg-white !p-5 shadow-sm">
        <MudTable Items="_roles"
                  Loading="@_isLoading"
                  Hover="true"
                  Elevation="0"
                  FixedHeader="true"
                  Height="calc(100vh - 300px)"
                  RowsPerPage="10">
            <HeaderContent>
                <MudTh>STT</MudTh>
                <MudTh>Tên vai trò</MudTh>
                <MudTh>Trạng thái</MudTh>
                <MudTh Class="text-right">Chi tiết</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="STT">@(_roles.IndexOf(context) + 1)</MudTd>
                <MudTd DataLabel="Tên vai trò">
                    <a href="@RouterConfig.BuildRoute(RouterConfig.Admin.PermissionDetail, context.Id)"
                       class="font-semibold text-slate-900 transition hover:text-slate-600">
                        @context.RoleName
                    </a>
                </MudTd>
                <MudTd DataLabel="Trạng thái">
                    <MudChip T="string" Size="Size.Small" Color="@(context.Status == 1 ? Color.Success : Color.Default)" Variant="Variant.Filled">
                        @(context.Status == 1 ? "Hoạt động" : "Khóa")
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Chi tiết" Class="text-right">
                    <div class="inline-flex items-center !gap-1">
                        @if (context.IsEdit)
                        {
                            <AuthorizeControl Action="@Constant.ActionButton.Edit">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Color="Color.Warning"
                                               Size="Size.Small"
                                               OnClick="@(() => _navigation.NavigateTo(RouterConfig.BuildRoute(RouterConfig.Admin.EditPermission, context.Id)))" />
                            </AuthorizeControl>
                            <AuthorizeControl Action="@Constant.ActionButton.Delete">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               OnClick="@(() => DeleteAsync(context))" />
                            </AuthorizeControl>
                        }
                        <a href="@RouterConfig.BuildRoute(RouterConfig.Admin.PermissionDetail, context.Id)"
                           class="inline-flex !h-9 !w-9 items-center justify-center !rounded-lg text-[#4BCBEB] transition hover:!bg-[#4BCBEB]/15">
                            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
                        </a>
                    </div>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <div class="!py-10 text-center text-slate-500">Không có vai trò nào.</div>
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 5, 10, 20 }" />
            </PagerContent>
        </MudTable>
    </div>
</div>

@code {
    private bool _isLoading = true;
    private List<RoleResponse> _roles = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        try
        {
            var result = await _adminRoleService.GetAllAsync();
            if (!result.Success)
            {
                _snackbar.Add(string.IsNullOrWhiteSpace(result.Message) ? "Không thể tải danh sách vai trò" : result.Message, Severity.Error);
                _roles = new();
                return;
            }

            _roles = result.Data ?? new();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task DeleteAsync(RoleResponse role)
    {
        var confirmed = await _JSRuntime.InvokeAsync<bool>(
            "confirm",
            $"Bạn có chắc muốn xóa vai trò \"{role.RoleName}\"?");

        if (!confirmed)
        {
            return;
        }

        var result = await _adminRoleService.DeleteAsync(role.Id);
        if (!result.Success)
        {
            _snackbar.Add(string.IsNullOrWhiteSpace(result.Message) ? "Xóa thất bại" : result.Message, Severity.Error);
            return;
        }

        _snackbar.Add("Đã xóa vai trò", Severity.Success);
        await LoadAsync();
    }
}
