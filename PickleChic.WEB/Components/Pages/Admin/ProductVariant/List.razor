@attribute [Route(RouterConfig.Admin.ProductVariants)]
@layout AdminLayout

<PageTitle>@Constant.metaDataAdmin Product Variants</PageTitle>

<div class="!space-y-5">
    <div class="flex flex-col !gap-3 md:flex-row md:items-center md:justify-between">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">Biến thể sản phẩm</h1>
        </div>

        <AuthorizeControl Action="@Constant.ActionButton.Create">
            <a href="@RouterConfig.Admin.CreateProductVariant"
               class="inline-flex items-center justify-center !gap-2 !rounded-xl !bg-[#A05AFF] !px-4 !py-2.5 text-sm font-semibold !text-white shadow-sm transition hover:!bg-[#8B3FE6]">
                <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
                Thêm biến thể sản phẩm
            </a>
        </AuthorizeControl>
    </div>
</div>

@code {}
