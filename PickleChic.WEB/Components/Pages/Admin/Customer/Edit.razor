@attribute [Route(RouterConfig.Admin.EditCustomer)]
@layout AdminLayout

<PageTitle>@Constant.metaDataAdmin Edit Customer</PageTitle>

<div class="mx-auto w-full max-w-5xl !space-y-6">
    <div class="flex flex-col !gap-4 md:flex-row md:items-center md:justify-between">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">Cập nhật khách hàng</h1>
        </div>

        <a href="@RouterConfig.BuildRoute(RouterConfig.Admin.CustomerDetail, Id)"
           class="inline-flex items-center justify-center !gap-2 !rounded-xl !border !border-slate-200 !bg-white !px-5 !py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:!bg-slate-50">
            <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" />
            Quay lại
        </a>
    </div>

    <div class="!rounded-2xl !border !border-slate-200 !bg-white !p-6 shadow-sm md:!p-8">
        <MudForm @ref="_form"
                 Model="@_model"
                 Validation="@_validator.ValidateValue">
            <div class="!space-y-6">
                <div>
                    <h2 class="text-lg font-bold text-slate-900">Thông tin khách hàng</h2>
                </div>

                <div class="grid !gap-5 md:grid-cols-2">
                    <MudTextField @bind-Value="_model.Username"
                                  For="@(() => _model.Username)"
                                  Label="Tên đăng nhập"
                                  Placeholder="Nhập tên đăng nhập"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  Immediate="true" />

                    <MudTextField @bind-Value="_model.FullName"
                                  For="@(() => _model.FullName)"
                                  Label="Họ tên"
                                  Placeholder="Nhập họ tên"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  Immediate="true" />

                    <MudTextField @bind-Value="_model.Email"
                                  For="@(() => _model.Email)"
                                  Label="Email"
                                  Placeholder="Nhập email"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Email"
                                  Required="true"
                                  Immediate="true" />

                    <MudTextField @bind-Value="_model.PhoneNumber"
                                  For="@(() => _model.PhoneNumber)"
                                  Label="Số điện thoại"
                                  Placeholder="Nhập số điện thoại"
                                  Variant="Variant.Outlined"
                                  Immediate="true" />

                    <MudDatePicker Date="@_model.DateOfBirth"
                                   DateChanged="OnDateOfBirthChanged"
                                   Label="Ngày sinh"
                                   Placeholder="Chọn ngày sinh"
                                   Variant="Variant.Outlined"
                                   Required="true" />

                    <MudSelect T="bool?"
                               @bind-Value="_model.Gender"
                               For="@(() => _model.Gender)"
                               Label="Giới tính"
                               Placeholder="Chọn giới tính"
                               Variant="Variant.Outlined"
                               Required="true">
                        <MudSelectItem T="bool?" Value="@((bool?)true)">Nam</MudSelectItem>
                        <MudSelectItem T="bool?" Value="@((bool?)false)">Nữ</MudSelectItem>
                    </MudSelect>

                    <MudNumericField T="int"
                                     @bind-Value="_model.TotalPoints"
                                     For="@(() => _model.TotalPoints)"
                                     Label="Điểm tích lũy"
                                     Placeholder="Nhập điểm tích lũy"
                                     Variant="Variant.Outlined"
                                     Min="0"
                                     Immediate="true" />

                    <MudSelect T="int"
                               @bind-Value="_model.RankId"
                               For="@(() => _model.RankId)"
                               Label="Hạng khách hàng"
                               Variant="Variant.Outlined">
                        <MudSelectItem T="int" Value="1">Đồng</MudSelectItem>
                        <MudSelectItem T="int" Value="2">Bạc</MudSelectItem>
                        <MudSelectItem T="int" Value="3">Vàng</MudSelectItem>
                        <MudSelectItem T="int" Value="4">Kim cương</MudSelectItem>
                    </MudSelect>

                    <div class="!rounded-xl !border !border-slate-200 !bg-slate-50 !p-4">
                        <MudSwitch @bind-Value="_model.Status"
                                   Color="Color.Success"
                                   Label="Đang hoạt động" />
                    </div>
                </div>

                <div class="flex justify-end !border-t !border-slate-200 !pt-6">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Save"
                               OnClick="SubmitAsync"
                               Class="!rounded-xl !px-6 !py-2.5 !normal-case">
                        Cập nhật
                    </MudButton>
                </div>
            </div>
        </MudForm>
    </div>
</div>

@code {
    [Parameter] public int Id { get; set; }

    private MudForm? _form;

    private CustomerModel _model = new();

    private readonly CustomerSchema.CreateUpdate _validator = new();

    protected override void OnInitialized()
    {
        _model = new CustomerModel
        {
            Id = Id,
            Username = "nguyenvana",
            FullName = "Nguyễn Văn A",
            Email = "nguyenvana@gmail.com",
            PasswordHash = "Customer12345@",
            PhoneNumber = "0900000001",
            Gender = true,
            DateOfBirth = new DateTime(1998, 5, 18),
            TotalPoints = 1200,
            Status = true,
            RankId = 1,
            RankName = "Đồng",
            LastLogin = null
        };
    }

    private void OnDateOfBirthChanged(DateTime? value)
    {
        if (value.HasValue)
        {
            _model.DateOfBirth = value.Value;
        }
    }

    private async Task SubmitAsync()
    {
        if (_form is null)
        {
            return;
        }

        await _form.ValidateAsync();

        if (!_form.IsValid)
        {
            return;
        }

        // TODO: Gọi API cập nhật customer.

        _navigation.NavigateTo(RouterConfig.BuildRoute(RouterConfig.Admin.CustomerDetail, Id));
    }
}