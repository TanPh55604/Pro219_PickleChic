@attribute [Route(RouterConfig.Admin.CreateRank)]
@layout AdminLayout

<PageTitle>@Constant.metaDataAdmin Create Rank</PageTitle>

<div class="mx-auto w-full max-w-5xl !space-y-6">
    <div class="flex flex-col !gap-4 md:flex-row md:items-center md:justify-between">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">Tạo xếp hạng</h1>
        </div>

        <a href="@RouterConfig.Admin.Ranks"
           class="inline-flex items-center justify-center !gap-2 !rounded-xl !border !border-slate-200 !bg-white !px-5 !py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:!bg-slate-50">
            <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" />
            Quay lại
        </a>
    </div>

    <div class="!rounded-2xl !border !border-slate-200 !bg-white !p-6 shadow-sm md:!p-8">
        <MudForm @ref="_form">
            <div class="!space-y-6">
                <h2 class="text-lg font-bold text-slate-900">Thông tin xếp hạng</h2>

                <div class="grid !gap-5 md:grid-cols-2">
                    <MudTextField @bind-Value="_model.RankName"
                                  Label="Tên xếp hạng"
                                  Placeholder="Ví dụ: Vàng"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="Vui lòng nhập tên xếp hạng"
                                  Immediate="true" />

                    <MudNumericField T="decimal"
                                     @bind-Value="_model.SpendAmount"
                                     Label="Chi tiêu tối thiểu (đ)"
                                     Placeholder="Nhập mức chi tiêu tối thiểu"
                                     Variant="Variant.Outlined"
                                     Min="0"
                                     Required="true"
                                     Immediate="true" />
                </div>

                <div class="flex justify-end !border-t !border-slate-200 !pt-6">
                    <AuthorizeControl Action="@Constant.ActionButton.Create">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Save"
                                   OnClick="SubmitAsync"
                                   Disabled="@_isSubmitting"
                                   Class="!rounded-xl !px-6 !py-2.5 !normal-case">
                            @(_isSubmitting ? "Đang lưu..." : "Lưu")
                        </MudButton>
                    </AuthorizeControl>
                </div>
            </div>
        </MudForm>
    </div>
</div>

@code {
    private MudForm? _form;
    private readonly RankCreateRequest _model = new();
    private bool _isSubmitting;

    private async Task SubmitAsync()
    {
        if (_form is null || _isSubmitting)
        {
            return;
        }

        await _form.ValidateAsync();

        if (!_form.IsValid || string.IsNullOrWhiteSpace(_model.RankName) || _model.SpendAmount < 0)
        {
            return;
        }

        _isSubmitting = true;

        try
        {
            var result = await _adminRankService.CreateAsync(_model);

            if (!result.Success || result.Data is null)
            {
                _snackbar.Add(ConvertError(result.Message), Severity.Error);
                return;
            }

            _snackbar.Add("Tạo xếp hạng thành công", Severity.Success);
            _navigation.NavigateTo(RouterConfig.BuildRoute(RouterConfig.Admin.RankDetail, result.Data.Id));
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private static string ConvertError(string message) =>
        message == "Db Error" ? "Không thể tạo xếp hạng" :
        string.IsNullOrWhiteSpace(message) ? "Có lỗi xảy ra. Vui lòng thử lại" : message;
}
