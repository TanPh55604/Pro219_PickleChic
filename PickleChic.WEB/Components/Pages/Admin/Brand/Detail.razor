@attribute [Route(RouterConfig.Admin.BrandDetail)]
@layout AdminLayout

<PageTitle>@Constant.metaDataAdmin Brand Detail</PageTitle>

@if (_isLoading)
{
    <DetailPageSkeleton ShowSubtitle="true"
                        InfoFieldCount="5"
                        DescriptionBlockCount="1" />
}
else
{
    <div class="mx-auto w-full max-w-6xl !space-y-6">
        <div class="flex flex-col !gap-4 md:flex-row md:items-center md:justify-between">
            <div>
                <h1 class="text-2xl font-bold text-slate-900">Chi tiết thương hiệu</h1>
            </div>

            <div class="flex flex-wrap !gap-3">
                <a href="@RouterConfig.Admin.Brands"
                   class="inline-flex items-center justify-center !gap-2 !rounded-xl !border !border-slate-200 !bg-white !px-5 !py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:!bg-slate-50">
                    <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" />
                    Quay lại
                </a>

                <a href="@RouterConfig.BuildRoute(RouterConfig.Admin.EditBrand, Id)"
                   class="inline-flex items-center justify-center !gap-2 !rounded-xl !bg-[#A05AFF] !px-5 !py-2.5 text-sm font-semibold !text-white shadow-sm transition hover:!bg-[#8B3FE6]">
                    <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" />
                    Cập nhật
                </a>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.Delete"
                           OnClick="OpenDeleteDialog"
                           Class="!rounded-xl !px-5 !py-2.5 !normal-case">
                    Xóa
                </MudButton>
            </div>
        </div>

        <div class="!rounded-2xl !border !border-slate-200 !bg-white shadow-sm">
            <div class="!border-b !border-slate-200 !p-6 md:!p-8">
                <div class="flex flex-col !gap-5 md:flex-row md:items-center md:justify-between">
                    <div>
                        <h2 class="text-2xl font-bold text-slate-900">
                            @_model.Name
                        </h2>

                        <p class="!mt-2 max-w-3xl text-sm leading-6 text-slate-500">
                            @(string.IsNullOrWhiteSpace(_model.Description) ? "Chưa có mô tả" : _model.Description)
                        </p>
                    </div>

                    @if (_model.IsActive)
                    {
                        <span class="inline-flex items-center !rounded-full !bg-green-50 !px-4 !py-2 text-sm font-bold !text-green-700">
                            Đang hoạt động
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex items-center !rounded-full !bg-slate-100 !px-4 !py-2 text-sm font-bold !text-slate-700">
                            Tạm ẩn
                        </span>
                    }
                </div>
            </div>

            <div class="!p-6 md:!p-8">
                <h3 class="text-lg font-bold text-slate-900">
                    Thông tin thương hiệu
                </h3>

                <div class="!mt-5 grid !gap-4 md:grid-cols-2 xl:grid-cols-3">
                    <div class="!rounded-xl !bg-slate-50 !p-4">
                        <p class="text-sm text-slate-500">Tên thương hiệu</p>
                        <p class="!mt-2 text-base font-semibold text-slate-900">
                            @_model.Name
                        </p>
                    </div>

                    <div class="!rounded-xl !bg-slate-50 !p-4">
                        <p class="text-sm text-slate-500">Trạng thái</p>
                        <p class="!mt-2 text-base font-semibold text-slate-900">
                            @(_model.IsActive ? "Đang hoạt động" : "Tạm ẩn")
                        </p>
                    </div>

                    <div class="!rounded-xl !bg-slate-50 !p-4">
                        <p class="text-sm text-slate-500">Người cập nhật</p>
                        <p class="!mt-2 text-base font-semibold text-slate-900">
                            @(string.IsNullOrWhiteSpace(_model.UpdateBy) ? "Chưa có" : _model.UpdateBy)
                        </p>
                    </div>

                    <div class="!rounded-xl !bg-slate-50 !p-4">
                        <p class="text-sm text-slate-500">Ngày tạo</p>
                        <p class="!mt-2 text-base font-semibold text-slate-900">
                            @(_model.InsertedAt?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa có")
                        </p>
                    </div>

                    <div class="!rounded-xl !bg-slate-50 !p-4">
                        <p class="text-sm text-slate-500">Ngày cập nhật</p>
                        <p class="!mt-2 text-base font-semibold text-slate-900">
                            @(_model.UpdatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa cập nhật")
                        </p>
                    </div>
                </div>

                <div class="!mt-6 !rounded-2xl !border !border-slate-200 !p-5">
                    <p class="text-sm font-medium text-slate-500">Mô tả</p>
                    <p class="!mt-3 text-base leading-8 text-slate-800">
                        @(string.IsNullOrWhiteSpace(_model.Description) ? "Chưa có mô tả" : _model.Description)
                    </p>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private BrandResponse _model = new();

    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadBrandAsync();
    }

    private async Task LoadBrandAsync()
    {
        _isLoading = true;

        try
        {
            var result = await _adminBrandService.GetByIdAsync(Id);

            if (!result.Success || result.Data is null)
            {
                _snackbar.Add(ConvertBrandErrorMessage(result.Message), Severity.Error);
                _navigation.NavigateTo(RouterConfig.Admin.Brands, replace: true);
                return;
            }

            _model = result.Data;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OpenDeleteDialog()
    {
        var parameters = new DialogParameters<BrandDeleteDialog>
    {
        { x => x.Brand, _model }
    };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.ExtraSmall,
            FullWidth = true
        };

        var dialog = await _dialogService.ShowAsync<BrandDeleteDialog>(
            "Xóa thương hiệu",
            parameters,
            options);

        var dialogResult = await dialog.Result;

        if (dialogResult.Canceled)
        {
            return;
        }

        var result = await _adminBrandService.DeleteAsync(Id);

        if (!result.Success)
        {
            _snackbar.Add(ConvertBrandErrorMessage(result.Message), Severity.Error);
            return;
        }

        _snackbar.Add("Xóa thương hiệu thành công", Severity.Success);

        _navigation.NavigateTo(RouterConfig.Admin.Brands, replace: true);
    }

    private static string ConvertBrandErrorMessage(string message)
    {
        return message switch
        {
            "Không tìm thấy" => "Không tìm thấy thương hiệu",
            "Db Error" => "Không thể xử lý dữ liệu thương hiệu",
            "TokenExpired" => "Phiên đăng nhập đã hết hạn",
            "InvalidToken" => "Phiên đăng nhập không hợp lệ",
            _ => string.IsNullOrWhiteSpace(message)
                ? "Có lỗi xảy ra. Vui lòng thử lại"
                : message
        };
    }
}