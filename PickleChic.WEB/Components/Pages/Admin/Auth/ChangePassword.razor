@attribute [Route(RouterConfig.Admin.AdminChangePassword)]
@layout AdminLayout

<PageTitle>@Constant.metaDataAdmin Change Password</PageTitle>

<div class="mx-auto w-full max-w-xl !space-y-6">
    <div>
        <h1 class="text-2xl font-bold text-slate-900">Đổi mật khẩu</h1>
    </div>

    <div class="!rounded-2xl !border !border-slate-200 !bg-white !p-6 shadow-sm md:!p-8">
        <div>
            <h2 class="text-lg font-bold text-slate-900">
                Cập nhật mật khẩu quản trị
            </h2>

            <p class="!mt-2 text-sm leading-6 text-slate-500">
                Bạn đang sử dụng mật khẩu tạm thời hoặc cần thay đổi mật khẩu để tiếp tục sử dụng hệ thống quản trị.
            </p>
        </div>

        <MudForm @ref="_form"
                 Model="@_model"
                 Validation="@_validator.ValidateValue">
            <div class="!mt-7 !space-y-5">
                <MudTextField @bind-Value="_model.CurrentPassword"
                              For="@(() => _model.CurrentPassword)"
                              Label="Mật khẩu hiện tại"
                              Placeholder="Nhập mật khẩu hiện tại hoặc mật khẩu tạm thời"
                              Variant="Variant.Outlined"
                              InputType="InputType.Password"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Key"
                              Required="true"
                              Immediate="true" />

                <MudTextField @bind-Value="_model.NewPassword"
                              For="@(() => _model.NewPassword)"
                              Label="Mật khẩu mới"
                              Placeholder="Nhập mật khẩu mới"
                              Variant="Variant.Outlined"
                              InputType="InputType.Password"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Lock"
                              Required="true"
                              Immediate="true" />

                <MudTextField @bind-Value="_model.ConfirmPassword"
                              For="@(() => _model.ConfirmPassword)"
                              Label="Xác nhận mật khẩu mới"
                              Placeholder="Nhập lại mật khẩu mới"
                              Variant="Variant.Outlined"
                              InputType="InputType.Password"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.LockReset"
                              Required="true"
                              Immediate="true" />

                <div class="!rounded-2xl !border !border-slate-200 !bg-slate-50 !p-4">
                    <p class="text-sm font-bold text-slate-900">
                        Yêu cầu mật khẩu
                    </p>

                    <ul class="!mt-3 !space-y-2 text-sm font-medium text-slate-600">
                        <li class="flex items-center !gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="text-slate-700" />
                            Tối thiểu 6 ký tự
                        </li>

                        <li class="flex items-center !gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="text-slate-700" />
                            Có ít nhất 1 chữ hoa và 1 chữ thường
                        </li>

                        <li class="flex items-center !gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="text-slate-700" />
                            Có ít nhất 1 chữ số
                        </li>

                        <li class="flex items-center !gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="text-slate-700" />
                            Có ít nhất 1 ký tự đặc biệt
                        </li>
                    </ul>
                </div>

                <div class="flex justify-end !border-t !border-slate-200 !pt-6">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Dark"
                               StartIcon="@Icons.Material.Filled.Save"
                               OnClick="SubmitAsync"
                               Class="!rounded-xl !px-6 !py-2.5 !normal-case">
                        Cập nhật mật khẩu
                    </MudButton>
                </div>
            </div>
        </MudForm>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="!mt-5 !rounded-2xl !border !border-green-100 !bg-green-50 !p-4">
                <p class="text-sm leading-6 font-semibold text-green-700">
                    @_message
                </p>
            </div>
        }
    </div>
</div>

@code {
    private MudForm? _form;

    private readonly AdminChangePasswordModel _model = new();

    private readonly AdminChangePasswordSchema.ChangePassword _validator = new();

    private string _message = string.Empty;

    private async Task SubmitAsync()
    {
        if (_form is null)
        {
            return;
        }

        await _form.Validate();

        if (!_form.IsValid)
        {
            return;
        }

        // TODO: Gọi API đổi mật khẩu admin tại đây.
        // Sau khi đổi thành công, backend nên cập nhật LastLogin hoặc MustChangePassword = false.

        _message = "Đổi mật khẩu thành công.";

        // Sau này có thể chuyển về dashboard:
        // _navigation.NavigateTo(RouterConfig.Admin.Dashboard);
    }
}