@attribute [Route(RouterConfig.Admin.AdminForgotPassword)]
@layout PublicLayout

<PageTitle>@Constant.metaDataAdmin Forgot Password</PageTitle>

<div class="flex min-h-screen items-center justify-center !bg-[#f4f5f7] !px-4 !py-10">
    <div class="w-full max-w-md">
        <div class="!rounded-3xl !border !border-slate-200 !bg-white !p-8 shadow-sm">
            <div class="text-center">
                <div class="mx-auto flex !h-14 !w-14 items-center justify-center !rounded-2xl !bg-[#A05AFF] !text-white shadow-sm">
                    <span class="text-xl font-bold">P</span>
                </div>

                <h1 class="!mt-5 text-2xl font-bold tracking-tight text-slate-900">
                    Quên mật khẩu quản trị
                </h1>

                <p class="!mt-2 text-sm leading-6 text-slate-500">
                    Nhập email hoặc tên đăng nhập. Hệ thống sẽ gửi mật khẩu tạm thời cho tài khoản quản trị.
                </p>
            </div>

            <MudForm @ref="_form"
                     Model="@_model"
                     Validation="@_validator.ValidateValue">
                <div class="!mt-8 !space-y-5">
                    <MudTextField @bind-Value="_model.EmailOrUsername"
                                  For="@(() => _model.EmailOrUsername)"
                                  Label="Email hoặc tên đăng nhập"
                                  Placeholder="Nhập email hoặc tên đăng nhập"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.PersonSearch"
                                  Required="true"
                                  Immediate="true" />

                    <button type="button"
                            @onclick="SubmitAsync"
                            class="inline-flex w-full items-center justify-center !gap-2 !rounded-xl !border !border-[#A05AFF] !bg-[#A05AFF] !px-6 !py-3 text-sm font-bold !text-white shadow-sm transition hover:!bg-[#8B3FE6] hover:!text-white">
                        <MudIcon Icon="@Icons.Material.Filled.MarkEmailRead" Size="Size.Small" />
                        Gửi mật khẩu tạm thời
                    </button>
                </div>
            </MudForm>

            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <div class="!mt-5 !rounded-2xl !border !border-green-100 !bg-green-50 !p-4">
                    <p class="text-sm leading-6 font-semibold text-green-700">
                        @_message
                    </p>
                </div>
            }

            <div class="!mt-6 text-center">
                <a href="@RouterConfig.Admin.Login"
                   class="text-sm font-semibold text-slate-900 transition hover:!text-slate-600">
                    Quay lại đăng nhập
                </a>
            </div>
        </div>
    </div>
</div>

@code {
    private MudForm? _form;

    private readonly AdminForgotPasswordModel _model = new();

    private readonly AdminForgotPasswordSchema.ForgotPassword _validator = new();

    private string _message = string.Empty;

    private async Task SubmitAsync()
    {
        if (_form is null)
        {
            return;
        }

        await _form.ValidateAsync();

        if (!_form.IsValid)
        {
            return;
        }

        // TODO: Gọi API quên mật khẩu admin tại đây.
        // Backend nên tạo password random, set LastLogin = null hoặc MustChangePassword = true.

        _message = "Nếu tài khoản tồn tại, mật khẩu tạm thời sẽ được gửi tới email quản trị";
    }
}