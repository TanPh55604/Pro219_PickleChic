@attribute [Route(RouterConfig.Admin.Login)]
@layout PublicLayout

<PageTitle>@Constant.metaDataAdmin Login</PageTitle>

@if (_isCheckingAuth)
{
    <Loading />
}
else
{
    <div class="flex w-full items-center justify-center !bg-[#f4f5f7] !px-4 !py-10">
        <div class="w-full max-w-md">
            <div class="!rounded-3xl !border !border-slate-200 !bg-white !p-8 shadow-sm">
                <div class="flex flex-col items-center text-center">
                    <div class="flex h-12! !w-12 shrink-0 items-center justify-center overflow-hidden !rounded-full sm:!h-20 sm:!w-20">
                        <img src="/images/logo-admin.png"
                             alt="PickleChic"
                             class="!h-full !w-full object-contain" />
                    </div>

                    <h1 class="!mt-5 text-2xl font-bold tracking-tight text-[#A05AFF]">
                        PICKLECHIC
                    </h1>

                    <p class="!mt-1 text-sm text-slate-500">
                        PickleChic Management
                    </p>
                </div>

                <MudForm @ref="_form"
                         Model="@_model"
                         Validation="@_validator.ValidateValue">
                    <div class="!mt-8 !space-y-5">
                        <MudTextField @bind-Value="_model.Email"
                                      For="@(() => _model.Email)"
                                      Label="Email hoặc tên đăng nhập"
                                      Placeholder="Nhập email hoặc tên đăng nhập"
                                      InputType="InputType.Text"
                                      Variant="Variant.Outlined"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Person"
                                      Required="true"
                                      Immediate="true" />

                        <MudTextField @bind-Value="_model.Password"
                                      For="@(() => _model.Password)"
                                      Label="Mật khẩu"
                                      Placeholder="Nhập mật khẩu"
                                      Variant="Variant.Outlined"
                                      InputType="@PasswordInputType"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@PasswordIcon"
                                      OnAdornmentClick="@(() => _showPassword = !_showPassword)"
                                      Required="true"
                                      Immediate="true" />

                        @* <div class="flex justify-end">
                            <a href="@RouterConfig.Admin.AdminForgotPassword"
                               class="text-sm font-semibold text-[#A05AFF] transition hover:text-[#8B3FE6]">
                                Quên mật khẩu?
                            </a>
                        </div> *@

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Login"
                                   Disabled="@_isSubmitting"
                                   OnClick="SubmitAsync"
                                   Class="w-full !rounded-xl !px-6 !py-3 !normal-case">
                            @(_isSubmitting ? "Đang đăng nhập.." : "Đăng nhập")
                        </MudButton>
                    </div>
                </MudForm>
            </div>

            <p class="!mt-5 text-center text-xs text-slate-400">
                © @DateTime.Now.Year PickleChic Management
            </p>
        </div>
    </div>
}

@code {
    private MudForm? _form;

    private readonly LoginModel _model = new();

    private readonly AdminLoginSchema.Login _validator = new();

    private bool _isSubmitting;

    private bool _isCheckingAuth = true;

    private bool _showPassword;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        ShowSessionMessageIfNeeded();
        await RedirectIfAlreadyLoggedInAsync();

        _isCheckingAuth = false;
        await InvokeAsync(StateHasChanged);
    }

    private void ShowSessionMessageIfNeeded()
    {
        var relative = _navigation.ToBaseRelativePath(_navigation.Uri);
        var queryIndex = relative.IndexOf('?', StringComparison.Ordinal);
        if (queryIndex < 0)
        {
            return;
        }

        var query = relative[(queryIndex + 1)..];
        var session = query.Split('&', StringSplitOptions.RemoveEmptyEntries)
            .Select(part => part.Split('=', 2))
            .Where(parts => parts.Length == 2
                            && parts[0].Equals("session", StringComparison.OrdinalIgnoreCase))
            .Select(parts => Uri.UnescapeDataString(parts[1]))
            .FirstOrDefault();

        if (string.IsNullOrWhiteSpace(session))
        {
            return;
        }

        var message = session.Equals("invalid", StringComparison.OrdinalIgnoreCase)
            ? "Phiên đăng nhập không hợp lệ. Vui lòng đăng nhập lại."
            : "Phiên đăng nhập đã hết hạn. Vui lòng đăng nhập lại.";

        _snackbar.Add(message, Severity.Warning);
        _navigation.NavigateTo(RouterConfig.Admin.Login, replace: true);
    }

    private async Task RedirectIfAlreadyLoggedInAsync()
    {
        var isAuthenticated = await _authStorageService.IsAuthenticatedAsync();

        if (!isAuthenticated)
        {
            return;
        }

        var result = await _currentUserService.CheckCurrentUserAsync();

        if (!result.Success || result.Data is null)
        {
            await _authStorageService.ClearAuthAsync();
            return;
        }

        if (result.Data.IsCustomer)
        {
            _navigation.NavigateTo(RouterConfig.Customer.Home, replace: true);
            return;
        }

        _navigation.NavigateTo(RouterConfig.Admin.Home, replace: true);
    }

    private async Task SubmitAsync()
    {
        if (_form is null || _isSubmitting)
        {
            return;
        }

        await _form.ValidateAsync();

        if (!_form.IsValid)
        {
            return;
        }

        _isSubmitting = true;

        try
        {
            var result = await _authService.LoginAdminAsync(_model);

            if (!result.Success)
            {
                _snackbar.Add(ConvertLoginErrorMessage(result.Message), Severity.Error);
                return;
            }

            _snackbar.Add("Đăng nhập quản trị thành công", Severity.Success);

            if (result.Data?.FirstLogin == true)
            {
                _navigation.NavigateTo(RouterConfig.Admin.AdminChangePassword, replace: true);
                return;
            }

            _navigation.NavigateTo(RouterConfig.Admin.Home, replace: true);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private static string ConvertLoginErrorMessage(string message)
    {
        return message switch
        {
            "Unauthorized" => "Tài khoản hoặc mật khẩu không chính xác",
            "TokenExpired" => "Phiên đăng nhập đã hết hạn",
            "InvalidToken" => "Phiên đăng nhập không hợp lệ",
            _ => string.IsNullOrWhiteSpace(message)
                ? "Đăng nhập không thành công. Vui lòng thử lại"
                : message
        };
    }
    
    private InputType PasswordInputType => _showPassword ? InputType.Text : InputType.Password;

    private string PasswordIcon => _showPassword
        ? Icons.Material.Filled.VisibilityOff
        : Icons.Material.Filled.Visibility;
}