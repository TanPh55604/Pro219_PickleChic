@attribute [Route(RouterConfig.Admin.AttributeDetail)]
@layout AdminLayout

<PageTitle>@Constant.metaDataAdmin Attribute Detail</PageTitle>

@if (_isLoading)
{
    <DetailPageSkeleton ShowImage="true"
                        ShowStatusBadge="false"
                        InfoFieldCount="0"
                        TableRowCount="3" />
}
else
{
    <div class="mx-auto w-full max-w-6xl !space-y-6">
        <div class="flex flex-col !gap-4 md:flex-row md:items-center md:justify-between">
            <div>
                <h1 class="text-2xl font-bold text-slate-900">Chi tiết thuộc tính</h1>
            </div>

            <div class="flex flex-wrap !gap-3">
                <a href="@RouterConfig.Admin.Attributes"
                   class="inline-flex items-center justify-center !gap-2 !rounded-xl !border !border-slate-200 !bg-white !px-5 !py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:!bg-slate-50">
                    <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" />
                    Quay lại
                </a>

                <a href="@RouterConfig.BuildRoute(RouterConfig.Admin.EditAttribute, Id)"
                   class="inline-flex items-center justify-center !gap-2 !rounded-xl !bg-slate-900 !px-5 !py-2.5 text-sm font-semibold !text-white shadow-sm transition hover:!bg-slate-800">
                    <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" />
                    Cập nhật
                </a>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.Delete"
                           OnClick="OpenDeleteDialog"
                           Class="!rounded-xl !px-5 !py-2.5 !normal-case">
                    Xóa
                </MudButton>
            </div>
        </div>

        <div class="!rounded-2xl !border !border-slate-200 !bg-white shadow-sm">
            <div class="!border-b !border-slate-200 !p-6 md:!p-8">
                <div class="flex flex-col !gap-5 md:flex-row md:items-center md:justify-between">
                    <div class="flex items-center !gap-4">
                        <div class="flex !h-16 !w-16 shrink-0 items-center justify-center !rounded-2xl !bg-slate-100 text-slate-500">
                            <MudIcon Icon="@Icons.Material.Filled.Tune" Size="Size.Large" />
                        </div>

                        <div>
                            <h2 class="text-2xl font-bold text-slate-900">
                                @_model.AttributeName
                            </h2>
                            <p class="!mt-1 text-sm text-slate-500">
                                @(_values.Count) giá trị
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="!p-6 md:!p-8">
                <h3 class="text-lg font-bold text-slate-900">
                    Danh sách giá trị
                </h3>

                @if (_values.Count == 0)
                {
                    <div class="!mt-5 !rounded-xl !border !border-dashed !border-slate-300 !p-8 text-center text-sm text-slate-500">
                        Chưa có giá trị nào.
                    </div>
                }
                else
                {
                    <div class="!mt-5">
                        <MudTable Items="_values"
                                  Hover="true"
                                  Elevation="0"
                                  Dense="true">
                            <HeaderContent>
                                <MudTh>STT</MudTh>
                                <MudTh>Giá trị</MudTh>
                                <MudTh>Ghi chú</MudTh>
                            </HeaderContent>

                            <RowTemplate>
                                <MudTd DataLabel="STT">
                                    @(_values.IndexOf(context) + 1)
                                </MudTd>

                                <MudTd DataLabel="Giá trị">
                                    <span class="font-semibold text-slate-900">@context.Value</span>
                                </MudTd>

                                <MudTd DataLabel="Ghi chú">
                                    <span class="text-sm text-slate-600">
                                        @(string.IsNullOrWhiteSpace(context.Note) ? "—" : context.Note)
                                    </span>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private AttributeResponse _model = new();

    private List<AttributeValueResponse> _values = new();

    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadAttributeAsync();
    }

    private async Task LoadAttributeAsync()
    {
        _isLoading = true;

        try
        {
            var result = await _adminAttributeService.GetByIdAsync(Id);

            if (!result.Success || result.Data is null)
            {
                _snackbar.Add(ConvertAttributeErrorMessage(result.Message), Severity.Error);
                _navigation.NavigateTo(RouterConfig.Admin.Attributes, replace: true);
                return;
            }

            _model = result.Data;
            _values = result.Data.AttributeValues ?? new();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OpenDeleteDialog()
    {
        var parameters = new DialogParameters<AttributeDeleteDialog>
        {
            { x => x.Attribute, _model }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.ExtraSmall,
            FullWidth = true
        };

        var dialog = await _dialogService.ShowAsync<AttributeDeleteDialog>("Xóa thuộc tính", parameters, options);
        var dialogResult = await dialog.Result;

        if (dialogResult.Canceled)
        {
            return;
        }

        var result = await _adminAttributeService.DeleteAsync(Id);

        if (!result.Success)
        {
            _snackbar.Add(ConvertAttributeErrorMessage(result.Message), Severity.Error);
            return;
        }

        _snackbar.Add("Xóa thuộc tính thành công.", Severity.Success);

        _navigation.NavigateTo(RouterConfig.Admin.Attributes, replace: true);
    }

    private static string ConvertAttributeErrorMessage(string message)
    {
        return message switch
        {
            "Không tìm thấy" => "Không tìm thấy thuộc tính.",
            "Db Error" => "Không thể xử lý dữ liệu thuộc tính.",
            "TokenExpired" => "Phiên đăng nhập đã hết hạn.",
            "InvalidToken" => "Phiên đăng nhập không hợp lệ.",
            _ => string.IsNullOrWhiteSpace(message)
                ? "Có lỗi xảy ra. Vui lòng thử lại."
                : message
        };
    }
}
