@attribute [Route(RouterConfig.Admin.Attributes)]
@layout AdminLayout

<PageTitle>@Constant.metaDataAdmin Attributes</PageTitle>

<div class="!space-y-5">
    <div class="flex flex-col !gap-3 md:flex-row md:items-center md:justify-between">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">Thuộc tính</h1>
        </div>

        <a href="@RouterConfig.Admin.CreateAttribute"
           class="inline-flex items-center justify-center !gap-2 !rounded-xl !bg-[#A05AFF] !px-4 !py-2.5 text-sm font-semibold !text-white shadow-sm transition hover:!bg-[#8B3FE6]">
            <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
            Thêm thuộc tính
        </a>
    </div>

    <div class="!rounded-2xl !border !border-slate-200 !bg-white !p-5 shadow-sm">
        <div class="!mb-4 flex flex-col !gap-3 md:flex-row md:items-center md:justify-between">
            <div class="flex w-full flex-col !gap-2 md:max-w-xl md:flex-row">
                <MudTextField @bind-Value="_searchText"
                              Placeholder="Tìm kiếm theo tên thuộc tính.."
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              OnKeyDown="HandleSearchKeyDown"
                              Class="flex-1" />

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Search"
                           OnClick="SearchAsync"
                           Disabled="@_isLoading"
                           Class="!rounded-xl !px-5 !normal-case">
                    Tìm kiếm
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="ResetSearchAsync"
                           Disabled="@_isLoading"
                           Class="!rounded-xl !px-5 !normal-case">
                    Làm mới
                </MudButton>
            </div>
        </div>

        <MudTable Items="_attributes"
                  Loading="@_isLoading"
                  Hover="true"
                  Elevation="0"
                  FixedHeader="true"
                  Height="calc(100vh - 340px)"
                  RowsPerPage="10">
            <HeaderContent>
                <MudTh>STT</MudTh>
                <MudTh>Thể loại</MudTh>
                <MudTh>Tên thuộc tính</MudTh>
                <MudTh>Số giá trị</MudTh>
                <MudTh Class="text-right">Chi tiết</MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd DataLabel="STT">
                    <span class="font-medium text-slate-700">
                        @(_attributes.IndexOf(context) + 1)
                    </span>
                </MudTd>

                <MudTd DataLabel="Thể loại">
                    <span class="text-sm text-slate-600">@GetCategoryName(context.CategoryId)</span>
                </MudTd>

                <MudTd DataLabel="Tên thuộc tính">
                    <a href="@RouterConfig.BuildRoute(RouterConfig.Admin.AttributeDetail, context.Id)"
                       class="font-semibold text-slate-900 transition hover:text-slate-600">
                        @context.AttributeName
                    </a>
                </MudTd>

                <MudTd DataLabel="Số giá trị">
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">
                        @(context.AttributeValues?.Count ?? 0) giá trị
                    </MudChip>
                </MudTd>

                <MudTd DataLabel="Chi tiết" Class="text-right">
                    <a href="@RouterConfig.BuildRoute(RouterConfig.Admin.AttributeDetail, context.Id)"
                       class="inline-flex !h-9 !w-9 items-center justify-center !rounded-lg text-[#4BCBEB] transition hover:!bg-[#4BCBEB]/15 hover:text-[#4BCBEB]">
                        <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
                    </a>
                </MudTd>
            </RowTemplate>

            <NoRecordsContent>
                <div class="!py-10 text-center text-slate-500">
                    Không có thuộc tính nào
                </div>
            </NoRecordsContent>

            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 5, 10, 20 }" />
            </PagerContent>
        </MudTable>
    </div>
</div>

@code {
    private string _searchText = string.Empty;

    private bool _isLoading = true;

    private List<AttributeResponse> _attributes = new();

    private List<CategoryResponse> _categories = new();

    protected override async Task OnInitializedAsync()
    {
        var categoryResult = await _adminCategoryService.GetAllAsync();
        _categories = categoryResult.Data?.Where(c => c.IsActive).ToList() ?? new();

        await LoadAttributesAsync();
    }

    private async Task LoadAttributesAsync()
    {
        _isLoading = true;

        try
        {
            var result = await _adminAttributeService.GetAllAsync(_searchText);

            if (!result.Success)
            {
                _snackbar.Add(ConvertAttributeErrorMessage(result.Message), Severity.Error);
                return;
            }

            _attributes = result.Data ?? new();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SearchAsync()
    {
        await LoadAttributesAsync();
    }

    private async Task ResetSearchAsync()
    {
        _searchText = string.Empty;
        await LoadAttributesAsync();
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await SearchAsync();
        }
    }

    private string GetCategoryName(int? categoryId)
    {
        if (!categoryId.HasValue || categoryId.Value <= 0)
        {
            return "Chưa gán";
        }

        return _categories.FirstOrDefault(c => c.Id == categoryId.Value)?.Name ?? "—";
    }

    private static string ConvertAttributeErrorMessage(string message)
    {
        return message switch
        {
            "Db Error" => "Không thể tải danh sách thuộc tính",
            "TokenExpired" => "Phiên đăng nhập đã hết hạn",
            "InvalidToken" => "Phiên đăng nhập không hợp lệ",
            _ => string.IsNullOrWhiteSpace(message)
                ? "Có lỗi xảy ra. Vui lòng thử lại"
                : message
        };
    }
}
