@attribute [Route(RouterConfig.Admin.StaffDetail)]
@layout AdminLayout

<PageTitle>@Constant.metaDataAdmin Staff Detail</PageTitle>

@if (_isLoading)
{
    <DetailPageSkeleton ShowImage="true"
                        ShowSubtitle="true"
                        ShowDeleteButton="false"
                        InfoFieldCount="6" />
}
else
{
    <div class="mx-auto w-full max-w-6xl !space-y-6">
        <div class="flex flex-col !gap-4 md:flex-row md:items-center md:justify-between">
            <div>
                <h1 class="text-2xl font-bold text-slate-900">Chi tiết quản trị viên</h1>
            </div>

            <div class="flex flex-wrap !gap-3">
                <a href="@RouterConfig.Admin.Staffs"
                   class="inline-flex items-center justify-center !gap-2 !rounded-xl !border !border-slate-200 !bg-white !px-5 !py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:!bg-slate-50">
                    <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" />
                    Quay lại
                </a>

                <AuthorizeControl Action="@Constant.ActionButton.Edit">
                    <a href="@RouterConfig.BuildRoute(RouterConfig.Admin.EditStaff, Id)"
                       class="inline-flex items-center justify-center !gap-2 !rounded-xl !bg-[#A05AFF] !px-5 !py-2.5 text-sm font-semibold !text-white shadow-sm transition hover:!bg-[#8B3FE6]">
                        <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" />
                        Cập nhật
                    </a>
                </AuthorizeControl>
            </div>
        </div>

        <div class="!rounded-2xl !border !border-slate-200 !bg-white shadow-sm">
            <div class="!border-b !border-slate-200 !p-6 md:!p-8">
                <div class="flex flex-col !gap-5 md:flex-row md:items-center md:justify-between">
                    <div class="flex flex-col items-center !gap-4 text-center md:flex-row md:text-left">
                        <div class="flex !h-20 !w-20 shrink-0 items-center justify-center !rounded-2xl !bg-[#A05AFF] !text-white shadow-sm">
                            <span class="text-3xl font-black">
                                @GetAvatarText(_model.FullName)
                            </span>
                        </div>

                        <div>
                            <h2 class="text-2xl font-bold text-slate-900">
                                @_model.FullName
                            </h2>

                            <p class="!mt-1 text-sm text-slate-500">
                                @_model.Email
                            </p>
                        </div>
                    </div>

                    <div class="flex flex-wrap justify-center !gap-2 md:justify-end">
                        @if (_model.IsActive)
                        {
                            <span class="inline-flex items-center !rounded-full !bg-green-50 !px-4 !py-2 text-sm font-bold !text-green-700">
                                Đang hoạt động
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center !rounded-full !bg-red-50 !px-4 !py-2 text-sm font-bold !text-red-700">
                                Tạm khóa
                            </span>
                        }
                    </div>
                </div>
            </div>

            <div class="!p-6 md:!p-8">
                <h3 class="text-lg font-bold text-slate-900">
                    Thông tin tài khoản
                </h3>

                <div class="!mt-5 grid !gap-4 md:grid-cols-2 xl:grid-cols-3">
                    <div class="!rounded-xl !bg-slate-50 !p-4">
                        <p class="text-sm text-slate-500">Họ tên</p>
                        <p class="!mt-2 text-base font-semibold text-slate-900">
                            @_model.FullName
                        </p>
                    </div>

                    <div class="!rounded-xl !bg-slate-50 !p-4">
                        <p class="text-sm text-slate-500">Tên đăng nhập</p>
                        <p class="!mt-2 text-base font-semibold text-slate-900">
                            @_model.UserName
                        </p>
                    </div>

                    <div class="!rounded-xl !bg-slate-50 !p-4">
                        <p class="text-sm text-slate-500">Email</p>
                        <p class="!mt-2 text-base font-semibold break-all text-slate-900">
                            @_model.Email
                        </p>
                    </div>

                    <div class="!rounded-xl !bg-slate-50 !p-4">
                        <p class="text-sm text-slate-500">Số điện thoại</p>
                        <p class="!mt-2 text-base font-semibold text-slate-900">
                            @(string.IsNullOrWhiteSpace(_model.PhoneNumber) ? "Chưa cập nhật" : _model.PhoneNumber)
                        </p>
                    </div>

                    <div class="!rounded-xl !bg-slate-50 !p-4">
                        <p class="text-sm text-slate-500">Vai trò</p>
                        <p class="!mt-2 text-base font-semibold text-slate-900">
                            @_roleName
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private StaffResponse _model = new();
    private string _roleName = "Chưa phân quyền";

    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadStaffAsync();
    }

    private async Task LoadStaffAsync()
    {
        _isLoading = true;

        try
        {
            var result = await _adminStaffService.GetByIdAsync(Id);

            if (!result.Success || result.Data is null)
            {
                _snackbar.Add(ConvertStaffErrorMessage(result.Message), Severity.Error);
                _navigation.NavigateTo(RouterConfig.Admin.Staffs, replace: true);
                return;
            }

            _model = result.Data;

            var roleResult = await _adminRoleService.GetByIdAsync(_model.RoleId);
            if (roleResult.Success && roleResult.Data is not null)
            {
                _roleName = roleResult.Data.RoleName;
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string GetAvatarText(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
        {
            return "A";
        }

        return fullName.Trim()[0].ToString().ToUpperInvariant();
    }

    private static string ConvertStaffErrorMessage(string message)
    {
        return message switch
        {
            "Không tìm thấy" => "Không tìm thấy quản trị viên",
            "Db Error" => "Không thể tải thông tin quản trị viên",
            "TokenExpired" => "Phiên đăng nhập đã hết hạn",
            "InvalidToken" => "Phiên đăng nhập không hợp lệ",
            _ => string.IsNullOrWhiteSpace(message)
                ? "Có lỗi xảy ra. Vui lòng thử lại"
                : message
        };
    }
}