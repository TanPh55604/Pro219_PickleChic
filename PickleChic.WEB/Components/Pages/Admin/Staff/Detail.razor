@attribute [Route(RouterConfig.Admin.StaffDetail)]
@layout AdminLayout

<PageTitle>@Constant.metaDataAdmin Staff Detail</PageTitle>

<div class="mx-auto w-full max-w-7xl !space-y-6">
    <div class="flex flex-col !gap-4 md:flex-row md:items-center md:justify-between">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">Chi tiết quản trị viên</h1>
        </div>

        <div class="flex flex-wrap !gap-3">
            <a href="@RouterConfig.Admin.Staffs"
               class="inline-flex items-center justify-center !gap-2 !rounded-xl !border !border-slate-200 !bg-white !px-5 !py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:!bg-slate-50">
                <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" />
                Quay lại
            </a>

            <a href="@RouterConfig.BuildRoute(RouterConfig.Admin.EditStaff, Id)"
               class="inline-flex items-center justify-center !gap-2 !rounded-xl !bg-slate-900 !px-5 !py-2.5 text-sm font-semibold !text-white shadow-sm transition hover:!bg-slate-800">
                <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" />
                Cập nhật
            </a>
        </div>
    </div>

    <div class="grid !gap-6 xl:grid-cols-12">
        <div class="xl:col-span-4">
            <div class="!rounded-2xl !border !border-slate-200 !bg-white !p-6 shadow-sm">
                <div class="flex flex-col items-center text-center">
                    <div class="flex !h-24 !w-24 items-center justify-center !rounded-full !bg-slate-900 !text-white shadow-sm">
                        <span class="text-3xl font-black">
                            @GetAvatarText(_model.FullName)
                        </span>
                    </div>

                    <h2 class="!mt-5 text-2xl font-bold text-slate-900">
                        @_model.FullName
                    </h2>

                    <p class="!mt-1 text-sm text-slate-500">
                        @_model.Email
                    </p>

                    <p class="!mt-1 text-sm font-semibold text-slate-700">
                        @_model.Username
                    </p>

                    <div class="!mt-4 flex flex-wrap justify-center !gap-2">
                        @if (_model.IsActive)
                        {
                            <MudChip T="string" Color="Color.Success" Variant="Variant.Text">
                                Đang hoạt động
                            </MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Color="Color.Error" Variant="Variant.Text">
                                Tạm khóa
                            </MudChip>
                        }

                        @if (_model.LastLogin is null)
                        {
                            <MudChip T="string" Color="Color.Warning" Variant="Variant.Text">
                                Cần đổi mật khẩu
                            </MudChip>
                        }
                    </div>
                </div>

                <div class="!mt-6 !rounded-2xl !bg-slate-50 !p-5">
                    <p class="text-sm text-slate-500">Vai trò</p>
                    <p class="!mt-2 text-xl font-black text-slate-900">
                        @GetRoleName(_model.RoleId)
                    </p>
                </div>
            </div>
        </div>

        <div class="xl:col-span-8">
            <div class="!rounded-2xl !border !border-slate-200 !bg-white !p-6 shadow-sm md:!p-8">
                <h2 class="text-lg font-bold text-slate-900">
                    Thông tin quản trị viên
                </h2>

                <div class="!mt-6 grid !gap-5 md:grid-cols-2 xl:grid-cols-3">
                    <div class="!rounded-xl !bg-slate-50 !p-4">
                        <p class="text-sm text-slate-500">Tên đăng nhập</p>
                        <p class="!mt-2 text-base font-semibold text-slate-900">@_model.Username</p>
                    </div>

                    <div class="!rounded-xl !bg-slate-50 !p-4">
                        <p class="text-sm text-slate-500">Số điện thoại</p>
                        <p class="!mt-2 text-base font-semibold text-slate-900">
                            @(_model.PhoneNumber ?? "Chưa cập nhật")
                        </p>
                    </div>

                    <div class="!rounded-xl !bg-slate-50 !p-4">
                        <p class="text-sm text-slate-500">Vai trò</p>
                        <p class="!mt-2 text-base font-semibold text-slate-900">
                            @GetRoleName(_model.RoleId)
                        </p>
                    </div>

                    <div class="!rounded-xl !bg-slate-50 !p-4">
                        <p class="text-sm text-slate-500">Lần đăng nhập cuối</p>
                        <p class="!mt-2 text-base font-semibold text-slate-900">
                            @(_model.LastLogin?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa đăng nhập")
                        </p>
                    </div>

                    <div class="!rounded-xl !bg-slate-50 !p-4">
                        <p class="text-sm text-slate-500">Trạng thái</p>
                        <p class="!mt-2 text-base font-semibold text-slate-900">
                            @(_model.IsActive ? "Đang hoạt động" : "Tạm khóa")
                        </p>
                    </div>

                    <div class="!rounded-xl !bg-slate-50 !p-4">
                        <p class="text-sm text-slate-500">Mật khẩu mặc định</p>
                        <p class="!mt-2 text-base font-semibold text-slate-900">
                            @(_model.LastLogin is null ? "Chưa đổi" : "Đã đổi")
                        </p>
                    </div>
                </div>

                <div class="!mt-7 !rounded-2xl !border !border-slate-200 !p-5">
                    <p class="text-sm font-medium text-slate-500">Email</p>
                    <p class="!mt-3 text-base leading-7 break-all text-slate-800">
                        @_model.Email
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public int Id { get; set; }

    private StaffModel _model = new();

    protected override void OnInitialized()
    {
        _model = new StaffModel
        {
            Id = Id,
            FullName = "Nguyễn Văn Quản Trị",
            Username = "nguyenadmin",
            Email = "nguyenadmin@gmail.com",
            PhoneNumber = "0900000002",
            PasswordHash = "Admin12345@",
            RoleId = 2,
            Status = 1,
            LastLogin = null
        };
    }

    private static string GetAvatarText(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
        {
            return "A";
        }

        return fullName.Trim()[0].ToString().ToUpperInvariant();
    }

    private static string GetRoleName(int roleId)
    {
        return roleId switch
        {
            1 => "Quản trị hệ thống",
            2 => "Nhân viên quản trị",
            3 => "Nhân viên bán hàng",
            _ => "Chưa phân quyền"
        };
    }
}