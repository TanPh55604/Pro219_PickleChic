@attribute [Route(RouterConfig.Admin.CreateStaff)]
@layout AdminLayout

<PageTitle>@Constant.metaDataAdmin Create Staff</PageTitle>

<div class="mx-auto w-full max-w-5xl !space-y-6">
    <div class="flex flex-col !gap-4 md:flex-row md:items-center md:justify-between">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">Tạo quản trị viên</h1>
        </div>

        <a href="@RouterConfig.Admin.Staffs"
           class="inline-flex items-center justify-center !gap-2 !rounded-xl !border !border-slate-200 !bg-white !px-5 !py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:!bg-slate-50">
            <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" />
            Quay lại
        </a>
    </div>

    <div class="!rounded-2xl !border !border-slate-200 !bg-white !p-6 shadow-sm md:!p-8">
        <MudForm @ref="_form"
                 Model="@_model"
                 Validation="@_validator.ValidateValue">
            <div class="!space-y-6">
                <div>
                    <h2 class="text-lg font-bold text-slate-900">Thông tin quản trị viên</h2>
                </div>

                <div class="grid !gap-5 md:grid-cols-2">
                    <MudTextField @bind-Value="_model.FullName"
                                  For="@(() => _model.FullName)"
                                  Label="Họ tên"
                                  Placeholder="Nhập họ tên"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  Immediate="true" />

                    <MudTextField @bind-Value="_model.UserName"
                                  For="@(() => _model.UserName)"
                                  Label="Tên đăng nhập"
                                  Placeholder="Nhập tên đăng nhập"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  Immediate="true" />

                    <MudTextField @bind-Value="_model.Email"
                                  For="@(() => _model.Email)"
                                  Label="Email"
                                  Placeholder="Nhập email"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Email"
                                  Required="true"
                                  Immediate="true" />

                    <MudTextField @bind-Value="_model.PhoneNumber"
                                  For="@(() => _model.PhoneNumber)"
                                  Label="Số điện thoại"
                                  Placeholder="Nhập số điện thoại"
                                  Variant="Variant.Outlined"
                                  MaxLength="10"
                                  Immediate="true" />

                    <MudSelect T="int"
                               @bind-Value="_model.RoleId"
                               For="@(() => _model.RoleId)"
                               Label="Vai trò"
                               Variant="Variant.Outlined">
                        @foreach (var role in _roles)
                        {
                            <MudSelectItem T="int" Value="@role.Id">@role.Name</MudSelectItem>
                        }
                    </MudSelect>

                    <MudSelect T="int"
                               @bind-Value="_model.Status"
                               For="@(() => _model.Status)"
                               Label="Trạng thái"
                               Variant="Variant.Outlined">
                        <MudSelectItem T="int" Value="1">Đang hoạt động</MudSelectItem>
                        <MudSelectItem T="int" Value="0">Tạm khóa</MudSelectItem>
                    </MudSelect>
                </div>

                <AuthorizeControl Action="@Constant.ActionButton.Create">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Save"
                               OnClick="SubmitAsync"
                               Disabled="@_isSubmitting"
                               Class="!rounded-xl !px-6 !py-2.5 !normal-case">
                        @(_isSubmitting ? "Đang lưu.." : "Lưu")
                    </MudButton>
                </AuthorizeControl>
            </div>
        </MudForm>
    </div>
</div>

@code {
    private MudForm? _form;

    private readonly StaffModel _model = new()
    {
        PasswordHash = "Admin12345@",
        RoleId = 1,
        Status = 1,
        LastLogin = DateTime.Now,
    };

    private readonly StaffSchema.CreateUpdate _validator = new();

    private bool _isSubmitting;

    private List<RoleOption> _roles = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadRolesAsync();
    }

    private async Task LoadRolesAsync()
    {
        var result = await _adminRoleService.GetAllAsync();
        if (!result.Success || result.Data is null)
        {
            _snackbar.Add("Không thể tải danh sách vai trò", Severity.Error);
            return;
        }

        _roles = result.Data
            .Where(x => x.Status == 1 && !string.Equals(x.RoleName, "Customer", StringComparison.OrdinalIgnoreCase))
            .Select(x => new RoleOption(x.Id, x.RoleName))
            .ToList();

        if (_roles.Count > 0 && _roles.All(x => x.Id != _model.RoleId))
        {
            _model.RoleId = _roles[0].Id;
        }
    }

    private async Task SubmitAsync()
    {
        if (_form is null || _isSubmitting)
        {
            return;
        }

        await _form.ValidateAsync();

        if (!_form.IsValid)
        {
            return;
        }

        _isSubmitting = true;

        try
        {
            var result = await _adminStaffService.CreateAsync(_model);

            if (!result.Success)
            {
                _snackbar.Add(ConvertStaffErrorMessage(result.Message), Severity.Error);
                return;
            }

            _snackbar.Add("Tạo quản trị viên thành công", Severity.Success);

            _navigation.NavigateTo(RouterConfig.Admin.Staffs);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private static string ConvertStaffErrorMessage(string message)
    {
        return message switch
        {
            "Db Error" => "Không thể tạo quản trị viên",
            "TokenExpired" => "Phiên đăng nhập đã hết hạn",
            "InvalidToken" => "Phiên đăng nhập không hợp lệ",
            _ => string.IsNullOrWhiteSpace(message)
                ? "Có lỗi xảy ra. Vui lòng thử lại"
                : message
        };
    }

    private record RoleOption(int Id, string Name);
}