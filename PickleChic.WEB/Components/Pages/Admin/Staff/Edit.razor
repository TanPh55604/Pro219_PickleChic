@attribute [Route(RouterConfig.Admin.EditStaff)]
@layout AdminLayout

<PageTitle>@Constant.metaDataAdmin Edit Staff</PageTitle>

<div class="mx-auto w-full max-w-5xl !space-y-6">
    <div class="flex flex-col !gap-4 md:flex-row md:items-center md:justify-between">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">Cập nhật quản trị viên</h1>
        </div>

        <a href="@RouterConfig.BuildRoute(RouterConfig.Admin.StaffDetail, Id)"
           class="inline-flex items-center justify-center !gap-2 !rounded-xl !border !border-slate-200 !bg-white !px-5 !py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:!bg-slate-50">
            <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" />
            Quay lại
        </a>
    </div>

    <div class="!rounded-2xl !border !border-slate-200 !bg-white !p-6 shadow-sm md:!p-8">
        <MudForm @ref="_form"
                 Model="@_model"
                 Validation="@_validator.ValidateValue">
            <div class="!space-y-6">
                <div>
                    <h2 class="text-lg font-bold text-slate-900">Thông tin quản trị viên</h2>
                </div>

                <div class="grid !gap-5 md:grid-cols-2">
                    <MudTextField @bind-Value="_model.FullName"
                                  For="@(() => _model.FullName)"
                                  Label="Họ tên"
                                  Placeholder="Nhập họ tên"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  Immediate="true" />

                    <MudTextField @bind-Value="_model.Username"
                                  For="@(() => _model.Username)"
                                  Label="Tên đăng nhập"
                                  Placeholder="Nhập tên đăng nhập"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  Immediate="true" />

                    <MudTextField @bind-Value="_model.Email"
                                  For="@(() => _model.Email)"
                                  Label="Email"
                                  Placeholder="Nhập email"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Email"
                                  Required="true"
                                  Immediate="true" />

                    <MudTextField @bind-Value="_model.PhoneNumber"
                                  For="@(() => _model.PhoneNumber)"
                                  Label="Số điện thoại"
                                  Placeholder="Nhập số điện thoại"
                                  Variant="Variant.Outlined"
                                  Immediate="true" />

                    <MudSelect T="int"
                               @bind-Value="_model.RoleId"
                               For="@(() => _model.RoleId)"
                               Label="Vai trò"
                               Variant="Variant.Outlined">
                        @foreach (var role in _roles)
                        {
                            <MudSelectItem T="int" Value="@role.Id">@role.Name</MudSelectItem>
                        }
                    </MudSelect>

                    <MudSelect T="int"
                               @bind-Value="_model.Status"
                               For="@(() => _model.Status)"
                               Label="Trạng thái"
                               Variant="Variant.Outlined">
                        <MudSelectItem T="int" Value="1">Đang hoạt động</MudSelectItem>
                        <MudSelectItem T="int" Value="0">Tạm khóa</MudSelectItem>
                    </MudSelect>
                </div>

                <div class="flex justify-end !border-t !border-slate-200 !pt-6">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Dark"
                               StartIcon="@Icons.Material.Filled.Save"
                               OnClick="SubmitAsync"
                               Class="!rounded-xl !px-6 !py-2.5 !normal-case">
                        Cập nhật
                    </MudButton>
                </div>
            </div>
        </MudForm>
    </div>
</div>

@code {
    [Parameter] public int Id { get; set; }

    private MudForm? _form;

    private StaffModel _model = new();

    private readonly StaffSchema.CreateUpdate _validator = new();

    private readonly List<RoleOption> _roles = new()
    {
        new(1, "Quản trị hệ thống"),
        new(2, "Nhân viên quản trị"),
        new(3, "Nhân viên bán hàng")
    };

    protected override void OnInitialized()
    {
        _model = new StaffModel
        {
            Id = Id,
            FullName = "Nguyễn Văn Quản Trị",
            Username = "nguyenadmin",
            Email = "nguyenadmin@gmail.com",
            PhoneNumber = "0900000002",
            PasswordHash = "Admin12345@",
            RoleId = 2,
            Status = 1,
            LastLogin = null
        };
    }

    private async Task SubmitAsync()
    {
        if (_form is null)
        {
            return;
        }

        await _form.Validate();

        if (!_form.IsValid)
        {
            return;
        }

        // TODO: Gọi API cập nhật staff.

        _navigation.NavigateTo(RouterConfig.BuildRoute(RouterConfig.Admin.StaffDetail, Id));
    }

    private record RoleOption(int Id, string Name);
}