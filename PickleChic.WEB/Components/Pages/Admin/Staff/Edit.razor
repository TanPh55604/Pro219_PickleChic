@attribute [Route(RouterConfig.Admin.EditStaff)]
@layout AdminLayout

<PageTitle>@Constant.metaDataAdmin Edit Staff</PageTitle>

@if (_isLoading)
{
    <EditPageSkeleton FieldCount="6" HasFullWidthField="false" />
}
else
{
<div class="mx-auto w-full max-w-5xl !space-y-6">
    <div class="flex flex-col !gap-4 md:flex-row md:items-center md:justify-between">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">Cập nhật quản trị viên</h1>
        </div>

        <a href="@RouterConfig.BuildRoute(RouterConfig.Admin.StaffDetail, Id)"
           class="inline-flex items-center justify-center !gap-2 !rounded-xl !border !border-slate-200 !bg-white !px-5 !py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:!bg-slate-50">
            <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" />
            Quay lại
        </a>
    </div>

    <div class="!rounded-2xl !border !border-slate-200 !bg-white !p-6 shadow-sm md:!p-8">
        <MudForm @ref="_form"
                 Model="@_model"
                 Validation="@_validator.ValidateValue">
            <div class="!space-y-6">
                <div>
                    <h2 class="text-lg font-bold text-slate-900">Thông tin quản trị viên</h2>
                </div>

                <div class="grid !gap-5 md:grid-cols-2">
                    <MudTextField @bind-Value="_model.FullName"
                                  For="@(() => _model.FullName)"
                                  Label="Họ tên"
                                  Placeholder="Nhập họ tên"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  Immediate="true" />

                    <MudTextField @bind-Value="_model.UserName"
                                  For="@(() => _model.UserName)"
                                  Label="Tên đăng nhập"
                                  Placeholder="Nhập tên đăng nhập"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  Immediate="true" />

                    <MudTextField @bind-Value="_model.Email"
                                  For="@(() => _model.Email)"
                                  Label="Email"
                                  Placeholder="Nhập email"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Email"
                                  Required="true"
                                  Immediate="true" />

                    <MudTextField @bind-Value="_model.PhoneNumber"
                                  For="@(() => _model.PhoneNumber)"
                                  Label="Số điện thoại"
                                  Placeholder="Nhập số điện thoại"
                                  Variant="Variant.Outlined"
                                  Immediate="true" />

                    <MudSelect T="int"
                               @bind-Value="_model.RoleId"
                               For="@(() => _model.RoleId)"
                               Label="Vai trò"
                               Variant="Variant.Outlined">
                        @foreach (var role in _roles)
                        {
                            <MudSelectItem T="int" Value="@role.Id">@role.Name</MudSelectItem>
                        }
                    </MudSelect>

                    <MudSelect T="int"
                               Disabled="@_isCurrentAccount"
                               @bind-Value="_model.Status"
                               For="@(() => _model.Status)"
                               Label="Trạng thái"
                               Variant="Variant.Outlined">
                        <MudSelectItem T="int" Value="1">Đang hoạt động</MudSelectItem>
                        <MudSelectItem T="int" Value="0">Tạm khóa</MudSelectItem>
                    </MudSelect>
                </div>

                <div class="flex justify-end !border-t !border-slate-200 !pt-6">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Save"
                               OnClick="SubmitAsync"
                               Disabled="@_isSubmitting"
                               Class="!rounded-xl !px-6 !py-2.5 !normal-case">
                        @(_isSubmitting ? "Đang cập nhật.." : "Cập nhật")
                    </MudButton>
                </div>
            </div>
        </MudForm>
    </div>
</div>
}

@code {
    [Parameter] public int Id { get; set; }

    private MudForm? _form;

    private StaffModel _model = new();

    private readonly StaffSchema.CreateUpdate _validator = new();

    private bool _isLoading = true;
    private bool _isSubmitting;
    private bool _isCurrentAccount;

    private readonly List<RoleOption> _roles = new()
    {
        new(1, "Quản trị hệ thống"),
        new(2, "Nhân viên quản trị"),
        new(3, "Nhân viên bán hàng")
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadStaffAsync();
    }

    private async Task LoadStaffAsync()
    {
        _isLoading = true;

        try
        {
            var result = await _adminStaffService.GetByIdAsync(Id);

            if (!result.Success || result.Data is null)
            {
                _snackbar.Add(ConvertStaffErrorMessage(result.Message), Severity.Error);
                _navigation.NavigateTo(RouterConfig.Admin.Staffs, replace: true);
                return;
            }

            _model = MapToModel(result.Data);

            var currentUser = await _authStorageService.GetUserAsync();
            _isCurrentAccount = currentUser?.Id == _model.Id;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SubmitAsync()
    {
        if (_form is null || _isSubmitting)
        {
            return;
        }

        await _form.ValidateAsync();

        if (!_form.IsValid)
        {
            return;
        }

        _isSubmitting = true;

        try
        {
            var result = await _adminStaffService.UpdateAsync(_model);

            if (!result.Success)
            {
                _snackbar.Add(ConvertStaffErrorMessage(result.Message), Severity.Error);
                return;
            }

            _snackbar.Add("Cập nhật quản trị viên thành công", Severity.Success);

            _navigation.NavigateTo(RouterConfig.BuildRoute(RouterConfig.Admin.StaffDetail, Id));
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private static string ConvertStaffErrorMessage(string message)
    {
        return message switch
        {
            "Db Error" => "Không thể xử lý dữ liệu quản trị viên",
            "Không tìm thấy" => "Không tìm thấy quản trị viên",
            "TokenExpired" => "Phiên đăng nhập đã hết hạn",
            "InvalidToken" => "Phiên đăng nhập không hợp lệ",
            _ => string.IsNullOrWhiteSpace(message)
                ? "Có lỗi xảy ra. Vui lòng thử lại"
                : message
        };
    }

    private static StaffModel MapToModel(StaffResponse response)
    {
        return new StaffModel
        {
            Id = response.Id,
            FullName = response.FullName,
            UserName = response.UserName,
            Email = response.Email,
            PhoneNumber = response.PhoneNumber,
            RoleId = response.RoleId,
            Status = response.Status,
            LastLogin = response.LastLogin
        };
    }

    private record RoleOption(int Id, string Name);
}