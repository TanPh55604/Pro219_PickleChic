@attribute [Route(RouterConfig.Admin.Staffs)]
@layout AdminLayout

<PageTitle>@Constant.metaDataAdmin Staffs</PageTitle>

<div class="!space-y-5">
    <div class="flex flex-col !gap-3 md:flex-row md:items-center md:justify-between">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">Quản trị viên</h1>
        </div>

        <a href="@RouterConfig.Admin.CreateStaff"
           class="inline-flex items-center justify-center !gap-2 !rounded-xl !bg-slate-900 !px-4 !py-2.5 text-sm font-semibold !text-white shadow-sm transition hover:!bg-slate-800">
            <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
            Thêm quản trị viên
        </a>
    </div>

    <div class="!rounded-2xl !border !border-slate-200 !bg-white !p-5 shadow-sm">
        <div class="!mb-4 flex flex-col !gap-3 md:flex-row md:items-center md:justify-between">
            <MudTextField @bind-Value="_searchText"
                          Placeholder="Tìm kiếm theo username, tên, email, số điện thoại..."
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Class="md:!max-w-md" />

            <MudSelect T="int?"
                       @bind-Value="_statusFilter"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Class="md:!w-48">
                <MudSelectItem T="int?" Value="@((int?)null)">Tất cả trạng thái</MudSelectItem>
                <MudSelectItem T="int?" Value="@((int?)1)">Đang hoạt động</MudSelectItem>
                <MudSelectItem T="int?" Value="@((int?)0)">Tạm khóa</MudSelectItem>
            </MudSelect>
        </div>

        <MudTable Items="FilteredStaffs"
                  Hover="true"
                  Elevation="0"
                  FixedHeader="true"
                  Height="calc(100vh - 310px)"
                  RowsPerPage="10">
            <HeaderContent>
                <MudTh>STT</MudTh>
                <MudTh>Quản trị viên</MudTh>
                <MudTh>Username</MudTh>
                <MudTh>Số điện thoại</MudTh>
                <MudTh>Vai trò</MudTh>
                <MudTh>Đăng nhập</MudTh>
                <MudTh>Trạng thái</MudTh>
                <MudTh Class="text-right">Chi tiết</MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd DataLabel="STT">
                    <span class="font-medium text-slate-700">
                        @(FilteredStaffs.IndexOf(context) + 1)
                    </span>
                </MudTd>

                <MudTd DataLabel="Quản trị viên">
                    <a href="@RouterConfig.BuildRoute(RouterConfig.Admin.StaffDetail, context.Id)"
                       class="font-semibold text-slate-900 transition hover:text-slate-600">
                        @context.FullName
                    </a>

                    <p class="!mt-1 text-xs text-slate-500">@context.Email</p>
                </MudTd>

                <MudTd DataLabel="Username">
                    <span class="text-sm font-semibold text-slate-700">@context.Username</span>
                </MudTd>

                <MudTd DataLabel="Số điện thoại">
                    <span class="text-sm text-slate-700">@(context.PhoneNumber ?? "Chưa cập nhật")</span>
                </MudTd>

                <MudTd DataLabel="Vai trò">
                    <span class="text-sm font-semibold text-slate-700">
                        @GetRoleName(context.RoleId)
                    </span>
                </MudTd>

                <MudTd DataLabel="Đăng nhập">
                    @if (context.LastLogin is null)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">
                            Chưa đăng nhập
                        </MudChip>
                    }
                    else
                    {
                        <span class="text-sm text-slate-600">
                            @context.LastLogin.Value.ToString("dd/MM/yyyy HH:mm")
                        </span>
                    }
                </MudTd>

                <MudTd DataLabel="Trạng thái">
                    @if (context.IsActive)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">
                            Đang hoạt động
                        </MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Text">
                            Tạm khóa
                        </MudChip>
                    }
                </MudTd>

                <MudTd DataLabel="Chi tiết" Class="text-right">
                    <a href="@RouterConfig.BuildRoute(RouterConfig.Admin.StaffDetail, context.Id)"
                       class="inline-flex !h-9 !w-9 items-center justify-center !rounded-lg text-slate-500 transition hover:!bg-slate-100 hover:text-slate-900">
                        <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
                    </a>
                </MudTd>
            </RowTemplate>

            <NoRecordsContent>
                <div class="!py-10 text-center text-slate-500">
                    Không có quản trị viên nào.
                </div>
            </NoRecordsContent>

            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 5, 10, 20 }" />
            </PagerContent>
        </MudTable>
    </div>
</div>

@code {
    private string _searchText = string.Empty;
    private int? _statusFilter;

    private List<StaffModel> _staffs = new()
    {
        new()
        {
            Id = 1,
            FullName = "Admin PickleChic",
            Username = "admin",
            Email = "admin@picklechiс.com",
            PhoneNumber = "0900000001",
            PasswordHash = "Admin12345@",
            RoleId = 1,
            Status = 1,
            LastLogin = DateTime.Now.AddHours(-2)
        },
        new()
        {
            Id = 2,
            FullName = "Nguyễn Văn Quản Trị",
            Username = "nguyenadmin",
            Email = "nguyenadmin@gmail.com",
            PhoneNumber = "0900000002",
            PasswordHash = "Admin12345@",
            RoleId = 2,
            Status = 1,
            LastLogin = null
        },
        new()
        {
            Id = 3,
            FullName = "Trần Thị Nhân Viên",
            Username = "transtaff",
            Email = "transtaff@gmail.com",
            PhoneNumber = "0900000003",
            PasswordHash = "Admin12345@",
            RoleId = 2,
            Status = 0,
            LastLogin = null
        }
    };

    private List<StaffModel> FilteredStaffs =>
        _staffs
            .Where(x => string.IsNullOrWhiteSpace(_searchText)
                        || x.Username.Contains(_searchText, StringComparison.OrdinalIgnoreCase)
                        || x.FullName.Contains(_searchText, StringComparison.OrdinalIgnoreCase)
                        || x.Email.Contains(_searchText, StringComparison.OrdinalIgnoreCase)
                        || (x.PhoneNumber?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false))
            .Where(x => !_statusFilter.HasValue || x.Status == _statusFilter.Value)
            .ToList();

    private static string GetRoleName(int roleId)
    {
        return roleId switch
        {
            1 => "Quản trị hệ thống",
            2 => "Nhân viên quản trị",
            3 => "Nhân viên bán hàng",
            _ => "Chưa phân quyền"
        };
    }
}