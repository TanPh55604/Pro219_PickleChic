@attribute [Route(RouterConfig.Admin.Staffs)]
@layout AdminLayout

<PageTitle>@Constant.metaDataAdmin Staffs</PageTitle>

<div class="!space-y-5">
    <div class="flex flex-col !gap-3 md:flex-row md:items-center md:justify-between">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">Quản trị viên</h1>
        </div>

        <a href="@RouterConfig.Admin.CreateStaff"
           class="inline-flex items-center justify-center !gap-2 !rounded-xl !bg-[#A05AFF] !px-4 !py-2.5 text-sm font-semibold !text-white shadow-sm transition hover:!bg-[#8B3FE6]">
            <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
            Thêm quản trị viên
        </a>
    </div>

    <div class="!rounded-2xl !border !border-slate-200 !bg-white !p-5 shadow-sm">
        <div class="!mb-4 flex flex-col !gap-3 md:flex-row md:items-center md:justify-between">
            <div class="flex w-full flex-col !gap-2 md:max-w-xl md:flex-row">
                <MudTextField @bind-Value="_searchText"
                              Placeholder="Tìm kiếm theo tên quản trị viên.."
                              Variant="Variant.Outlined"
                              
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              OnKeyDown="HandleSearchKeyDown"
                              Class="flex-1" />

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Search"
                           OnClick="SearchAsync"
                           Disabled="@_isLoading"
                           Class="!rounded-xl !px-5 !normal-case">
                    Tìm kiếm
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="ResetSearchAsync"
                           Disabled="@_isLoading"
                           Class="!rounded-xl !px-5 !normal-case">
                    Làm mới
                </MudButton>
            </div>
        </div>

        <MudTable Items="_staffs"
                  Loading="@_isLoading"
                  Hover="true"
                  Elevation="0"
                  FixedHeader="true"
                  Height="calc(100vh - 340px)"
                  RowsPerPage="10">
            <HeaderContent>
                <MudTh>STT</MudTh>
                <MudTh>Quản trị viên</MudTh>
                <MudTh>Tên đăng nhập</MudTh>
                <MudTh>Số điện thoại</MudTh>
                <MudTh>Vai trò</MudTh>
                <MudTh>Trạng thái</MudTh>
                <MudTh Class="text-right">Chi tiết</MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd DataLabel="STT">
                    <span class="font-medium text-slate-700">
                        @(_staffs.IndexOf(context) + 1)
                    </span>
                </MudTd>

                <MudTd DataLabel="Quản trị viên">
                    <a href="@RouterConfig.BuildRoute(RouterConfig.Admin.StaffDetail, context.Id)"
                       class="font-semibold text-slate-900 transition hover:text-slate-600">
                        @context.FullName
                    </a>

                    <p class="!mt-1 text-xs text-slate-500">@context.Email</p>
                </MudTd>

                <MudTd DataLabel="Tên đăng nhập">
                    <span class="text-sm font-semibold text-slate-700">
                        @context.UserName
                    </span>
                </MudTd>

                <MudTd DataLabel="Số điện thoại">
                    <span class="text-sm text-slate-700">
                        @(string.IsNullOrWhiteSpace(context.PhoneNumber) ? "Chưa cập nhật" : context.PhoneNumber)
                    </span>
                </MudTd>

                <MudTd DataLabel="Vai trò">
                    <span class="text-sm font-semibold text-slate-700">
                        @GetRoleName(context.RoleId)
                    </span>
                </MudTd>

                <MudTd DataLabel="Trạng thái">
                    @if (context.IsActive)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">
                            Đang hoạt động
                        </MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Text">
                            Tạm khóa
                        </MudChip>
                    }
                </MudTd>

                <MudTd DataLabel="Chi tiết" Class="text-right">
                    <a href="@RouterConfig.BuildRoute(RouterConfig.Admin.StaffDetail, context.Id)"
                       class="inline-flex !h-9 !w-9 items-center justify-center !rounded-lg text-[#4BCBEB] transition hover:!bg-[#4BCBEB]/15 hover:text-[#4BCBEB]">
                        <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
                    </a>
                </MudTd>
            </RowTemplate>

            <NoRecordsContent>
                <div class="!py-10 text-center text-slate-500">
                    Không có quản trị viên nào.
                </div>
            </NoRecordsContent>

            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    </div>
</div>

@code {
    private string _searchText = string.Empty;

    private bool _isLoading = true;

    private List<StaffResponse> _staffs = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadStaffsAsync();
    }

    private async Task LoadStaffsAsync()
    {
        _isLoading = true;

        try
        {
            var result = await _adminStaffService.GetAllAsync(_searchText);

            if (!result.Success)
            {
                _snackbar.Add(ConvertStaffErrorMessage(result.Message), Severity.Error);
                return;
            }

            _staffs = result.Data ?? new();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SearchAsync()
    {
        await LoadStaffsAsync();
    }

    private async Task ResetSearchAsync()
    {
        _searchText = string.Empty;
        await LoadStaffsAsync();
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await SearchAsync();
        }
    }

    private static string GetRoleName(int roleId)
    {
        return roleId switch
        {
            1 => "Quản trị hệ thống",
            2 => "Nhân viên quản trị",
            3 => "Nhân viên bán hàng",
            _ => "Chưa phân quyền"
        };
    }

    private static string ConvertStaffErrorMessage(string message)
    {
        return message switch
        {
            "Db Error" => "Không thể tải danh sách quản trị viên",
            "TokenExpired" => "Phiên đăng nhập đã hết hạn",
            "InvalidToken" => "Phiên đăng nhập không hợp lệ",
            _ => string.IsNullOrWhiteSpace(message)
                ? "Có lỗi xảy ra. Vui lòng thử lại"
                : message
        };
    }
}