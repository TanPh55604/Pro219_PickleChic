@using PickleChic.WEB.DTO.Customer
@using PickleChic.WEB.Model
@using PickleChic.WEB.Schema

<MudForm @ref="_form"
         Model="@Address"
         Validation="@_validator.ValidateValue">
    <div class="!space-y-2">
        <div class="grid !gap-2 sm:grid-cols-2">
            <MudTextField Value="Address.FullName"
                          ValueChanged="@(async (string v) => await OnFullNameChanged(v))"
                          For="@(() => Address.FullName)"
                          Label="Họ tên"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Required="true"
                          Immediate="true" />

            <MudTextField Value="Address.PhoneNumber"
                          ValueChanged="@(async (string v) => await OnPhoneChanged(v))"
                          For="@(() => Address.PhoneNumber)"
                          Label="Số điện thoại"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          MaxLength="10"
                          Required="true"
                          Immediate="true" />
        </div>

        <MudTextField Value="Address.DetailInfo"
                      ValueChanged="@(async (string v) => await OnDetailChanged(v))"
                      For="@(() => Address.DetailInfo)"
                      Label="Địa chỉ chi tiết"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Required="true"
                      Immediate="true" />

        <div class="grid !gap-2 md:grid-cols-3">
            <MudSelect T="int?"
                       Value="Address.ProvinceId"
                       ValueChanged="OnProvinceChangedAsync"
                       For="@(() => Address.ProvinceId)"
                       Label="Tỉnh/TP"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Required="true">
                @foreach (var p in _provinces)
                {
                    <MudSelectItem T="int?" Value="@p.Id">@p.Name</MudSelectItem>
                }
            </MudSelect>

            <MudSelect T="int?"
                       Value="Address.DistrictId"
                       ValueChanged="OnDistrictChangedAsync"
                       For="@(() => Address.DistrictId)"
                       Label="Quận/Huyện"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Required="true"
                       Disabled="@(!Address.ProvinceId.HasValue || !_districts.Any())">
                @foreach (var d in _districts)
                {
                    <MudSelectItem T="int?" Value="@d.Id">@d.Name</MudSelectItem>
                }
            </MudSelect>

            <MudSelect T="int"
                       Value="Address.WardId"
                       ValueChanged="OnWardChangedAsync"
                       For="@(() => Address.WardId)"
                       Label="Phường/Xã"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Required="true"
                       Disabled="@(!Address.DistrictId.HasValue || !_wards.Any())">
                @foreach (var w in _wards)
                {
                    <MudSelectItem Value="@w.Id">@w.Name</MudSelectItem>
                }
            </MudSelect>
        </div>
    </div>
</MudForm>

@code {
    [Parameter, EditorRequired]
    public OfflinePosGuestAddress Address { get; set; } = new();

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private MudForm? _form;
    private readonly OfflinePosGuestAddressSchema.CreateUpdate _validator = new();

    private List<ProvinceResponse> _provinces = new();
    private List<DistrictResponse> _districts = new();
    private List<WardResponse> _wards = new();

    protected override async Task OnInitializedAsync()
    {
        var provinces = await _addressService.GetProvincesAsync();
        if (provinces.Success && provinces.Data is not null)
        {
            _provinces = provinces.Data;
        }

        if (Address.ProvinceId is > 0)
        {
            await LoadDistrictsAsync(Address.ProvinceId.Value);
        }

        if (Address.DistrictId is > 0)
        {
            await LoadWardsAsync(Address.DistrictId.Value);
        }
    }

    public async Task<bool> ValidateAsync()
    {
        if (_form is null)
        {
            return false;
        }

        await _form.ValidateAsync();
        return _form.IsValid;
    }

    private async Task NotifyAsync()
    {
        if (OnChanged.HasDelegate)
        {
            await OnChanged.InvokeAsync();
        }
    }

    private async Task OnFullNameChanged(string value)
    {
        Address.FullName = value ?? string.Empty;
        await NotifyAsync();
    }

    private async Task OnPhoneChanged(string value)
    {
        Address.PhoneNumber = value ?? string.Empty;
        await NotifyAsync();
    }

    private async Task OnDetailChanged(string value)
    {
        Address.DetailInfo = value ?? string.Empty;
        await NotifyAsync();
    }

    private async Task OnProvinceChangedAsync(int? provinceId)
    {
        Address.ProvinceId = provinceId;
        Address.DistrictId = null;
        Address.WardId = 0;
        _districts = new();
        _wards = new();

        if (provinceId is > 0)
        {
            await LoadDistrictsAsync(provinceId.Value);
        }

        await NotifyAsync();
    }

    private async Task OnDistrictChangedAsync(int? districtId)
    {
        Address.DistrictId = districtId;
        Address.WardId = 0;
        _wards = new();

        if (districtId is > 0)
        {
            await LoadWardsAsync(districtId.Value);
        }

        await NotifyAsync();
    }

    private async Task OnWardChangedAsync(int wardId)
    {
        Address.WardId = wardId;
        await NotifyAsync();
    }

    private async Task LoadDistrictsAsync(int provinceId)
    {
        var result = await _addressService.GetDistrictsByProvinceAsync(provinceId);
        _districts = result.Success && result.Data is not null
            ? result.Data
            : new List<DistrictResponse>();
    }

    private async Task LoadWardsAsync(int districtId)
    {
        var result = await _addressService.GetWardsByDistrictAsync(districtId);
        _wards = result.Success && result.Data is not null
            ? result.Data
            : new List<WardResponse>();
    }
}
