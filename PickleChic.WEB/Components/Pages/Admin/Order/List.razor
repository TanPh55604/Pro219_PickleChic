@attribute [Route(RouterConfig.Admin.Orders)]
@layout AdminLayout

<PageTitle>@Constant.metaDataAdmin Hóa đơn</PageTitle>

<div class="!space-y-5">
    <div class="flex flex-col !gap-3 md:flex-row md:items-center md:justify-between">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">Hóa đơn</h1>
            <p class="!mt-1 text-sm text-slate-500">Quản lý danh sách đơn hàng và trạng thái thanh toán</p>
        </div>
    </div>

    <div class="!rounded-2xl !border !border-slate-200 !bg-white !p-5 shadow-sm">
        <div class="!mb-4 flex flex-col !gap-3 md:flex-row md:items-center md:justify-between">
            <div class="flex w-full flex-col !gap-2 xl:flex-row xl:flex-wrap">
                <MudTextField @bind-Value="_searchText"
                              Placeholder="Tìm kiếm theo mã đơn hàng..."
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              OnKeyDown="HandleSearchKeyDown"
                              Class="min-w-[220px] flex-1" />

                <MudSelect T="int"
                           MultiSelection="true"
                           SelectedValues="_statusFilters"
                           SelectedValuesChanged="OnStatusFiltersChanged"
                           MultiSelectionTextFunc="GetStatusMultiSelectionText"
                           Placeholder="Trạng thái đơn"
                           Variant="Variant.Outlined"
                           Clearable="true"
                           Disabled="@_isLoading"
                           Class="md:!min-w-[220px] md:!w-[260px]">
                    <MudSelectItem T="int" Value="@Constant.OrderStatus.Code.Pending">@Constant.OrderStatus.Pending</MudSelectItem>
                    <MudSelectItem T="int" Value="@Constant.OrderStatus.Code.Processing">@Constant.OrderStatus.Processing</MudSelectItem>
                    <MudSelectItem T="int" Value="@Constant.OrderStatus.Code.WaitingForPayment">@Constant.OrderStatus.WaitingForPayment</MudSelectItem>
                    <MudSelectItem T="int" Value="@Constant.OrderStatus.Code.Confirmed">@Constant.OrderStatus.Confirmed</MudSelectItem>
                    <MudSelectItem T="int" Value="@Constant.OrderStatus.Code.Shipping">@Constant.OrderStatus.Shipping</MudSelectItem>
                    <MudSelectItem T="int" Value="@Constant.OrderStatus.Code.AwaitingPickup">@Constant.OrderStatus.AwaitingPickup</MudSelectItem>
                    <MudSelectItem T="int" Value="@Constant.OrderStatus.Code.Done">@Constant.OrderStatus.Done</MudSelectItem>
                    <MudSelectItem T="int" Value="@Constant.OrderStatus.Code.Cancelled">@Constant.OrderStatus.Cancelled</MudSelectItem>
                    <MudSelectItem T="int" Value="@Constant.OrderStatus.Code.Expired">@Constant.OrderStatus.Expired</MudSelectItem>
                </MudSelect>

                <MudSelect T="bool?"
                           @bind-Value="_guestOrderFilter"
                           Placeholder="Loại khách"
                           Variant="Variant.Outlined"
                           Clearable="true"
                           Disabled="@_isLoading"
                           Class="md:!w-[160px]">
                    <MudSelectItem T="bool?" Value="@((bool?)true)">Vãng lai</MudSelectItem>
                    <MudSelectItem T="bool?" Value="@((bool?)false)">Thành viên</MudSelectItem>
                </MudSelect>

                <MudSelect T="bool?"
                           @bind-Value="_isPosFilter"
                           Placeholder="Kênh bán"
                           Variant="Variant.Outlined"
                           Clearable="true"
                           Disabled="@_isLoading"
                           Class="md:!w-[160px]">
                    <MudSelectItem T="bool?" Value="@((bool?)true)">Tại quầy</MudSelectItem>
                    <MudSelectItem T="bool?" Value="@((bool?)false)">Online</MudSelectItem>
                </MudSelect>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Search"
                           OnClick="SearchAsync"
                           Disabled="@_isLoading"
                           Class="!rounded-xl !px-5 !normal-case">
                    Tìm kiếm
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="ResetSearchAsync"
                           Disabled="@_isLoading"
                           Class="!rounded-xl !px-5 !normal-case">
                    Làm mới
                </MudButton>
            </div>
        </div>

        <MudTable Items="_orders"
                  Loading="@_isLoading"
                  Hover="true"
                  Elevation="0"
                  FixedHeader="true"
                  Height="calc(100vh - 360px)"
                  RowsPerPage="10">
            <HeaderContent>
                <MudTh>STT</MudTh>
                <MudTh>Mã đơn</MudTh>
                <MudTh>Khách hàng</MudTh>
                <MudTh>Kênh</MudTh>
                <MudTh>Nhận hàng</MudTh>
                <MudTh>Ngày đặt</MudTh>
                <MudTh>Thanh toán</MudTh>
                <MudTh>Trạng thái đơn</MudTh>
                <MudTh Class="text-right">Chi tiết</MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd DataLabel="STT">
                    <span class="font-medium text-slate-700">
                        @(_orders.IndexOf(context) + 1)
                    </span>
                </MudTd>

                <MudTd DataLabel="Mã đơn">
                    <a href="@RouterConfig.BuildRoute(RouterConfig.Admin.OrderDetail, context.Id)"
                       class="font-semibold text-slate-900 transition hover:text-slate-600">
                        @context.OrderCode
                    </a>
                </MudTd>

                <MudTd DataLabel="Khách hàng">
                    <div class="max-w-[260px] text-sm text-slate-700">
                        <p class="font-medium">
                            @GetCustomerDisplayName(context)
                        </p>
                        @if (IsInStorePickup(context))
                        {
                            var phone = GetCustomerPhone(context);
                            @if (!string.IsNullOrWhiteSpace(phone))
                            {
                                <p class="!mt-0.5 text-slate-400">
                                    @phone
                                </p>
                            }
                        }
                        else
                        {
                            <p class="!mt-0.5 text-slate-400">
                                @FormatAddress(context.Address)
                            </p>
                        }
                    </div>
                </MudTd>

                <MudTd DataLabel="Kênh">
                    <MudChip T="string"
                             Size="Size.Small"
                             Color="@(context.IsOrderPOS ? Color.Secondary : Color.Info)"
                             Variant="Variant.Text">
                        @(context.IsOrderPOS ? "POS" : "Online")
                    </MudChip>
                </MudTd>

                <MudTd DataLabel="Nhận hàng">
                    <span class="text-sm font-medium text-slate-700">
                        @GetFulfillmentLabel(context)
                    </span>
                </MudTd>

                <MudTd DataLabel="Ngày đặt">
                    <span class="text-sm text-slate-600">
                        @context.OrderDate.ToString("dd/MM/yyyy HH:mm")
                    </span>
                </MudTd>

                <MudTd DataLabel="Thanh toán">
                    <MudChip T="string"
                             Size="Size.Small"
                             Color="@GetPaymentStatusColor(context.PaymentStatus)"
                             Variant="Variant.Text">
                        @context.PaymentStatus
                    </MudChip>
                </MudTd>

                <MudTd DataLabel="Trạng thái đơn">
                    <MudChip T="string"
                             Size="Size.Small"
                             Color="@GetOrderStatusColor(context.OrderStatus)"
                             Variant="Variant.Text">
                        @context.OrderStatus
                    </MudChip>
                </MudTd>

                <MudTd DataLabel="Chi tiết" Class="text-right">
                    <a href="@RouterConfig.BuildRoute(RouterConfig.Admin.OrderDetail, context.Id)"
                       class="inline-flex !h-9 !w-9 items-center justify-center !rounded-lg text-[#4BCBEB] transition hover:!bg-[#4BCBEB]/15 hover:text-[#4BCBEB]">
                        <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
                    </a>
                </MudTd>
            </RowTemplate>

            <NoRecordsContent>
                <div class="!py-10 text-center text-slate-500">
                    Không có hóa đơn nào
                </div>
            </NoRecordsContent>

            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 5, 10, 20 }" />
            </PagerContent>
        </MudTable>
    </div>
</div>

@code {
    private string _searchText = string.Empty;

    private IReadOnlyCollection<int> _statusFilters = Array.Empty<int>();
    private bool? _guestOrderFilter;
    private bool? _isPosFilter;

    private bool _isLoading = true;

    private List<OrderResponse> _orders = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadOrdersAsync();
    }

    private async Task LoadOrdersAsync()
    {
        _isLoading = true;

        try
        {
            var statuses = _statusFilters.Count > 0 ? _statusFilters : null;

            var result = await _adminOrderService.GetAllAsync(
                _searchText,
                statuses,
                _guestOrderFilter,
                _isPosFilter);

            if (!result.Success)
            {
                _snackbar.Add(ConvertOrderErrorMessage(result.Message), Severity.Error);
                return;
            }

            _orders = result.Data ?? new();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SearchAsync()
    {
        await LoadOrdersAsync();
    }

    private async Task ResetSearchAsync()
    {
        _searchText = string.Empty;
        _statusFilters = Array.Empty<int>();
        _guestOrderFilter = null;
        _isPosFilter = null;
        await LoadOrdersAsync();
    }

    private void OnStatusFiltersChanged(IEnumerable<int> values)
    {
        _statusFilters = values?.ToArray() ?? Array.Empty<int>();
    }

    private static string GetStatusMultiSelectionText(IReadOnlyList<string> selectedValues)
    {
        if (selectedValues is null || selectedValues.Count == 0)
        {
            return "Trạng thái đơn";
        }

        return selectedValues.Count == 1
            ? selectedValues[0]
            : $"Đã chọn {selectedValues.Count} trạng thái";
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await SearchAsync();
        }
    }

    private static string GetCustomerDisplayName(OrderResponse order)
    {
        if (IsGuestOrder(order))
        {
            return "Vãng lai";
        }

        return order.Customer?.FullName
            ?? order.Address?.FullName
            ?? "—";
    }

    private static string? GetCustomerPhone(OrderResponse order)
    {
        var phone = order.Customer?.PhoneNumber ?? order.Address?.PhoneNumber;
        if (string.IsNullOrWhiteSpace(phone) || phone is "0000000000")
        {
            return null;
        }

        return phone;
    }

    private static bool IsGuestOrder(OrderResponse order)
    {
        if (string.Equals(order.CustomerType, "Guest", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        return order.CustomerId <= 0;
    }

    private static bool IsInStorePickup(OrderResponse order)
    {
        if (order.BOPIS == true)
        {
            return true;
        }

        return order.IsOrderPOS && order.ShippingFee <= 0;
    }

    private static string GetFulfillmentLabel(OrderResponse order)
    {
        if (order.IsOrderPOS)
        {
            return order.ShippingFee > 0 ? "Ship đi" : "Mua trực tiếp";
        }

        return order.BOPIS == true ? "Lấy tại quầy" : "Ship đi";
    }

    private static string FormatAddress(OrderAddressResponse? address)
    {
        if (address is null)
        {
            return "—";
        }

        var ward = address.Ward?.Name;
        var district = address.Ward?.District?.Name;
        var province = address.Ward?.District?.Province?.Name;

        var parts = new[] { address.DetailInfo, ward, district, province }
            .Where(p => !string.IsNullOrWhiteSpace(p));

        var formatted = string.Join(", ", parts);
        return string.IsNullOrWhiteSpace(formatted) ? "—" : formatted;
    }

    private static Color GetOrderStatusColor(string status)
    {
        return status switch
        {
            Constant.OrderStatus.Done => Color.Success,
            Constant.OrderStatus.ShippingDone => Color.Success,
            Constant.OrderStatus.Confirmed => Color.Info,
            Constant.OrderStatus.Shipping => Color.Info,
            Constant.OrderStatus.WaitingForPayment => Color.Warning,
            Constant.OrderStatus.Pending => Color.Warning,
            Constant.OrderStatus.Processing => Color.Warning,
            Constant.OrderStatus.Cancelled => Color.Error,
            Constant.OrderStatus.DeliveryFailed => Color.Error,
            Constant.OrderStatus.Expired => Color.Default,
            _ => Color.Default
        };
    }

    private static Color GetPaymentStatusColor(string status)
    {
        return status switch
        {
            Constant.PaymentStatus.Completed => Color.Success,
            Constant.PaymentStatus.Pending => Color.Warning,
            Constant.PaymentStatus.Cancelled => Color.Error,
            _ => Color.Default
        };
    }

    private static string ConvertOrderErrorMessage(string message)
    {
        return message switch
        {
            "Db Error" => "Không thể tải danh sách hóa đơn",
            "TokenExpired" => "Phiên đăng nhập đã hết hạn",
            "InvalidToken" => "Phiên đăng nhập không hợp lệ",
            _ => string.IsNullOrWhiteSpace(message)
                ? "Có lỗi xảy ra. Vui lòng thử lại"
                : message
        };
    }
}
