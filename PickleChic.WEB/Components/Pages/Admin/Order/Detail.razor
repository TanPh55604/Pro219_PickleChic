@attribute [Route(RouterConfig.Admin.OrderDetail)]
@layout AdminLayout
@using System.Text.Json

<PageTitle>@Constant.metaDataAdmin Chi tiết hóa đơn</PageTitle>

@if (_isLoading)
{
    <DetailPageSkeleton ShowSubtitle="true"
                        ShowDeleteButton="false"
                        InfoFieldCount="6"
                        TableRowCount="3" />
}
else
{
    <div class="mx-auto w-full max-w-7xl !space-y-6">
        <div class="flex flex-col !gap-4 md:flex-row md:items-center md:justify-between">
            <div>
                <h1 class="text-2xl font-bold text-slate-900">Chi tiết hóa đơn</h1>
                <p class="!mt-1 text-sm text-slate-500">Mã đơn: @_model.OrderCode</p>
            </div>

            <div class="flex flex-wrap !gap-3">
                <a href="@RouterConfig.Admin.Orders"
                   class="inline-flex items-center justify-center !gap-2 !rounded-xl !border !border-slate-200 !bg-white !px-5 !py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:!bg-slate-50">
                    <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" />
                    Quay lại
                </a>

                @if (ShouldShowButtons())
                {
                    @if (IsPendingGroup(CurrentStatus))
                    {
                        <MudButton Variant="Variant.Filled"
                                   Disabled="@_isUpdateStatus"
                                   Color="Color.Error"
                                   OnClick="HandleCancelOrderAsync"
                                   Class="!rounded-xl !normal-case">
                            Hủy
                        </MudButton>
                        <MudButton Variant="Variant.Filled"
                                   Disabled="@_isUpdateStatus"
                                   Color="Color.Primary"
                                   OnClick="@(() => HandleStatusUpdateAsync(CurrentStatus, "success"))"
                                   Class="!rounded-xl !normal-case">
                            Xác nhận
                        </MudButton>
                    }
                    else if (CurrentStatus == Constant.OrderStatus.Code.Confirmed)
                    {
                        @if (_model.BOPIS == true)
                        {
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Disabled="@_isUpdateStatus"
                                       OnClick="@(() => HandleStatusUpdateAsync(Constant.OrderStatus.Code.Confirmed))"
                                       Class="!rounded-xl !normal-case">
                                Chờ khách tới lấy
                            </MudButton>
                        }
                        else if (_model.IsOrderPOS && _model.ShippingFee <= 0)
                        {
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Success"
                                       Disabled="@_isUpdateStatus"
                                       OnClick="@(() => HandleStatusUpdateAsync(Constant.OrderStatus.Code.Confirmed))"
                                       Class="!rounded-xl !normal-case">
                                Hoàn thành
                            </MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Disabled="@_isUpdateStatus"
                                       OnClick="@(() => HandleStatusUpdateAsync(Constant.OrderStatus.Code.Confirmed))"
                                       Class="!rounded-xl !normal-case">
                                Giao cho đơn vị vận chuyển
                            </MudButton>
                        }
                    }
                    else if (CurrentStatus == Constant.OrderStatus.Code.Shipping)
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Success"
                                   Disabled="@_isUpdateStatus"
                                   OnClick="@(() => HandleStatusUpdateAsync(Constant.OrderStatus.Code.Shipping, "success"))"
                                   Class="!rounded-xl !normal-case">
                            Giao thành công
                        </MudButton>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Error"
                                   Disabled="@_isUpdateStatus"
                                   OnClick="@(() => HandleStatusUpdateAsync(Constant.OrderStatus.Code.Shipping, "failed"))"
                                   Class="!rounded-xl !normal-case">
                            Giao thất bại
                        </MudButton>
                    }
                    else if (CurrentStatus == Constant.OrderStatus.Code.AwaitingPickup)
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Success"
                                   Disabled="@_isUpdateStatus"
                                   OnClick="@(() => HandleStatusUpdateAsync(Constant.OrderStatus.Code.AwaitingPickup))"
                                   Class="!rounded-xl !normal-case">
                            Hoàn thành
                        </MudButton>
                    }
                }
            </div>
        </div>

        <div class="grid !gap-6 xl:grid-cols-3">
            <div class="!space-y-6 xl:col-span-2">
                <div class="!rounded-2xl !border !border-slate-200 !bg-white shadow-sm">
                    <div class="!border-b !border-slate-200 !p-6">
                        <div class="flex flex-col !gap-4 md:flex-row md:items-center md:justify-between">
                            <div>
                                <h2 class="text-xl font-bold text-slate-900">@_model.OrderCode</h2>
                                <p class="!mt-1 text-sm text-slate-500">
                                    Đặt lúc @_model.OrderDate.ToString("dd/MM/yyyy HH:mm")
                                </p>
                            </div>

                            <div class="flex flex-wrap !gap-2">
                                <MudChip T="string"
                                         Size="Size.Small"
                                         Color="@GetOrderStatusColor(CurrentStatus)"
                                         Variant="Variant.Filled">
                                    @Constant.OrderStatus.GetLabel(CurrentStatus)
                                </MudChip>
                                <MudChip T="string"
                                         Size="Size.Small"
                                         Color="@GetPaymentStatusColor(_model.PaymentStatus)"
                                         Variant="Variant.Filled">
                                    @_model.PaymentStatus
                                </MudChip>
                            </div>
                        </div>
                    </div>

                    <div class="!p-6">
                        <h3 class="text-lg font-bold text-slate-900">Sản phẩm</h3>

                        <div class="!mt-4 overflow-x-auto">
                            <table class="w-full min-w-[640px] text-left text-sm">
                                <thead>
                                    <tr class="!border-b !border-slate-200 text-slate-500">
                                        <th class="!pb-3 font-semibold">Sản phẩm</th>
                                        <th class="!pb-3 font-semibold">SKU</th>
                                        <th class="!pb-3 text-right font-semibold">Đơn giá</th>
                                        <th class="!pb-3 text-center font-semibold">SL</th>
                                        <th class="!pb-3 text-right font-semibold">Giảm</th>
                                        <th class="!pb-3 text-right font-semibold">Thành tiền</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in _model.OrderItems)
                                    {
                                        <tr class="!border-b !border-slate-100">
                                            <td class="!py-3">
                                                <p class="font-medium text-slate-900">
                                                    @(item.ProductVariant?.Product?.ProductName ?? $"Biến thể #{item.ProductVariantId}")
                                                </p>
                                                @if (!string.IsNullOrWhiteSpace(item.ProductVariant?.VariantName))
                                                {
                                                    <p class="text-slate-500">@item.ProductVariant.VariantName</p>
                                                }
                                            </td>
                                            <td class="!py-3">
                                                <span class="font-bold text-slate-800">@(item.ProductVariant?.SKU ?? "—")</span>
                                            </td>
                                            <td class="!py-3 text-right text-slate-700">
                                                @item.UnitPrice.ToString("N0")đ
                                            </td>
                                            <td class="!py-3 text-center text-slate-700">
                                                @item.Quantity
                                            </td>
                                            <td class="!py-3 text-right text-slate-500">
                                                @(item.DiscountAmount > 0 ? $"{item.DiscountAmount:N0}đ" : "—")
                                            </td>
                                            <td class="!py-3 text-right font-semibold text-slate-900">
                                                @item.Subtotal.ToString("N0")đ
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="!mt-6 flex flex-col items-end !gap-2 text-sm">
                            <div class="flex w-full max-w-xs justify-between text-slate-600">
                                <span>Tạm tính</span>
                                <span>@_model.ItemsTotal.ToString("N0")đ</span>
                            </div>
                            @if (_model.VoucherDiscountAmount > 0)
                            {
                                <div class="flex w-full max-w-xs justify-between text-slate-600">
                                    <span>Giảm voucher</span>
                                    <span class="text-rose-600">-@_model.VoucherDiscountAmount.ToString("N0")đ</span>
                                </div>
                            }
                            @if (_model.PointsDiscountAmount > 0)
                            {
                                <div class="flex w-full max-w-xs justify-between text-slate-600">
                                    <span>Giảm điểm thưởng</span>
                                    <span class="text-rose-600">-@_model.PointsDiscountAmount.ToString("N0")đ</span>
                                </div>
                            }
                            <div class="flex w-full max-w-xs justify-between text-slate-600">
                                <span>Phí vận chuyển</span>
                                <span>@_model.ShippingFee.ToString("N0")đ</span>
                            </div>
                            <div class="flex w-full max-w-xs justify-between !border-t !border-slate-200 !pt-2 text-base font-bold text-slate-900">
                                <span>Tổng cộng</span>
                                <span>@_model.GrandTotal.ToString("N0")đ</span>
                            </div>
                        </div>
                    </div>
                </div>

                @if (_statusHistory.Count > 0)
                {
                    <div class="!rounded-2xl !border !border-slate-200 !bg-white !p-6 shadow-sm">
                        <h3 class="text-lg font-bold text-slate-900">Lịch sử trạng thái</h3>

                        <div class="!mt-4 !space-y-3">
                            @foreach (var entry in _statusHistory.OrderByDescending(e => e.Index))
                            {
                                <div class="flex flex-col !gap-1 !rounded-xl !bg-slate-50 !p-4 md:flex-row md:items-start md:justify-between">
                                    <div class="!space-y-1">
                                        <p class="font-semibold text-slate-900">@entry.OrderStatus</p>
                                        <p class="text-sm text-slate-500">Thanh toán: @entry.PaymentStatus</p>
                                        @if (!string.IsNullOrWhiteSpace(entry.UpdatedBy))
                                        {
                                            <p class="text-sm text-slate-500">Cập nhật bởi: @entry.UpdatedBy</p>
                                        }
                                        @if (ShouldShowCancelReason(entry) && !string.IsNullOrWhiteSpace(entry.Reasons))
                                        {
                                            <p class="text-sm text-slate-700">
                                                <span class="font-medium text-slate-500">Lý do:</span>
                                                @entry.Reasons
                                            </p>
                                        }
                                    </div>
                                    <span class="shrink-0 text-sm text-slate-400">@entry.DateTime</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="!space-y-6">
                <div class="!rounded-2xl !border !border-slate-200 !bg-white !p-6 shadow-sm">
                    <h3 class="text-lg font-bold text-slate-900">Khách hàng</h3>

                    <div class="!mt-4 !space-y-3 text-sm">
                        <div>
                            <p class="text-slate-500">Họ tên</p>
                            <p class="font-semibold text-slate-900">
                                @(IsGuestCustomer ? "Khách vãng lai" : (_model.Customer?.FullName ?? "—"))
                            </p>
                        </div>
                        @if (!IsGuestCustomer)
                        {
                            <div>
                                <p class="text-slate-500">Email</p>
                                <p class="font-semibold text-slate-900">@(_model.Customer?.Email ?? "—")</p>
                            </div>
                            <div>
                                <p class="text-slate-500">Số điện thoại</p>
                                <p class="font-semibold text-slate-900">@(_model.Customer?.PhoneNumber ?? _model.Address?.PhoneNumber ?? "—")</p>
                            </div>
                        }
                    </div>
                </div>

                <div class="!rounded-2xl !border !border-slate-200 !bg-white !p-6 shadow-sm">
                    <h3 class="text-lg font-bold text-slate-900">
                        @(IsInStoreFulfillment ? "Nhận hàng" : "Giao hàng")
                    </h3>

                    <div class="!mt-4 !space-y-3 text-sm">
                        @if (IsInStoreFulfillment)
                        {
                            <div>
                                <p class="text-slate-500">Hình thức</p>
                                <p class="font-semibold text-slate-900">
                                    @(_model.BOPIS == true ? "Lấy tại quầy" : "Mua tại quầy")
                                </p>
                            </div>
                            @if (!IsGuestCustomer
                                 && (!string.IsNullOrWhiteSpace(_model.Customer?.PhoneNumber)
                                     || !string.IsNullOrWhiteSpace(_model.Address?.PhoneNumber)))
                            {
                                <div>
                                    <p class="text-slate-500">Số điện thoại liên hệ</p>
                                    <p class="font-semibold text-slate-900">
                                        @(_model.Customer?.PhoneNumber ?? _model.Address?.PhoneNumber)
                                    </p>
                                </div>
                            }
                        }
                        else
                        {
                            <div>
                                <p class="text-slate-500">Người nhận</p>
                                <p class="font-semibold text-slate-900">@(_model.Address?.FullName ?? "—")</p>
                            </div>
                            <div>
                                <p class="text-slate-500">Số điện thoại</p>
                                <p class="font-semibold text-slate-900">@(_model.Address?.PhoneNumber ?? "—")</p>
                            </div>
                            <div>
                                <p class="text-slate-500">Địa chỉ</p>
                                <p class="font-semibold text-slate-900">@FormatAddress(_model.Address)</p>
                            </div>
                        }
                    </div>
                </div>

                <div class="!rounded-2xl !border !border-slate-200 !bg-white !p-6 shadow-sm">
                    <h3 class="text-lg font-bold text-slate-900">Thanh toán</h3>

                    <div class="!mt-4 !space-y-3 text-sm">
                        <div>
                            <p class="text-slate-500">Phương thức</p>
                            <p class="font-semibold text-slate-900">@(_model.PaymentMethod?.Name ?? "—")</p>
                        </div>
                        @if (_model.Voucher is not null)
                        {
                            <div>
                                <p class="text-slate-500">Voucher</p>
                                <p class="font-semibold text-slate-900">@_model.Voucher.VoucherCode</p>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(_model.Notes))
                        {
                            <div>
                                <p class="text-slate-500">Ghi chú</p>
                                <p class="font-semibold text-slate-900">@_model.Notes</p>
                            </div>
                        }
                        @if (_model.LastUpdate.HasValue)
                        {
                            <div>
                                <p class="text-slate-500">Cập nhật lần cuối</p>
                                <p class="font-semibold text-slate-900">
                                    @_model.LastUpdate.Value.ToString("dd/MM/yyyy HH:mm")
                                    @if (!string.IsNullOrWhiteSpace(_model.UpdateBy))
                                    {
                                        <span class="text-slate-500"> · @_model.UpdateBy</span>
                                    }
                                </p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private static readonly JsonSerializerOptions _jsonOptions = new()
    {
        PropertyNameCaseInsensitive = true
    };

    private OrderResponse _model = new();

    private List<StatusHistoryEntryResponse> _statusHistory = new();

    private bool _isLoading = true;

    private bool _isUpdateStatus;

    private int CurrentStatus =>
        _model.Status
        ?? Constant.OrderStatus.ToCode(_model.OrderStatus)
        ?? 0;

    private bool IsInStoreFulfillment =>
        _model.BOPIS == true
        || (_model.IsOrderPOS && _model.ShippingFee <= 0);

    private bool IsGuestCustomer =>
        string.Equals(_model.CustomerType, "Guest", StringComparison.OrdinalIgnoreCase)
        || _model.CustomerId == -1
        || string.Equals(_model.Customer?.Email, "guest@example.com", StringComparison.OrdinalIgnoreCase)
        || string.Equals(_model.Customer?.FullName, "Khách vãng lai", StringComparison.OrdinalIgnoreCase)
        || string.Equals(_model.Customer?.FullName, "guest", StringComparison.OrdinalIgnoreCase)
        || string.Equals(_model.Address?.FullName, "Khách vãng lai", StringComparison.OrdinalIgnoreCase);

    private bool IsGuestInStoreOrder => IsInStoreFulfillment && IsGuestCustomer;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrderAsync();
    }

    private async Task LoadOrderAsync()
    {
        _isLoading = true;

        try
        {
            var result = await _adminOrderService.GetByIdAsync(Id);

            if (!result.Success || result.Data is null)
            {
                _snackbar.Add(ConvertOrderErrorMessage(result.Message), Severity.Error);
                _navigation.NavigateTo(RouterConfig.Admin.Orders, replace: true);
                return;
            }

            _model = result.Data;
            _statusHistory = ParseStatusHistory(_model.StatusHistory);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private bool ShouldShowButtons()
    {
        return !Constant.OrderStatus.TerminalCodes.Contains(CurrentStatus);
    }

    private static bool IsPendingGroup(int status) => Constant.OrderStatus.IsPendingGroup(status);

    private static bool IsCashOrder(OrderResponse order)
    {
        if (order.PaymentMethodId == Constant.PaymentMethodType.Cash)
        {
            return true;
        }

        var methodName = order.PaymentMethod?.Name;

        return !string.IsNullOrWhiteSpace(methodName)
               && (methodName.Contains("tiền mặt", StringComparison.OrdinalIgnoreCase)
                   || methodName.Contains("cod", StringComparison.OrdinalIgnoreCase)
                   || methodName.Contains("khi nhận hàng", StringComparison.OrdinalIgnoreCase));
    }

    private async Task HandleStatusUpdateAsync(int expectedStatus, string? outcome = null)
    {
        if (CurrentStatus != expectedStatus)
        {
            _snackbar.Add("Trạng thái đơn đã thay đổi, vui lòng tải lại trang", Severity.Warning);
            return;
        }

        var (nextStatus, nextPaymentStatus) = ResolveNextStatus(expectedStatus, outcome);
        await SubmitStatusUpdateAsync(nextStatus, nextPaymentStatus);
    }

    private async Task HandleCancelOrderAsync()
    {
        if (!IsPendingGroup(CurrentStatus))
        {
            _snackbar.Add("Trạng thái đơn đã thay đổi, vui lòng tải lại trang", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters<OrderCancelDialog>
        {
            { x => x.OrderCode, _model.OrderCode },
            { x => x.ReasonOptions, Constant.OrderCancelReason.Admin }
            // TODO: hoàn trả số lượng tồn kho khi hủy đơn (chưa làm)
            // { x => x.ShowRestoreStockOption, true }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialog = await _dialogService.ShowAsync<OrderCancelDialog>(
            "Hủy đơn hàng",
            parameters,
            options);

        var dialogResult = await dialog.Result;
        if (dialogResult is null || dialogResult.Canceled || dialogResult.Data is not CancelOrderDialogResult cancelData)
        {
            return;
        }

        var reasons = Constant.OrderCancelReason.Format(cancelData.CancelReason, cancelData.CancelDetail);
        var (nextStatus, nextPaymentStatus) = ResolveNextStatus(CurrentStatus, "failed");

        // TODO: hoàn trả số lượng tồn kho khi hủy đơn (chưa làm)
        // bool restoreStock = cancelData.RestoreStock;

        await SubmitStatusUpdateAsync(nextStatus, nextPaymentStatus, reasons);
    }

    private (int Status, string PaymentStatus) ResolveNextStatus(int currentStatus, string? outcome)
    {
        if (IsPendingGroup(currentStatus))
        {
            if (outcome == "failed")
            {
                return (Constant.OrderStatus.Code.Cancelled, Constant.PaymentStatus.Cancelled);
            }

            var paymentStatus = IsCashOrder(_model)
                ? Constant.PaymentStatus.Pending
                : Constant.PaymentStatus.Completed;

            return (Constant.OrderStatus.Code.Confirmed, paymentStatus);
        }

        if (currentStatus == Constant.OrderStatus.Code.Confirmed)
        {
            if (_model.BOPIS == true)
            {
                return (Constant.OrderStatus.Code.AwaitingPickup, _model.PaymentStatus);
            }

            if (_model.IsOrderPOS && _model.ShippingFee <= 0)
            {
                return (Constant.OrderStatus.Code.Done, Constant.PaymentStatus.Completed);
            }

            return (Constant.OrderStatus.Code.Shipping, _model.PaymentStatus);
        }

        if (currentStatus == Constant.OrderStatus.Code.Shipping)
        {
            if (outcome == "failed")
            {
                return (Constant.OrderStatus.Code.Cancelled, _model.PaymentStatus);
            }

            var paymentStatus = IsCashOrder(_model)
                ? Constant.PaymentStatus.Completed
                : _model.PaymentStatus;

            return (Constant.OrderStatus.Code.Done, paymentStatus);
        }

        if (currentStatus == Constant.OrderStatus.Code.AwaitingPickup)
        {
            return (Constant.OrderStatus.Code.Done, Constant.PaymentStatus.Completed);
        }

        return (CurrentStatus, _model.PaymentStatus);
    }

    private async Task SubmitStatusUpdateAsync(int nextStatus, string paymentStatus, string? reasons = null)
    {
        var nextOrderStatusLabel = Constant.OrderStatus.GetLabel(nextStatus);

        if (nextStatus == CurrentStatus && paymentStatus == _model.PaymentStatus)
        {
            _snackbar.Add("Trạng thái không thay đổi", Severity.Info);
            return;
        }

        _isUpdateStatus = true;

        try
        {
            var userResult = await _currentUserService.CheckCurrentUserAsync();
            var updateBy = userResult.Success && userResult.Data is not null
                ? userResult.Data.FullName
                : "Admin";

            var request = new OrderStatusUpdateRequest
            {
                OrderStatus = nextOrderStatusLabel,
                PaymentStatus = paymentStatus,
                UpdateBy = updateBy,
                Reasons = reasons
                // TODO: hoàn trả số lượng tồn kho khi hủy đơn (chưa làm)
                // RestoreStock = restoreStock
            };

            var result = await _adminOrderService.UpdateStatusAsync(Id, request);

            if (!result.Success || result.Data is null)
            {
                _snackbar.Add(ConvertOrderErrorMessage(result.Message), Severity.Error);
                return;
            }

            _model = result.Data;
            _statusHistory = ParseStatusHistory(_model.StatusHistory);

            _snackbar.Add("Cập nhật trạng thái thành công", Severity.Success);
        }
        finally
        {
            _isUpdateStatus = false;
        }
    }

    private static List<StatusHistoryEntryResponse> ParseStatusHistory(string? json)
    {
        if (string.IsNullOrWhiteSpace(json))
        {
            return new List<StatusHistoryEntryResponse>();
        }

        try
        {
            return JsonSerializer.Deserialize<List<StatusHistoryEntryResponse>>(json, _jsonOptions)
                ?? new List<StatusHistoryEntryResponse>();
        }
        catch
        {
            return new List<StatusHistoryEntryResponse>();
        }
    }

    private static bool ShouldShowCancelReason(StatusHistoryEntryResponse entry)
    {
        // DATN cũ: StatusCanceledByUser = 3 → tương đương trạng thái hủy ở PickleChic
        var status = string.IsNullOrWhiteSpace(entry.OrderStatus) ? entry.Status : entry.OrderStatus;
        return status is Constant.OrderStatus.Cancelled
            or "Đã hủy"
            or "Cancelled"
            or "Đã hủy bởi người dùng";
    }

    private static string FormatAddress(OrderAddressResponse? address)
    {
        if (address is null)
        {
            return "—";
        }

        var ward = address.Ward?.Name;
        var district = address.Ward?.District?.Name;
        var province = address.Ward?.District?.Province?.Name;

        var parts = new[] { address.DetailInfo, ward, district, province }
            .Where(p => !string.IsNullOrWhiteSpace(p));

        return string.Join(", ", parts);
    }

    private static Color GetOrderStatusColor(int status)
    {
        return status switch
        {
            Constant.OrderStatus.Code.Done => Color.Success,
            Constant.OrderStatus.Code.Confirmed => Color.Info,
            Constant.OrderStatus.Code.Shipping => Color.Info,
            Constant.OrderStatus.Code.AwaitingPickup => Color.Info,
            Constant.OrderStatus.Code.WaitingForPayment => Color.Warning,
            Constant.OrderStatus.Code.Pending => Color.Warning,
            Constant.OrderStatus.Code.Processing => Color.Warning,
            Constant.OrderStatus.Code.Cancelled => Color.Error,
            Constant.OrderStatus.Code.Expired => Color.Default,
            _ => Color.Default
        };
    }

    private static Color GetPaymentStatusColor(string status)
    {
        return status switch
        {
            Constant.PaymentStatus.Completed => Color.Success,
            Constant.PaymentStatus.Pending => Color.Warning,
            Constant.PaymentStatus.Cancelled => Color.Error,
            _ => Color.Default
        };
    }

    private static string ConvertOrderErrorMessage(string message)
    {
        return message switch
        {
            "Đơn hàng không tồn tại" => "Không tìm thấy hóa đơn",
            "Không thể cập nhật trạng thái đơn hàng" => "Không thể cập nhật trạng thái",
            "Db Error" => "Không thể xử lý dữ liệu hóa đơn",
            "TokenExpired" => "Phiên đăng nhập đã hết hạn",
            "InvalidToken" => "Phiên đăng nhập không hợp lệ",
            _ => string.IsNullOrWhiteSpace(message)
                ? "Có lỗi xảy ra. Vui lòng thử lại"
                : message
        };
    }
}
