@attribute [Route(RouterConfig.Customer.CategoryDetail)]
@layout MainLayout

<PageTitle>@Constant.metaDataCustomer @GetPageTitle()</PageTitle>

<div class="min-h-[calc(100vh-180px)] bg-neutral-50 !px-4 !pt-8 !pb-14">
    <div class="!mx-auto w-full max-w-7xl">
        <div class="!space-y-6">
            @if (_isLoadingHeader)
            {
                <div class="!space-y-3">
                    <MudSkeleton Width="140px" Height="16px" />
                    <MudSkeleton Width="320px" Height="40px" />
                    <MudSkeleton Width="480px" Height="20px" />
                </div>
            }
            else if (_category is null)
            {
                <div class="!rounded-3xl border border-neutral-200 bg-white !p-12 text-center shadow-sm">
                    <h1 class="text-2xl font-black text-neutral-950">Không tìm thấy danh mục</h1>
                    <a href="@RouterConfig.Customer.Search"
                       class="!mt-6 inline-flex items-center justify-center !rounded-full !bg-black !px-6 !py-3 text-sm font-black !text-white transition hover:!bg-[#d71920]">
                        Xem tất cả sản phẩm
                    </a>
                </div>
            }
            else
            {
                <div>
                    <p class="text-xs font-black tracking-[0.28em] text-[#d71920] uppercase">
                        Danh mục
                    </p>

                    <h1 class="!mt-2 text-3xl font-black tracking-tight text-neutral-950 sm:text-4xl">
                        @_category.Name
                    </h1>

                    @if (!string.IsNullOrWhiteSpace(_category.Description))
                    {
                        <p class="!mt-3 max-w-3xl text-sm leading-7 text-neutral-600">
                            @_category.Description
                        </p>
                    }
                </div>

                @if (_isLoadingProducts)
                {
                    <ProductListSkeleton Count="@_pageSize" />
                }
                else
                {
                    <div class="flex w-full flex-col !gap-3 sm:!flex-row sm:!items-center sm:!justify-between">
                        <p class="text-sm font-bold text-neutral-600">
                            @GetResultSummary()
                        </p>

                        <div class="flex w-full flex-col !gap-3 sm:w-auto sm:!flex-row sm:!items-center">
                            <div class="w-full sm:w-32">
                                <MudSelect T="int"
                                           Value="_pageSize"
                                           ValueChanged="OnPageSizeChanged"
                                           Label="Hiển thị"
                                           Variant="Variant.Outlined"
                                           Dense="true"
                                           Class="w-full">
                                    @foreach (var size in ProductSearchDefaults.PageSizeOptions)
                                    {
                                        <MudSelectItem T="int" Value="@size">@size</MudSelectItem>
                                    }
                                </MudSelect>
                            </div>

                            <div class="w-full sm:w-60">
                                <MudSelect T="string?"
                                           Value="_sortBy"
                                           ValueChanged="OnSortChanged"
                                           Label="Sắp xếp"
                                           Variant="Variant.Outlined"
                                           Dense="true"
                                           Clearable="true"
                                           Class="w-full">
                                    <MudSelectItem T="string?" Value="@ProductSearchSort.NameAsc">Tên A → Z</MudSelectItem>
                                    <MudSelectItem T="string?" Value="@ProductSearchSort.NameDesc">Tên Z → A</MudSelectItem>
                                    <MudSelectItem T="string?" Value="@ProductSearchSort.PriceAsc">Giá thấp → cao</MudSelectItem>
                                    <MudSelectItem T="string?" Value="@ProductSearchSort.PriceDesc">Giá cao → thấp</MudSelectItem>
                                </MudSelect>
                            </div>
                        </div>
                    </div>

                    @if (!_products.Any())
                    {
                        <div class="!rounded-3xl border border-neutral-200 bg-white !p-12 text-center shadow-sm">
                            <h2 class="text-2xl font-black text-neutral-950">Chưa có sản phẩm</h2>
                            <p class="!mt-2 text-sm text-neutral-500">Danh mục này hiện chưa có sản phẩm phù hợp.</p>
                        </div>
                    }
                    else
                    {
                        <div class="grid !gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
                            @foreach (var product in _products)
                            {
                                <CustomerProductCard Item="@ProductCardModel.FromVariant(product)" />
                            }
                        </div>
                    }

                    @if (ShowPagination)
                    {
                        <div class="flex flex-col items-center !gap-3 sm:flex-row sm:justify-center">
                            <button type="button"
                                    @onclick="() => GoToPage(_pageNumber - 1)"
                                    disabled="@(!HasPreviousPage)"
                                    class="inline-flex items-center justify-center !gap-2 !rounded-full !border !border-neutral-300 !bg-white !px-5 !py-2.5 text-sm font-black text-neutral-900 transition disabled:cursor-not-allowed disabled:opacity-40 enabled:hover:!border-[#d71920] enabled:hover:!text-[#d71920]">
                                <MudIcon Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" />
                                Trước
                            </button>

                            <span class="text-sm font-bold text-neutral-600">
                                Trang @_pageNumber/@_totalPages
                            </span>

                            <button type="button"
                                    @onclick="() => GoToPage(_pageNumber + 1)"
                                    disabled="@(!HasNextPage)"
                                    class="inline-flex items-center justify-center !gap-2 !rounded-full !border !border-neutral-300 !bg-white !px-5 !py-2.5 text-sm font-black text-neutral-900 transition enabled:hover:!border-[#d71920] enabled:hover:!text-[#d71920] disabled:cursor-not-allowed disabled:opacity-40">
                                Sau
                                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
                            </button>
                        </div>
                    }
                }
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    [SupplyParameterFromQuery(Name = "sort")]
    public string? Sort { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int? Page { get; set; }

    [SupplyParameterFromQuery(Name = "pageSize")]
    public int? PageSize { get; set; }

    private CustomerCategoryResponse? _category;

    private string? _sortBy;

    private int _pageNumber = ProductSearchDefaults.DefaultPageNumber;

    private int _pageSize = ProductSearchDefaults.DefaultPageSize;

    private bool _isLoadingHeader = true;

    private bool _isLoadingProducts;

    private int _totalCount;

    private int _totalPages;

    private List<ProductVariantSearchResponse> _products = new();

    private bool HasPreviousPage => _pageNumber > 1;

    private bool HasNextPage => _pageNumber < _totalPages;

    private bool ShowPagination => _totalPages > 1;

    protected override async Task OnParametersSetAsync()
    {
        _sortBy = Sort;
        _pageNumber = Page.GetValueOrDefault(ProductSearchDefaults.DefaultPageNumber);

        if (_pageNumber < 1)
        {
            _pageNumber = ProductSearchDefaults.DefaultPageNumber;
        }

        _pageSize = ResolvePageSize(PageSize);

        await LoadPageAsync();
    }

    private static int ResolvePageSize(int? pageSize)
    {
        if (!pageSize.HasValue)
        {
            return ProductSearchDefaults.DefaultPageSize;
        }

        return ProductSearchDefaults.PageSizeOptions.Contains(pageSize.Value)
            ? pageSize.Value
            : ProductSearchDefaults.DefaultPageSize;
    }

    private async Task LoadPageAsync()
    {
        _isLoadingHeader = true;
        _isLoadingProducts = true;
        StateHasChanged();

        try
        {
            var categoryResult = await _customerCategoryService.GetByIdAsync(Id);

            if (!categoryResult.Success || categoryResult.Data is null)
            {
                _category = null;
                _products = new();
                _totalCount = 0;
                _totalPages = 0;
                return;
            }

            _category = categoryResult.Data;

            var query = new ProductSearchQuery
            {
                CategoryId = Id,
                SortBy = Sort,
                PageNumber = _pageNumber,
                PageSize = _pageSize
            };

            var result = await _productService.SearchAsync(query);

            if (!result.Success || result.Data is null)
            {
                _snackbar.Add(ConvertErrorMessage(result.Message), Severity.Error);
                _products = new();
                _totalCount = 0;
                _totalPages = 0;
                return;
            }

            var data = result.Data;
            _totalCount = data.TotalCount;
            _totalPages = data.TotalCount <= 0
                ? 0
                : (int)Math.Ceiling(data.TotalCount / (double)_pageSize);

            if (_totalPages > 0 && _pageNumber > _totalPages)
            {
                Navigate(pageNumber: _totalPages);
                return;
            }

            _products = data.Items ?? new();
        }
        finally
        {
            _isLoadingHeader = false;
            _isLoadingProducts = false;
        }
    }

    private string GetPageTitle() => _category?.Name ?? "Danh mục";

    private string GetResultSummary()
    {
        if (_totalCount == 0)
        {
            return "0 sản phẩm";
        }

        if (_totalPages <= 1)
        {
            return $"{_totalCount} sản phẩm";
        }

        return $"{_totalCount} sản phẩm · Trang {_pageNumber}/{_totalPages}";
    }

    private void OnSortChanged(string? newSort)
    {
        _sortBy = newSort;
        Navigate(sortBy: newSort, pageNumber: ProductSearchDefaults.DefaultPageNumber, replaceSort: true);
    }

    private void OnPageSizeChanged(int newPageSize)
    {
        Navigate(pageNumber: ProductSearchDefaults.DefaultPageNumber, pageSize: newPageSize);
    }

    private void GoToPage(int pageNumber)
    {
        if (pageNumber < 1 || pageNumber > _totalPages || pageNumber == _pageNumber)
        {
            return;
        }

        Navigate(pageNumber: pageNumber);
    }

    private void Navigate(
        string? sortBy = null,
        int? pageNumber = null,
        int? pageSize = null,
        bool replaceSort = false)
    {
        var resolvedSort = replaceSort ? sortBy : sortBy ?? Sort;

        var url = RouterConfig.BuildCategoryUrl(
            Id,
            sortBy: string.IsNullOrWhiteSpace(resolvedSort) ? null : resolvedSort,
            pageNumber: pageNumber ?? _pageNumber,
            pageSize: pageSize ?? _pageSize);

        _navigation.NavigateTo(url);
    }

    private static string ConvertErrorMessage(string message)
    {
        return message switch
        {
            "Db Error" => "Không thể tải danh sách sản phẩm",
            _ => string.IsNullOrWhiteSpace(message)
                ? "Có lỗi xảy ra. Vui lòng thử lại"
                : message
        };
    }
}
