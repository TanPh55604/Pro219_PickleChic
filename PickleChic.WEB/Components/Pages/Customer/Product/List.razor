@attribute [Route(RouterConfig.Customer.Products)]
@layout MainLayout

<PageTitle>@Constant.metaDataCustomer Sản phẩm</PageTitle>

<div class="min-h-[calc(100vh-180px)] bg-neutral-50 !px-4 !pt-8 !pb-14">
    <div class="!mx-auto w-full max-w-7xl !space-y-14">
        <div>
            <p class="text-xs font-black tracking-[0.28em] text-[#d71920] uppercase">
                PickleChic Store
            </p>

            <h1 class="!mt-2 text-3xl font-black tracking-tight text-neutral-950 sm:text-4xl">
                Sản phẩm
            </h1>
        </div>

        <section>
            <div class="flex items-end justify-between !gap-4">
                <div>
                    <h2 class="text-2xl font-black text-neutral-950">
                        Danh mục
                    </h2>

                    <p class="!mt-1 text-sm text-neutral-500">
                        Khám phá theo loại sản phẩm
                    </p>
                </div>
            </div>

            @if (_isLoading)
            {
                <div class="!mt-6 grid grid-cols-2 !gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6">
                    @for (var i = 0; i < 6; i++)
                    {
                        <div class="aspect-square overflow-hidden !rounded-2xl bg-white shadow-sm">
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="100%" Width="100%" />
                        </div>
                    }
                </div>
            }
            else if (!_categories.Any())
            {
                <div class="!mt-6 !rounded-3xl border border-neutral-200 bg-white !p-10 text-center shadow-sm">
                    <p class="text-sm font-semibold text-neutral-500">Chưa có danh mục nào.</p>
                </div>
            }
            else
            {
                <div class="!mt-6 grid grid-cols-2 !gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6">
                    @foreach (var category in _categories)
                    {
                        <a href="@RouterConfig.BuildRoute(RouterConfig.Customer.CategoryDetail, category.Id)"
                           class="group flex aspect-square flex-col overflow-hidden !rounded-2xl border border-neutral-200 bg-white shadow-sm transition hover:-translate-y-1 hover:border-[#d71920] hover:shadow-lg">
                            <div class="relative flex-1 overflow-hidden bg-neutral-100">
                                @if (!string.IsNullOrWhiteSpace(category.LinkImage))
                                {
                                    <img src="@category.LinkImage"
                                         alt="@category.Name"
                                         class="h-full w-full object-cover transition duration-300 group-hover:scale-105" />
                                }
                                else
                                {
                                    <div class="bg-gradient-to-br flex h-full w-full items-center justify-center from-neutral-100 to-neutral-200">
                                        <MudIcon Icon="@Icons.Material.Filled.Category"
                                                 Size="Size.Large"
                                                 Class="text-neutral-400" />
                                    </div>
                                }

                                <div class="bg-gradient-to-t absolute inset-0 from-black/55 via-black/10 to-transparent opacity-80"></div>
                            </div>

                            <div class="!p-3">
                                <p class="line-clamp-2 text-center text-sm leading-5 font-black text-neutral-900 group-hover:!text-[#d71920]">
                                    @category.Name
                                </p>
                            </div>
                        </a>
                    }
                </div>
            }
        </section>

        <section>
            <div>
                <h2 class="text-2xl font-black text-neutral-950">
                    Thương hiệu
                </h2>

                <p class="!mt-1 text-sm text-neutral-500">
                    Mua sắm theo hãng yêu thích
                </p>
            </div>

            @if (_isLoading)
            {
                <div class="!mt-6 grid grid-cols-2 !gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6">
                    @for (var i = 0; i < 6; i++)
                    {
                        <div class="aspect-square overflow-hidden !rounded-2xl bg-white shadow-sm">
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="100%" Width="100%" />
                        </div>
                    }
                </div>
            }
            else if (!_brands.Any())
            {
                <div class="!mt-6 !rounded-3xl border border-neutral-200 bg-white !p-10 text-center shadow-sm">
                    <p class="text-sm font-semibold text-neutral-500">Chưa có thương hiệu nào.</p>
                </div>
            }
            else
            {
                <div class="!mt-6 grid grid-cols-2 !gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6">
                    @foreach (var brand in _brands)
                    {
                        <a href="@RouterConfig.BuildRoute(RouterConfig.Customer.BrandDetail, brand.Id)"
                           class="group flex aspect-square flex-col overflow-hidden !rounded-2xl border border-neutral-200 bg-white shadow-sm transition hover:-translate-y-1 hover:border-[#d71920] hover:shadow-lg">
                            <div class="bg-gradient-to-br relative flex flex-1 items-center justify-center overflow-hidden from-neutral-950 to-neutral-700 !p-4">
                                <span class="text-center text-3xl font-black tracking-tight !text-white sm:text-4xl">
                                    @GetBrandInitial(brand.Name)
                                </span>

                                <div class="absolute inset-0 bg-[#d71920]/0 transition group-hover:bg-[#d71920]/15"></div>
                            </div>

                            <div class="!p-3">
                                <p class="line-clamp-2 text-center text-sm leading-5 font-black text-neutral-900 group-hover:!text-[#d71920]">
                                    @brand.Name
                                </p>
                            </div>
                        </a>
                    }
                </div>
            }
        </section>
    </div>
</div>

@code {
    private bool _isLoading = true;

    private List<CustomerCategoryResponse> _categories = new();

    private List<CustomerBrandResponse> _brands = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadCatalogAsync();
    }

    private async Task LoadCatalogAsync()
    {
        _isLoading = true;

        var categoryTask = _customerCategoryService.GetAllAsync();
        var brandTask = _customerBrandService.GetAllAsync();

        await Task.WhenAll(categoryTask, brandTask);

        var categoryResult = await categoryTask;
        var brandResult = await brandTask;

        if (!categoryResult.Success)
        {
            _snackbar.Add("Không thể tải danh mục", Severity.Error);
        }

        if (!brandResult.Success)
        {
            _snackbar.Add("Không thể tải thương hiệu", Severity.Error);
        }

        _categories = categoryResult.Success
            ? categoryResult.Data ?? new List<CustomerCategoryResponse>()
            : new List<CustomerCategoryResponse>();

        _brands = brandResult.Success
            ? brandResult.Data ?? new List<CustomerBrandResponse>()
            : new List<CustomerBrandResponse>();

        _isLoading = false;
    }

    private static string GetBrandInitial(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "B";
        }

        return name.Trim()[0].ToString().ToUpperInvariant();
    }
}
