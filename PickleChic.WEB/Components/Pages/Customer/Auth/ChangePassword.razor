@attribute [Route(RouterConfig.Customer.ChangePassword)]
@layout MainLayout

<PageTitle>@Constant.metaDataCustomer Change Password</PageTitle>

<div class="!bg-slate-50 !px-4 !pt-10 !pb-14">
    <div class="mx-auto w-full max-w-md">
        <div class="!rounded-3xl !border !border-slate-200 !bg-white !p-8 shadow-sm">
            <div class="text-center">
                <p class="text-sm font-bold tracking-[0.25em] text-[#d71920] uppercase">
                    PickleChic WEB
                </p>

                <h1 class="!mt-3 text-2xl font-black tracking-tight text-slate-950">
                    Đổi mật khẩu
                </h1>

                <p class="!mt-2 text-sm leading-6 text-slate-500">
                    Bạn đang sử dụng mật khẩu tạm thời. Vui lòng tạo mật khẩu mới để tiếp tục sử dụng tài khoản.
                </p>
            </div>

            <MudForm @ref="_form"
                     Model="@_model"
                     Validation="@_validator.ValidateValue">
                <div class="!mt-8 !space-y-5">
                    <MudTextField @bind-Value="_model.CurrentPassword"
                                  For="@(() => _model.CurrentPassword)"
                                  Label="Mật khẩu hiện tại"
                                  Placeholder="Nhập mật khẩu hiện tại hoặc mật khẩu tạm thời"
                                  Variant="Variant.Outlined"
                                  InputType="@CurrentPasswordInputType"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@CurrentPasswordIcon"
                                  OnAdornmentClick="@(() => _showCurrentPassword = !_showCurrentPassword)"
                                  Required="true"
                                  Immediate="true" />

                    <MudTextField @bind-Value="_model.NewPassword"
                                  For="@(() => _model.NewPassword)"
                                  Label="Mật khẩu mới"
                                  Placeholder="Nhập mật khẩu mới"
                                  Variant="Variant.Outlined"
                                  InputType="@NewPasswordInputType"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@NewPasswordIcon"
                                  OnAdornmentClick="@(() => _showNewPassword = !_showNewPassword)"
                                  Required="true"
                                  Immediate="true" />

                    <MudTextField @bind-Value="_model.ConfirmPassword"
                                  For="@(() => _model.ConfirmPassword)"
                                  Label="Xác nhận mật khẩu mới"
                                  Placeholder="Nhập lại mật khẩu mới"
                                  Variant="Variant.Outlined"
                                  InputType="@ConfirmPasswordInputType"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@ConfirmPasswordIcon"
                                  OnAdornmentClick="@(() => _showConfirmPassword = !_showConfirmPassword)"
                                  Required="true"
                                  Immediate="true" />

                    <div class="!rounded-2xl !border !border-slate-200 !bg-slate-50 !p-4">
                        <p class="text-sm font-black text-slate-950">
                            Yêu cầu mật khẩu
                        </p>

                        <ul class="!mt-3 !space-y-2 text-sm font-semibold text-slate-600">
                            <li class="flex items-center !gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="text-[#d71920]" />
                                Tối thiểu 6 ký tự
                            </li>

                            <li class="flex items-center !gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="text-[#d71920]" />
                                Có ít nhất 1 chữ hoa và 1 chữ thường
                            </li>

                            <li class="flex items-center !gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="text-[#d71920]" />
                                Có ít nhất 1 chữ số
                            </li>

                            <li class="flex items-center !gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="text-[#d71920]" />
                                Có ít nhất 1 ký tự đặc biệt
                            </li>
                        </ul>
                    </div>

                    <button type="button"
                            @onclick="SubmitAsync"
                            disabled="@_isSubmitting"
                            class="inline-flex w-full items-center justify-center !gap-2 !rounded-full !border !border-black !bg-black !px-6 !py-3 text-sm font-black !text-white shadow-sm transition hover:!border-[#d71920] hover:!bg-[#d71920] hover:!text-white disabled:!cursor-not-allowed disabled:!opacity-70">
                        <MudIcon Icon="@Icons.Material.Filled.Save" Size="Size.Small" />
                        @(_isSubmitting ? "Đang cập nhật..." : "Cập nhật mật khẩu")
                    </button>
                </div>
            </MudForm>
        </div>
    </div>
</div>

@code {
    private MudForm? _form;

    private readonly ChangePasswordModel _model = new();

    private readonly ChangePasswordSchema.ChangePassword _validator = new();

    private bool _isSubmitting;


    private bool _showCurrentPassword;
    private bool _showNewPassword;
    private bool _showConfirmPassword;

    private InputType CurrentPasswordInputType => _showCurrentPassword ? InputType.Text : InputType.Password;
    private InputType NewPasswordInputType => _showNewPassword ? InputType.Text : InputType.Password;
    private InputType ConfirmPasswordInputType => _showConfirmPassword ? InputType.Text : InputType.Password;

    private async Task SubmitAsync()
    {
        if (_form is null || _isSubmitting)
        {
            return;
        }

        await _form.ValidateAsync();

        if (!_form.IsValid)
        {
            return;
        }

        _isSubmitting = true;

        try
        {
            var result = await _authService.ChangeCustomerPasswordAsync(_model);

            if (!result.Success)
            {
                _snackbar.Add(ConvertChangePasswordErrorMessage(result.Message), Severity.Error);
                return;
            }

            _snackbar.Add("Đổi mật khẩu thành công.", Severity.Success);

            await _authStorageService.SetMustChangePasswordAsync(false);

            _navigation.NavigateTo(RouterConfig.Customer.Home, replace: true);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private static string ConvertChangePasswordErrorMessage(string message)
    {
        return message switch
        {
            "PasswordIsTheSame" => "Mật khẩu mới không được trùng mật khẩu hiện tại.",
            "CurrentPasswordNotMatch" => "Mật khẩu hiện tại không chính xác.",
            "CustomerNotFound" => "Không tìm thấy tài khoản khách hàng.",
            "TokenExpired" => "Phiên đăng nhập đã hết hạn. Vui lòng đăng nhập lại.",
            "InvalidToken" => "Phiên đăng nhập không hợp lệ. Vui lòng đăng nhập lại.",
            "Not found" => "Không tìm thấy thông tin tài khoản.",
            "OtherError" => "Có lỗi xảy ra khi cập nhật mật khẩu.",
            _ => string.IsNullOrWhiteSpace(message)
                ? "Đổi mật khẩu không thành công. Vui lòng thử lại."
                : message
        };
    }

    private string CurrentPasswordIcon => _showCurrentPassword
        ? Icons.Material.Filled.VisibilityOff
        : Icons.Material.Filled.Visibility;

    private string NewPasswordIcon => _showNewPassword
        ? Icons.Material.Filled.VisibilityOff
        : Icons.Material.Filled.Visibility;

    private string ConfirmPasswordIcon => _showConfirmPassword
        ? Icons.Material.Filled.VisibilityOff
        : Icons.Material.Filled.Visibility;
}