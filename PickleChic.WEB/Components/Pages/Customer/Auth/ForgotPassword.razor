@attribute [Route(RouterConfig.Customer.ForgotPassword)]
@layout MainLayout

<PageTitle>@Constant.metaDataCustomer Forgot Password</PageTitle>

<div class="!bg-slate-50 !px-4 !pt-10 !pb-14">
    <div class="mx-auto w-full max-w-md">
        <div class="!rounded-3xl !border !border-slate-200 !bg-white !p-8 shadow-sm">
            <div class="text-center">
                <p class="text-sm font-bold tracking-[0.25em] text-[#d71920] uppercase">
                    PickleChic WEB
                </p>

                <h1 class="!mt-3 text-2xl font-black tracking-tight text-slate-950">
                    Quên mật khẩu
                </h1>

                <p class="!mt-2 text-sm leading-6 text-slate-500">
                    Nhập email tài khoản của bạn. Hệ thống sẽ gửi hướng dẫn đặt lại mật khẩu.
                </p>
            </div>

            <MudForm @ref="_form"
                     Model="@_model"
                     Validation="@_validator.ValidateValue">
                <div class="!mt-8 !space-y-5">
                    <MudTextField @bind-Value="_model.Email"
                                  For="@(() => _model.Email)"
                                  Label="Email"
                                  Placeholder="Nhập email của bạn"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Email"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Email"
                                  Required="true"
                                  Immediate="true" />

                    <button type="button"
                            @onclick="SubmitAsync"
                            class="inline-flex w-full items-center justify-center !gap-2 !rounded-full !border !border-black !bg-black !px-6 !py-3 text-sm font-black !text-white shadow-sm transition hover:!border-[#d71920] hover:!bg-[#d71920] hover:!text-white">
                        <MudIcon Icon="@Icons.Material.Filled.MarkEmailRead" Size="Size.Small" />
                        Gửi
                    </button>
                </div>
            </MudForm>

            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <div class="!mt-5 !rounded-2xl !border !border-green-100 !bg-green-50 !p-4">
                    <p class="text-sm leading-6 font-semibold text-green-700">
                        @_message
                    </p>
                </div>
            }

            <div class="!mt-6 text-center">
                <a href="@RouterConfig.Customer.Login"
                   class="text-sm font-semibold text-slate-900 transition hover:!text-[#d71920]">
                    Quay lại đăng nhập
                </a>
            </div>
        </div>
    </div>
</div>

@code {
    private MudForm? _form;

    private readonly ForgotPasswordModel _model = new();

    private readonly ForgotPasswordSchema.ForgotPassword _validator = new();

    private string _message = string.Empty;

    private async Task SubmitAsync()
    {
        if (_form is null)
        {
            return;
        }

        await _form.Validate();

        if (!_form.IsValid)
        {
            return;
        }

        // TODO: Gọi API quên mật khẩu tại đây.
        // await AuthService.ForgotPasswordAsync(_model.Email);

        _message = "Nếu email tồn tại trong hệ thống, hướng dẫn đặt lại mật khẩu sẽ được gửi đến email của bạn.";
    }
}