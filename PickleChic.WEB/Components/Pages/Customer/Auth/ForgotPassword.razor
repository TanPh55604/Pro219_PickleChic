@attribute [Route(RouterConfig.Customer.ForgotPassword)]
@layout MainLayout

<PageTitle>@Constant.metaDataCustomer Forgot Password</PageTitle>

<div class="!bg-slate-50 !px-4 !pt-10 !pb-14">
    <div class="mx-auto w-full max-w-md">
        <div class="!rounded-3xl !border !border-slate-200 !bg-white !p-8 shadow-sm">
            <div class="text-center">
                <p class="text-sm font-bold tracking-[0.25em] text-[#d71920] uppercase">
                    PickleChic WEB
                </p>

                <h1 class="!mt-3 text-2xl font-black tracking-tight text-slate-950">
                    Quên mật khẩu
                </h1>

                <p class="!mt-2 text-sm leading-6 text-slate-500">
                    Nhập email tài khoản của bạn. Hệ thống sẽ gửi hướng dẫn đặt lại mật khẩu.
                </p>
            </div>

            <MudForm @ref="_form"
                     Model="@_model"
                     Validation="@_validator.ValidateValue">
                <div class="!mt-8 !space-y-5">
                    <MudTextField @bind-Value="_model.Email"
                                  For="@(() => _model.Email)"
                                  Label="Email"
                                  Placeholder="Nhập email của bạn"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Email"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Email"
                                  Required="true"
                                  Immediate="true" />

                    <button type="button"
                            @onclick="SubmitAsync"
                            disabled="@_isSubmitting"
                            class="inline-flex w-full items-center justify-center !gap-2 !rounded-full !border !border-black !bg-black !px-6 !py-3 text-sm font-black !text-white shadow-sm transition hover:!border-[#d71920] hover:!bg-[#d71920] hover:!text-white disabled:!cursor-not-allowed disabled:!opacity-70">
                        <MudIcon Icon="@Icons.Material.Filled.MarkEmailRead" Size="Size.Small" />
                        @(_isSubmitting ? "Đang gửi..." : "Gửi")
                    </button>
                </div>
            </MudForm>
        </div>
    </div>
</div>

@code {
    private MudForm? _form;

    private readonly ForgotPasswordModel _model = new();

    private readonly ForgotPasswordSchema.ForgotPassword _validator = new();

    private bool _isSubmitting;

    private async Task SubmitAsync()
    {
        if (_form is null || _isSubmitting)
        {
            return;
        }

        await _form.ValidateAsync();

        if (!_form.IsValid)
        {
            return;
        }

        _isSubmitting = true;

        try
        {
            var result = await _authService.ForgotCustomerPasswordAsync(_model);

            if (!result.Success)
            {
                _snackbar.Add(result.Message, Severity.Error);
                return;
            }

            _snackbar.Add("Nếu email của bạn tồn tại. Mật khẩu tạm thời đã được gửi tới.", Severity.Success);

            _navigation.NavigateTo(RouterConfig.Customer.Login, replace: true);
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}