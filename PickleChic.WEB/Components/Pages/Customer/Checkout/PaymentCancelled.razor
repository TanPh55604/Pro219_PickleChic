@attribute [Route(RouterConfig.Customer.PaymentCancelled)]
@layout MainLayout

<PageTitle>PickleChic WEB - Thanh toán thất bại</PageTitle>

<div class="min-h-[calc(100vh-180px)] !bg-slate-50 !px-4 !pt-8 !pb-14">
    <div class="mx-auto w-full max-w-2xl">
        @if (_isLoading)
        {
            <div class="flex justify-center !py-20">
                <MudProgressCircular Color="Color.Error" Indeterminate="true" />
            </div>
        }
        else
        {
            <div class="!rounded-3xl !border !border-slate-200 !bg-white !p-10 text-center shadow-sm">
                <div class="mx-auto flex !h-16 !w-16 items-center justify-center !rounded-full !bg-red-50 text-[#d71920]">
                    <MudIcon Icon="@Icons.Material.Filled.Cancel" Size="Size.Large" />
                </div>

                <p class="!mt-5 text-sm font-bold tracking-[0.25em] text-[#d71920] uppercase">
                    Thanh toán thất bại
                </p>

                <h1 class="!mt-2 text-3xl font-black tracking-tight text-slate-950">
                    Giao dịch chưa hoàn tất
                </h1>

                <p class="!mt-3 text-sm text-slate-500">
                    @if (!string.IsNullOrWhiteSpace(_orderCode))
                    {
                        <span>
                            Đơn hàng <span class="font-black text-slate-950">@_orderCode</span> đã bị hủy thanh toán.
                        </span>
                    }
                    else
                    {
                        <span>@(_message ?? "Thanh toán đã bị hủy hoặc không thành công.")</span>
                    }
                </p>

                <a href="@RouterConfig.Customer.Products"
                   class="!mt-8 inline-flex items-center justify-center !gap-2 !rounded-full !border !border-black !bg-black !px-7 !py-3 text-sm font-black !text-white transition hover:!border-[#d71920] hover:!bg-[#d71920]">
                    <MudIcon Icon="@Icons.Material.Filled.ShoppingBag" Size="Size.Small" />
                    Tiếp tục mua sắm
                </a>
            </div>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "orderId")]
    public int? OrderId { get; set; }

    private bool _isLoading = true;
    private string _orderCode = string.Empty;
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        if (OrderId is null or <= 0)
        {
            _isLoading = false;
            _message = "Không tìm thấy mã đơn hàng thanh toán.";
            return;
        }

        var result = await _customerOrderService.ConfirmPaymentCanceledAsync(OrderId.Value);

        if (!result.Success || result.Data is null)
        {
            _message = string.IsNullOrWhiteSpace(result.Message)
                ? "Thanh toán đã bị hủy hoặc không thành công."
                : result.Message;
        }
        else
        {
            _orderCode = result.Data.OrderCode;
            _cartService.NotifyCartChanged();
        }

        _isLoading = false;
    }
}
