@attribute [Route(RouterConfig.Customer.PaymentSuccess)]
@layout MainLayout

<PageTitle>PickleChic WEB - Thanh toán thành công</PageTitle>

<div class="min-h-[calc(100vh-180px)] !bg-slate-50 !px-4 !pt-8 !pb-14">
    <div class="mx-auto w-full max-w-2xl">
        @if (_isLoading)
        {
            <div class="flex justify-center !py-20">
                <MudProgressCircular Color="Color.Error" Indeterminate="true" />
            </div>
        }
        else if (!_isSuccess)
        {
            <div class="!rounded-3xl !border !border-slate-200 !bg-white !p-10 text-center shadow-sm">
                <div class="mx-auto flex !h-16 !w-16 items-center justify-center !rounded-full !bg-red-50 text-[#d71920]">
                    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large" />
                </div>

                <h1 class="!mt-5 text-2xl font-black text-slate-950">
                    Không xác nhận được thanh toán
                </h1>

                <p class="!mt-2 text-sm text-slate-500">
                    @(_errorMessage ?? "Đã có lỗi xảy ra khi xác nhận thanh toán.")
                </p>

                <a href="@RouterConfig.Customer.Products"
                   class="!mt-6 inline-flex items-center justify-center !rounded-full !bg-black !px-7 !py-3 text-sm font-black !text-white transition hover:!bg-[#d71920]">
                    Tiếp tục mua sắm
                </a>
            </div>
        }
        else
        {
            <div class="!rounded-3xl !border !border-slate-200 !bg-white !p-10 text-center shadow-sm">
                <div class="mx-auto flex !h-16 !w-16 items-center justify-center !rounded-full !bg-green-50 text-green-600">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Large" />
                </div>

                <p class="!mt-5 text-sm font-bold tracking-[0.25em] text-[#d71920] uppercase">
                    Thanh toán thành công
                </p>

                <h1 class="!mt-2 text-3xl font-black tracking-tight text-slate-950">
                    Cảm ơn bạn đã đặt hàng
                </h1>

                <p class="!mt-3 text-sm text-slate-500">
                    Đơn hàng
                    <span class="font-black text-slate-950">@_orderCode</span>
                    đã được thanh toán thành công.
                </p>

                <div class="!mt-8 flex flex-col items-center justify-center !gap-3 sm:flex-row">
                    <a href="@RouterConfig.Customer.Products"
                       class="inline-flex w-full items-center justify-center !gap-2 !rounded-full !border !border-slate-300 !bg-white !px-6 !py-3 text-sm font-black text-slate-900 transition hover:!border-[#d71920] hover:!text-[#d71920] sm:w-auto">
                        <MudIcon Icon="@Icons.Material.Filled.ShoppingBag" Size="Size.Small" />
                        Tiếp tục mua sắm
                    </a>

                    <a href="@_invoiceUrl"
                       class="inline-flex w-full items-center justify-center !gap-2 !rounded-full !border !border-black !bg-black !px-6 !py-3 text-sm font-black !text-white transition hover:!border-[#d71920] hover:!bg-[#d71920] sm:w-auto">
                        <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Size="Size.Small" />
                        Xem hóa đơn
                    </a>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "orderId")]
    public int? OrderId { get; set; }

    private bool _isLoading = true;
    private bool _isSuccess;
    private string _orderCode = string.Empty;
    private string _invoiceUrl = RouterConfig.Customer.Orders;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (OrderId is null or <= 0)
        {
            _isLoading = false;
            _isSuccess = false;
            _errorMessage = "Không tìm thấy mã đơn hàng thanh toán.";
            return;
        }

        var result = await _customerOrderService.ConfirmPaymentSuccessAsync(OrderId.Value);

        if (!result.Success || result.Data is null)
        {
            _isSuccess = false;
            _errorMessage = string.IsNullOrWhiteSpace(result.Message)
                ? "Không thể xác nhận thanh toán thành công."
                : result.Message;
        }
        else
        {
            _isSuccess = true;
            _orderCode = result.Data.OrderCode;
            _invoiceUrl = RouterConfig.BuildRoute(RouterConfig.Customer.OrderDetail, result.Data.Id);
            _cartService.NotifyCartChanged();
        }

        _isLoading = false;
    }
}
