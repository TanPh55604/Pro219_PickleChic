            Variant = "Màu: Rally Rocket / Độ dày: 16mm",
            Price = 8990000,
            Quantity = 2,
            ProductUrl = "/products/kosmos-pro-v-rally-rocket-16mm"
        },
        new()
        {
            Id = 2,
            Name = "Kosmos Pro V Rally Rocket 16mm",
            Variant = "Màu: Rally Rocket / Độ dày: 16mm",
            Price = 8990000,
            Quantity = 2,
            ProductUrl = "/products/kosmos-pro-v-rally-rocket-16mm"
        },
        new()
        {
            Id = 2,
            Name = "Kosmos Pro V Rally Rocket 16mm",
            Variant = "Màu: Rally Rocket / Độ dày: 16mm",
            Price = 8990000,
            Quantity = 2,
            ProductUrl = "/products/kosmos-pro-v-rally-rocket-16mm"
        },
        new()
        {
            Id = 2,
            Name = "Kosmos Pro V Rally Rocket 16mm",
            Variant = "Màu: Rally Rocket / Độ dày: 16mm",
            Price = 8990000,
            Quantity = 2,
            ProductUrl = "/products/kosmos-pro-v-rally-rocket-16mm"
        },
        new()
        {
            Id = 2,
            Name = "Kosmos Pro V Rally Rocket 16mm",
            Variant = "Màu: Rally Rocket / Độ dày: 16mm",
            Price = 8990000,
            Quantity = 2,
            ProductUrl = "/products/kosmos-pro-v-rally-rocket-16mm"
        },
        new()
        {
            Id = 2,
            Name = "Kosmos Pro V Rally Rocket 16mm",
            Variant = "Màu: Rally Rocket / Độ dày: 16mm",
            Price = 8990000,
            Quantity = 2,
            ProductUrl = "/products/kosmos-pro-v-rally-rocket-16mm"
        },
        new()
        {
            Id = 2,
            Name = "Kosmos Pro V Rally Rocket 16mm",
            Variant = "Màu: Rally Rocket / Độ dày: 16mm",
            Price = 8990000,
            Quantity = 2,
            ProductUrl = "/products/kosmos-pro-v-rally-rocket-16mm"
        },
        new()
        {
            Id = 2,
            Name = "Kosmos Pro V Rally Rocket 16mm",
            Variant = "Màu: Rally Rocket / Độ dày: 16mm",
            Price = 8990000,
            Quantity = 2,
            ProductUrl = "/products/kosmos-pro-v-rally-rocket-16mm"
        }
    };

    private int TotalQuantity => _cartItems.Sum(x => x.Quantity);

    private decimal SubTotal => _cartItems.Sum(x => x.LineTotal);

    private decimal ShippingFee => 0;

    private decimal Discount => string.IsNullOrWhiteSpace(_appliedCoupon) ? 0 : 500000;

    private decimal Total => Math.Max(0, SubTotal + ShippingFee - Discount);

    private string PaymentMethodText => _paymentMethod switch
    {
        PaymentMethod.Cash => "Tiền mặt",
        PaymentMethod.BankTransfer => "Chuyển khoản",
        _ => "Tiền mặt"
    };

    private void IncreaseQuantity(int id)
    {
        var item = _cartItems.FirstOrDefault(x => x.Id == id);

        if (item is null)
        {
            return;
        }

        item.Quantity++;
    }

    private void DecreaseQuantity(int id)
    {
        var item = _cartItems.FirstOrDefault(x => x.Id == id);

        if (item is null)
        {
            return;
        }

        if (item.Quantity > 1)
        {
            item.Quantity--;
            return;
        }

        RemoveItem(id);
    }

    private void RemoveItem(int id)
    {
        var item = _cartItems.FirstOrDefault(x => x.Id == id);

        if (item is null)
        {
            return;
        }

        _cartItems.Remove(item);
    }

    private void ApplyCoupon()
    {
        _couponError = string.Empty;

        if (string.IsNullOrWhiteSpace(_couponCode))
        {
            _couponError = "Vui lòng nhập mã giảm giá.";
            return;
        }

        if (!_couponCode.Equals("PICKLE500", StringComparison.OrdinalIgnoreCase))
        {
            _couponError = "Mã giảm giá không hợp lệ.";
            return;
        }

        _appliedCoupon = _couponCode.Trim().ToUpperInvariant();
        _couponCode = string.Empty;
    }

    private void RemoveCoupon()
    {
        _appliedCoupon = string.Empty;
        _couponCode = string.Empty;
        _couponError = string.Empty;
    }

    private void PlaceOrder()
    {
        if (!_cartItems.Any())
        {
            return;
        }

        if (_paymentMethod == PaymentMethod.BankTransfer)
        {
            _orderMessage = "UI demo: Sau bước này sẽ chuyển sang trang thanh toán chuyển khoản.";
            return;
        }

        _orderMessage = "UI demo: Đặt hàng tiền mặt thành công.";
    }

    private string GetPaymentMethodClass(PaymentMethod method)
    {
        var activeClass = _paymentMethod == method
            ? "!border-[#d71920] !bg-red-50"
            : "!border-slate-200 !bg-white hover:!border-[#d71920]";

        return $"flex cursor-pointer items-start !gap-3 !rounded-2xl !border !p-4 transition {activeClass}";
    }

    private static string FormatMoney(decimal value)
    {
        return $"{value:N0} đ";
    }

    private enum PaymentMethod
    {
        Cash = 1,
        BankTransfer = 2
    }

    private class CheckoutItem
    {
        public int Id { get; set; }

        public string Name { get; set; } = string.Empty;

        public string Variant { get; set; } = string.Empty;

        public decimal Price { get; set; }

        public int Quantity { get; set; }

        public string ProductUrl { get; set; } = string.Empty;

        public decimal LineTotal => Price * Quantity;
    }
}