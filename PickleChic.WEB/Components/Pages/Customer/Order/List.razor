@attribute [Route(RouterConfig.Customer.Orders)]
@layout MainLayout

<PageTitle>PickleChic WEB - Đơn hàng của tôi</PageTitle>

<div class="min-h-[calc(100vh-180px)] !bg-slate-50 !px-4 !pt-8 !pb-14">
    <div class="mx-auto w-full max-w-5xl">
        <div class="flex flex-col !gap-4 md:flex-row md:items-center md:justify-between">
            <div>
                <p class="text-sm font-bold tracking-[0.25em] text-[#d71920] uppercase">
                    Tài khoản
                </p>

                <h1 class="!mt-2 text-3xl font-black tracking-tight text-slate-950">
                    Đơn hàng của tôi
                </h1>

                <p class="!mt-2 text-sm text-slate-500">
                    Theo dõi trạng thái và xem lại hóa đơn các đơn đã đặt
                </p>
            </div>

            <a href="@RouterConfig.Customer.Products"
               class="inline-flex items-center justify-center !gap-2 !rounded-full !border !border-slate-300 !bg-white !px-5 !py-2.5 text-sm font-black text-slate-900 transition hover:!border-[#d71920] hover:!text-[#d71920]">
                <MudIcon Icon="@Icons.Material.Filled.ShoppingBag" Size="Size.Small" />
                Tiếp tục mua sắm
            </a>
        </div>

        @if (_isLoading)
        {
            <div class="!mt-10 flex justify-center !py-16">
                <MudProgressCircular Color="Color.Error" Indeterminate="true" />
            </div>
        }
        else if (!_orders.Any())
        {
            <div class="!mt-8 !rounded-3xl !border !border-slate-200 !bg-white !p-10 text-center shadow-sm">
                <div class="mx-auto flex !h-16 !w-16 items-center justify-center !rounded-full !bg-slate-100 text-slate-400">
                    <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Size="Size.Large" />
                </div>

                <h2 class="!mt-5 text-2xl font-black text-slate-950">
                    Chưa có đơn hàng
                </h2>

                <p class="!mt-2 text-sm text-slate-500">
                    Khi bạn đặt hàng, hóa đơn sẽ hiển thị tại đây.
                </p>

                <a href="@RouterConfig.Customer.Products"
                   class="!mt-6 inline-flex items-center justify-center !rounded-full !bg-black !px-7 !py-3 text-sm font-black !text-white transition hover:!bg-[#d71920]">
                    Mua sắm ngay
                </a>
            </div>
        }
        else
        {
            <div class="!mt-8 !space-y-4">
                @foreach (var order in _orders)
                {
                    var detailUrl = RouterConfig.BuildRoute(RouterConfig.Customer.OrderDetail, order.Id);
                    var canPay = CanPayOnline(order);

                    <div class="!rounded-3xl !border !border-slate-200 !bg-white !p-5 shadow-sm transition hover:!border-[#d71920]/md:!p-6">
                        <div class="flex flex-col !gap-4 lg:flex-row lg:items-center lg:justify-between">
                            <div class="min-w-0 flex-1">
                                <div class="flex flex-wrap items-center !gap-2">
                                    <a href="@detailUrl"
                                       class="text-lg font-black text-slate-950 transition hover:!text-[#d71920]">
                                        @order.OrderCode
                                    </a>

                                    <span class="@GetStatusBadgeClass(order.OrderStatus)">
                                        @order.OrderStatus
                                    </span>

                                    <span class="@GetPaymentBadgeClass(order.PaymentStatus)">
                                        @order.PaymentStatus
                                    </span>
                                </div>

                                <p class="!mt-2 text-sm text-slate-500">
                                    Đặt lúc @order.OrderDate.ToString("HH:mm dd/MM/yyyy")
                                    · @order.OrderItems.Sum(x => x.Quantity) sản phẩm
                                </p>

                                <p class="!mt-1 line-clamp-1 text-sm text-slate-500">
                                    @order.ReceiverName · @order.FullAddress
                                </p>
                            </div>

                            <div class="flex flex-col !gap-3 sm:flex-row sm:items-center sm:justify-between lg:flex-col lg:items-end">
                                <p class="text-xl font-black text-[#d71920]">
                                    @FormatMoney(order.FinalPrice)
                                </p>

                                <div class="flex flex-wrap !gap-2">
                                    @if (canPay)
                                    {
                                        <button type="button"
                                                @onclick="() => OpenPaymentLink(order)"
                                                class="inline-flex items-center justify-center !gap-2 !rounded-full !border !border-black !bg-black !px-4 !py-2 text-sm font-black !text-white transition hover:!border-[#d71920] hover:!bg-[#d71920]">
                                            <MudIcon Icon="@Icons.Material.Filled.Payment" Size="Size.Small" />
                                            Thanh toán
                                        </button>
                                    }

                                    <a href="@detailUrl"
                                       class="inline-flex items-center justify-center !gap-2 !rounded-full !border !border-slate-300 !bg-white !px-4 !py-2 text-sm font-black text-slate-900 transition hover:!border-[#d71920] hover:!text-[#d71920]">
                                        Xem hóa đơn
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private List<UserOrderDetailResponse> _orders = new();
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        if (!await _authStorageService.IsAuthenticatedAsync())
        {
            _navigation.NavigateTo(RouterConfig.Customer.Login, replace: true);
            return;
        }

        await LoadOrdersAsync();
    }

    private async Task LoadOrdersAsync()
    {
        _isLoading = true;
        StateHasChanged();

        var result = await _customerOrderService.GetUserOrdersAsync();

        if (!result.Success)
        {
            _snackbar.Add(
                string.IsNullOrWhiteSpace(result.Message)
                    ? "Không thể tải danh sách đơn hàng"
                    : result.Message,
                Severity.Error);
            _orders = new List<UserOrderDetailResponse>();
        }
        else
        {
            _orders = (result.Data ?? new List<UserOrderDetailResponse>())
                .OrderByDescending(x => x.OrderDate)
                .ToList();
        }

        _isLoading = false;
    }

    private static bool CanPayOnline(UserOrderDetailResponse order)
    {
        return !string.IsNullOrWhiteSpace(order.PaymentLink)
               && order.PaymentStatus == Constant.PaymentStatus.Pending
               && order.OrderStatus is Constant.OrderStatus.WaitingForPayment
                   or Constant.OrderStatus.Pending
                   or Constant.OrderStatus.Processing;
    }

    private void OpenPaymentLink(UserOrderDetailResponse order)
    {
        if (string.IsNullOrWhiteSpace(order.PaymentLink))
        {
            return;
        }

        _navigation.NavigateTo(order.PaymentLink, forceLoad: true);
    }

    private static string GetStatusBadgeClass(string status)
    {
        var color = status switch
        {
            Constant.OrderStatus.Done or Constant.OrderStatus.ShippingDone => "!bg-green-50 !text-green-700",
            Constant.OrderStatus.Cancelled or Constant.OrderStatus.DeliveryFailed or Constant.OrderStatus.Expired => "!bg-red-50 !text-[#d71920]",
            Constant.OrderStatus.WaitingForPayment or Constant.OrderStatus.Pending or Constant.OrderStatus.Processing => "!bg-amber-50 !text-amber-700",
            _ => "!bg-slate-100 !text-slate-600"
        };

        return $"!rounded-full !px-2.5 !py-0.5 text-xs font-black {color}";
    }

    private static string GetPaymentBadgeClass(string status)
    {
        var color = status switch
        {
            Constant.PaymentStatus.Completed => "!bg-green-50 !text-green-700",
            Constant.PaymentStatus.Cancelled => "!bg-red-50 !text-[#d71920]",
            _ => "!bg-amber-50 !text-amber-700"
        };

        return $"!rounded-full !px-2.5 !py-0.5 text-xs font-black {color}";
    }

    private static string FormatMoney(decimal value)
    {
        return $"{value:N0} đ";
    }
}
