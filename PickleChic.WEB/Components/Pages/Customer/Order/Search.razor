@attribute [Route(RouterConfig.Customer.SearchOrder)]
@layout MainLayout
@using System.Text.Json

<PageTitle>PickleChic WEB - Tra cứu đơn hàng</PageTitle>

<div class="min-h-[calc(100vh-180px)] !bg-slate-50 !px-4 !pt-8 !pb-14">
    <div class="mx-auto w-full max-w-5xl">
        <div class="flex flex-col !gap-4 md:flex-row md:items-center md:justify-between">
            <div>
                <p class="text-sm font-bold tracking-[0.25em] text-[#d71920] uppercase">
                    Hỗ trợ
                </p>

                <h1 class="!mt-2 text-3xl font-black tracking-tight text-slate-950">
                    Tra cứu đơn hàng
                </h1>

                <p class="!mt-2 text-sm text-slate-500">
                    Nhập mã đơn, số điện thoại hoặc tên người nhận để tìm đơn của bạn
                </p>
            </div>
        </div>

        @if (_selectedOrder is not null)
        {
            <div class="!mt-8">
                <button type="button"
                        @onclick="ClearSelectedOrder"
                        class="inline-flex items-center !gap-2 text-sm font-black text-slate-600 transition hover:!text-[#d71920]">
                    <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" />
                    Quay lại kết quả
                </button>

                @RenderOrderDetail(_selectedOrder)
            </div>
        }
        else
        {
            <div class="!mt-8 !rounded-3xl !border !border-slate-200 !bg-white !p-5 shadow-sm md:!p-6">
                <div class="grid !gap-4 md:grid-cols-3">
                    <MudTextField @bind-Value="_orderCode"
                                  Label="Mã đơn hàng"
                                  Variant="Variant.Outlined"
                                  Immediate="true"
                                  OnKeyDown="HandleSearchKeyDown" />
                    <MudTextField @bind-Value="_phoneNumber"
                                  Label="Số điện thoại"
                                  Variant="Variant.Outlined"
                                  Immediate="true"
                                  OnKeyDown="HandleSearchKeyDown" />
                    <MudTextField @bind-Value="_name"
                                  Label="Tên người nhận"
                                  Variant="Variant.Outlined"
                                  Immediate="true"
                                  OnKeyDown="HandleSearchKeyDown" />
                </div>

                <div class="!mt-5 flex flex-wrap !gap-3">
                    <button type="button"
                            @onclick="SearchAsync"
                            disabled="@_isSearching"
                            class="inline-flex items-center justify-center !gap-2 !rounded-full !bg-black !px-6 !py-2.5 text-sm font-black !text-white transition hover:!bg-[#d71920] disabled:opacity-50">
                        <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" />
                        Tra cứu
                    </button>

                    <button type="button"
                            @onclick="ResetSearch"
                            disabled="@_isSearching"
                            class="inline-flex items-center justify-center !gap-2 !rounded-full !border !border-slate-300 !bg-white !px-6 !py-2.5 text-sm font-black text-slate-900 transition hover:!border-[#d71920] hover:!text-[#d71920] disabled:opacity-50">
                        Xóa bộ lọc
                    </button>
                </div>
            </div>

            @if (_isSearching)
            {
                <div class="!mt-10 flex justify-center !py-10">
                    <MudProgressCircular Color="Color.Error" Indeterminate="true" />
                </div>
            }
            else if (_hasSearched && !_orders.Any())
            {
                <div class="!mt-8 !rounded-3xl !border !border-slate-200 !bg-white !p-10 text-center shadow-sm">
                    <div class="mx-auto flex !h-16 !w-16 items-center justify-center !rounded-full !bg-slate-100 text-slate-400">
                        <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" />
                    </div>
                    <h2 class="!mt-5 text-2xl font-black text-slate-950">Không tìm thấy đơn hàng</h2>
                    <p class="!mt-2 text-sm text-slate-500">
                        Kiểm tra lại mã đơn, số điện thoại hoặc tên người nhận
                    </p>
                </div>
            }
            else if (_orders.Any())
            {
                <div class="!mt-8 !space-y-4">
                    <p class="text-sm font-bold text-slate-600">
                        Tìm thấy @_orders.Count đơn hàng
                    </p>

                    @foreach (var order in _orders)
                    {
                        <div class="!rounded-3xl !border !border-slate-200 !bg-white !p-5 shadow-sm md:!p-6">
                            <div class="flex flex-col !gap-4 lg:flex-row lg:items-center lg:justify-between">
                                <div class="min-w-0 flex-1">
                                    <div class="flex flex-wrap items-center !gap-2">
                                        <p class="text-lg font-black text-slate-950">@order.OrderCode</p>
                                        <span class="@GetStatusBadgeClass(order.OrderStatus)">@order.OrderStatus</span>
                                        <span class="@GetPaymentBadgeClass(order.PaymentStatus)">@order.PaymentStatus</span>
                                    </div>

                                    <p class="!mt-2 text-sm text-slate-500">
                                        Đặt lúc @order.OrderDate.ToString("HH:mm dd/MM/yyyy")
                                        · @order.OrderItems.Sum(x => x.Quantity) sản phẩm
                                    </p>

                                    <p class="!mt-1 line-clamp-1 text-sm text-slate-500">
                                        @if (IsGuestInStoreOrder(order))
                                        {
                                            <text>Khách vãng lai - @GetGuestInStoreLabel(order)</text>
                                        }
                                        else
                                        {
                                            <text>@order.ReceiverName · @order.ReceiverPhone · @order.FullAddress</text>
                                        }
                                    </p>
                                </div>

                                <div class="flex flex-col !gap-3 sm:flex-row sm:items-center lg:flex-col lg:items-end">
                                    <p class="text-xl font-black text-[#d71920]">@FormatMoney(order.FinalPrice)</p>

                                    <div class="flex flex-wrap !gap-2">
                                        @if (CanPayOnline(order))
                                        {
                                            <button type="button"
                                                    @onclick="() => OpenPaymentLink(order)"
                                                    class="inline-flex items-center justify-center !gap-2 !rounded-full !border !border-black !bg-black !px-4 !py-2 text-sm font-black !text-white transition hover:!border-[#d71920] hover:!bg-[#d71920]">
                                                <MudIcon Icon="@Icons.Material.Filled.Payment" Size="Size.Small" />
                                                Thanh toán
                                            </button>
                                        }

                                        @if (CanCancelOrder(order))
                                        {
                                            <button type="button"
                                                    @onclick="() => CancelGuestOrderAsync(order)"
                                                    disabled="@_isCancelling"
                                                    class="inline-flex items-center justify-center !gap-2 !rounded-full !border !border-red-200 !bg-red-50 !px-4 !py-2 text-sm font-black text-[#d71920] transition hover:!border-[#d71920] disabled:opacity-50">
                                                <MudIcon Icon="@Icons.Material.Filled.Cancel" Size="Size.Small" />
                                                Hủy đơn
                                            </button>
                                        }

                                        <button type="button"
                                                @onclick="() => SelectOrder(order)"
                                                class="inline-flex items-center justify-center !gap-2 !rounded-full !border !border-slate-300 !bg-white !px-4 !py-2 text-sm font-black text-slate-900 transition hover:!border-[#d71920] hover:!text-[#d71920]">
                                            Xem hóa đơn
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>

@code {
    private static readonly JsonSerializerOptions StatusHistoryJsonOptions = new()
    {
        PropertyNameCaseInsensitive = true
    };

    private string _orderCode = string.Empty;
    private string _phoneNumber = string.Empty;
    private string _name = string.Empty;

    private bool _isSearching;
    private bool _isCancelling;
    private bool _hasSearched;
    private string _lastLookupPhone = string.Empty;
    private List<UserOrderDetailResponse> _orders = new();
    private UserOrderDetailResponse? _selectedOrder;

    protected override async Task OnInitializedAsync()
    {
        if (await _authStorageService.IsAuthenticatedAsync())
        {
            _navigation.NavigateTo(RouterConfig.Customer.Orders, replace: true);
        }
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await SearchAsync();
        }
    }

    private async Task SearchAsync()
    {
        if (string.IsNullOrWhiteSpace(_orderCode)
            && string.IsNullOrWhiteSpace(_phoneNumber)
            && string.IsNullOrWhiteSpace(_name))
        {
            _snackbar.Add("Vui lòng nhập mã đơn, số điện thoại hoặc tên người nhận", Severity.Warning);
            return;
        }

        _isSearching = true;
        _hasSearched = true;
        _selectedOrder = null;

        if (!string.IsNullOrWhiteSpace(_phoneNumber))
        {
            _lastLookupPhone = _phoneNumber.Trim();
        }

        StateHasChanged();

        var result = await _customerOrderService.LookupOrdersAsync(
            orderCode: string.IsNullOrWhiteSpace(_orderCode) ? null : _orderCode.Trim(),
            name: string.IsNullOrWhiteSpace(_name) ? null : _name.Trim(),
            phoneNumber: string.IsNullOrWhiteSpace(_phoneNumber) ? null : _phoneNumber.Trim(),
            requireAuth: false);

        if (!result.Success)
        {
            _snackbar.Add(
                string.IsNullOrWhiteSpace(result.Message)
                    ? "Không thể tra cứu đơn hàng"
                    : result.Message,
                Severity.Error);
            _orders = new();
        }
        else
        {
            _orders = (result.Data ?? new())
                .OrderByDescending(x => x.OrderDate)
                .ToList();
        }

        _isSearching = false;
    }

    private void ResetSearch()
    {
        _orderCode = string.Empty;
        _phoneNumber = string.Empty;
        _name = string.Empty;
        _orders = new();
        _hasSearched = false;
        _selectedOrder = null;
        _lastLookupPhone = string.Empty;
    }

    private static bool IsCancellableStatus(UserOrderDetailResponse order)
    {
        if (order.Status is Constant.OrderStatus.Code.Pending
            or Constant.OrderStatus.Code.Processing
            or Constant.OrderStatus.Code.WaitingForPayment
            or Constant.OrderStatus.Code.Confirmed)
        {
            return true;
        }

        return order.OrderStatus is Constant.OrderStatus.Pending
            or Constant.OrderStatus.Processing
            or Constant.OrderStatus.WaitingForPayment
            or Constant.OrderStatus.Confirmed;
    }

    private static bool CanCancelOrder(UserOrderDetailResponse order) => IsCancellableStatus(order);

    private string? ResolveCancelPhone(UserOrderDetailResponse order)
    {
        if (!string.IsNullOrWhiteSpace(_lastLookupPhone))
        {
            return _lastLookupPhone;
        }

        if (!string.IsNullOrWhiteSpace(_phoneNumber))
        {
            return _phoneNumber.Trim();
        }

        if (!string.IsNullOrWhiteSpace(order.ReceiverPhone))
        {
            return order.ReceiverPhone.Trim();
        }

        return null;
    }

    private async Task CancelGuestOrderAsync(UserOrderDetailResponse order)
    {
        if (!CanCancelOrder(order) || _isCancelling)
        {
            return;
        }

        var phoneNumber = ResolveCancelPhone(order);
        if (string.IsNullOrWhiteSpace(phoneNumber))
        {
            _snackbar.Add("Vui lòng nhập số điện thoại đã dùng khi đặt hàng để hủy đơn", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters<OrderCancelDialog>
        {
            { x => x.OrderCode, order.OrderCode },
            { x => x.ReasonOptions, Constant.OrderCancelReason.Customer }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialog = await _dialogService.ShowAsync<OrderCancelDialog>(
            "Hủy đơn hàng",
            parameters,
            options);

        var dialogResult = await dialog.Result;
        if (dialogResult is null || dialogResult.Canceled || dialogResult.Data is not CancelOrderDialogResult cancelData)
        {
            return;
        }

        _isCancelling = true;
        StateHasChanged();

        try
        {
            var result = await _customerOrderService.CancelGuestOrderAsync(new GuestCancelOrderRequest
            {
                OrderCode = order.OrderCode,
                PhoneNumber = phoneNumber,
                CancelReason = cancelData.CancelReason,
                CancelDetail = cancelData.CancelDetail
            });

            if (!result.Success || result.Data is null)
            {
                _snackbar.Add(
                    string.IsNullOrWhiteSpace(result.Message)
                        ? "Không thể hủy đơn hàng"
                        : result.Message,
                    Severity.Error);
                return;
            }

            _snackbar.Add("Đã hủy đơn hàng thành công", Severity.Success);

            var updated = result.Data;
            var index = _orders.FindIndex(x => x.Id == updated.Id || x.OrderCode == updated.OrderCode);
            if (index >= 0)
            {
                _orders[index] = updated;
            }

            if (_selectedOrder is not null
                && (_selectedOrder.Id == updated.Id || _selectedOrder.OrderCode == updated.OrderCode))
            {
                _selectedOrder = updated;
            }
        }
        finally
        {
            _isCancelling = false;
            StateHasChanged();
        }
    }

    private void SelectOrder(UserOrderDetailResponse order)
    {
        _selectedOrder = order;
    }

    private void ClearSelectedOrder()
    {
        _selectedOrder = null;
    }

    private static bool CanPayOnline(UserOrderDetailResponse order)
    {
        return !string.IsNullOrWhiteSpace(order.PaymentLink)
               && order.PaymentStatus == Constant.PaymentStatus.Pending
               && order.OrderStatus is Constant.OrderStatus.WaitingForPayment
                   or Constant.OrderStatus.Pending
                   or Constant.OrderStatus.Processing;
    }

    private void OpenPaymentLink(UserOrderDetailResponse order)
    {
        if (string.IsNullOrWhiteSpace(order.PaymentLink))
        {
            return;
        }

        _navigation.NavigateTo(order.PaymentLink, forceLoad: true);
    }

    private static bool IsGuestCustomer(UserOrderDetailResponse order)
    {
        return string.Equals(order.CustomerType, "Guest", StringComparison.OrdinalIgnoreCase)
               || string.Equals(order.CustomerType, "GuestOrder", StringComparison.OrdinalIgnoreCase)
               || string.Equals(order.ReceiverName, "Khách vãng lai", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsInStoreFulfillment(UserOrderDetailResponse order)
    {
        return order.BOPIS == true
               || (order.IsOrderPOS && order.ShippingFee <= 0)
               || (order.ShippingFee <= 0
                   && !string.IsNullOrWhiteSpace(order.PurchaseChannel)
                   && (order.PurchaseChannel.Contains("POS", StringComparison.OrdinalIgnoreCase)
                       || order.PurchaseChannel.Contains("cửa hàng", StringComparison.OrdinalIgnoreCase)
                       || order.PurchaseChannel.Contains("quầy", StringComparison.OrdinalIgnoreCase)));
    }

    private static bool IsGuestInStoreOrder(UserOrderDetailResponse order) =>
        IsGuestCustomer(order) && IsInStoreFulfillment(order);

    private static string GetGuestInStoreLabel(UserOrderDetailResponse order) =>
        order.BOPIS == true ? "lấy tại quầy" : "mua tại quầy";

    private RenderFragment RenderOrderDetail(UserOrderDetailResponse order) => __builder =>
    {
        <div class="!mt-4 !space-y-6">
            <div class="grid !gap-4 md:grid-cols-3">
                <div class="!rounded-3xl !border !border-slate-200 !bg-white !p-5 shadow-sm">
                    <p class="text-xs font-bold tracking-wide text-slate-400 uppercase">Ngày đặt</p>
                    <p class="!mt-2 text-sm font-black text-slate-950">@order.OrderDate.ToString("HH:mm dd/MM/yyyy")</p>
                </div>
                <div class="!rounded-3xl !border !border-slate-200 !bg-white !p-5 shadow-sm">
                    <p class="text-xs font-bold tracking-wide text-slate-400 uppercase">Trạng thái đơn</p>
                    <p class="!mt-2 text-sm font-black text-slate-950">@order.OrderStatus</p>
                </div>
                <div class="!rounded-3xl !border !border-slate-200 !bg-white !p-5 shadow-sm">
                    <p class="text-xs font-bold tracking-wide text-slate-400 uppercase">Thanh toán</p>
                    <p class="!mt-2 text-sm font-black text-slate-950">@order.PaymentStatus</p>
                </div>
            </div>

            <div class="!rounded-3xl !border !border-slate-200 !bg-white !p-6 shadow-sm">
                <h2 class="text-lg font-black text-slate-950">Thông tin nhận hàng</h2>
                <div class="!mt-4 !space-y-2 text-sm">
                    @if (IsGuestInStoreOrder(order))
                    {
                        <p class="font-black text-slate-950">
                            Khách vãng lai - @GetGuestInStoreLabel(order)
                        </p>
                    }
                    else
                    {
                        <p class="font-black text-slate-950">@order.ReceiverName · @order.ReceiverPhone</p>
                        <p class="leading-6 text-slate-500">@order.FullAddress</p>
                    }
                </div>
            </div>

            <div class="overflow-hidden !rounded-3xl !border !border-slate-200 !bg-white shadow-sm">
                <div class="!border-b !border-slate-200 !bg-slate-50 !px-6 !py-4">
                    <h2 class="text-lg font-black text-slate-950">Sản phẩm</h2>
                </div>
                <div class="divide-y divide-slate-200">
                    @foreach (var item in order.OrderItems)
                    {
                        <div class="flex flex-col !gap-3 !p-5 md:!px-6 md:flex-row md:items-center md:justify-between">
                            <div class="min-w-0 flex-1">
                                <p class="font-black text-slate-950">@item.ProductName</p>
                                <p class="!mt-1 text-sm font-semibold text-slate-500">@item.VariantName</p>
                            </div>
                            <div class="flex items-center justify-between !gap-6 text-sm md:justify-end">
                                <span class="font-semibold text-slate-500">
                                    @FormatMoney(item.UnitPrice) × @item.Quantity
                                </span>
                                <span class="font-black text-[#d71920]">@FormatMoney(item.Subtotal)</span>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="!rounded-3xl !border !border-slate-200 !bg-white !p-6 shadow-sm">
                <div class="!space-y-3 text-sm">
                    <div class="flex items-center justify-between">
                        <span class="font-semibold text-slate-500">Tạm tính</span>
                        <span class="font-black text-slate-950">@FormatMoney(order.TotalPrice)</span>
                    </div>
                    @if (order.DiscountAmount > 0)
                    {
                        <div class="flex items-center justify-between">
                            <span class="font-semibold text-slate-500">Giảm giá</span>
                            <span class="font-black text-[#d71920]">-@FormatMoney(order.DiscountAmount)</span>
                        </div>
                    }
                    @if (order.PointsDiscount > 0)
                    {
                        <div class="flex items-center justify-between">
                            <span class="font-semibold text-slate-500">
                                Giảm từ điểm@(order.PointsUsed > 0 ? $" ({order.PointsUsed:N0} điểm)" : "")
                            </span>
                            <span class="font-black text-[#d71920]">-@FormatMoney(order.PointsDiscount)</span>
                        </div>
                    }
                    <div class="flex items-center justify-between">
                        <span class="font-semibold text-slate-500">Phí vận chuyển</span>
                        <span class="font-black text-slate-950">@FormatMoney(order.ShippingFee)</span>
                    </div>
                    <div class="!border-t !border-slate-200 !pt-4">
                        <div class="flex items-end justify-between">
                            <span class="text-base font-black text-slate-950">Tổng cộng</span>
                            <span class="text-2xl font-black text-[#d71920]">@FormatMoney(order.FinalPrice)</span>
                        </div>
                    </div>
                </div>
            </div>

            @{
                var statusHistory = ParseStatusHistory(order.StatusHistory);
            }
            @if (statusHistory.Count > 0)
            {
                <div class="!rounded-3xl !border !border-slate-200 !bg-white !p-6 shadow-sm">
                    <h2 class="text-lg font-black text-slate-950">Lịch sử đơn hàng</h2>

                    <div class="!mt-4 !space-y-3">
                        @foreach (var entry in statusHistory.OrderByDescending(e => e.Index))
                        {
                            <div class="flex flex-col !gap-1 !rounded-2xl !bg-slate-50 !p-4 md:flex-row md:items-start md:justify-between">
                                <div class="!space-y-1">
                                    <p class="font-black text-slate-950">@entry.OrderStatus</p>
                                    <p class="text-sm text-slate-500">Thanh toán: @entry.PaymentStatus</p>
                                    @if (ShouldShowCancelReason(entry) && !string.IsNullOrWhiteSpace(entry.Reasons))
                                    {
                                        <p class="text-sm text-slate-700">
                                            <span class="font-semibold text-slate-500">Lý do:</span>
                                            @entry.Reasons
                                        </p>
                                    }
                                </div>
                                <span class="shrink-0 text-sm text-slate-400">@entry.DateTime</span>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (CanPayOnline(order))
            {
                <button type="button"
                        @onclick="() => OpenPaymentLink(order)"
                        class="inline-flex items-center justify-center !gap-2 !rounded-full !border !border-black !bg-black !px-6 !py-3 text-sm font-black !text-white transition hover:!border-[#d71920] hover:!bg-[#d71920]">
                    <MudIcon Icon="@Icons.Material.Filled.Payment" Size="Size.Small" />
                    Thanh toán ngay
                </button>
            }

            @if (CanCancelOrder(order))
            {
                <button type="button"
                        @onclick="() => CancelGuestOrderAsync(order)"
                        disabled="@_isCancelling"
                        class="inline-flex items-center justify-center !gap-2 !rounded-full !border !border-red-200 !bg-red-50 !px-6 !py-3 text-sm font-black text-[#d71920] transition hover:!border-[#d71920] disabled:opacity-50">
                    <MudIcon Icon="@Icons.Material.Filled.Cancel" Size="Size.Small" />
                    Hủy đơn hàng
                </button>
            }
        </div>
    };

    private static string GetStatusBadgeClass(string status)
    {
        var color = status switch
        {
            Constant.OrderStatus.Done or Constant.OrderStatus.ShippingDone => "!bg-green-50 !text-green-700",
            Constant.OrderStatus.Cancelled or Constant.OrderStatus.DeliveryFailed or Constant.OrderStatus.Expired => "!bg-red-50 !text-[#d71920]",
            Constant.OrderStatus.WaitingForPayment or Constant.OrderStatus.Pending or Constant.OrderStatus.Processing => "!bg-amber-50 !text-amber-700",
            _ => "!bg-slate-100 !text-slate-600"
        };

        return $"!rounded-full !px-2.5 !py-0.5 text-xs font-black {color}";
    }

    private static string GetPaymentBadgeClass(string status)
    {
        var color = status switch
        {
            Constant.PaymentStatus.Completed => "!bg-green-50 !text-green-700",
            Constant.PaymentStatus.Cancelled => "!bg-red-50 !text-[#d71920]",
            _ => "!bg-amber-50 !text-amber-700"
        };

        return $"!rounded-full !px-2.5 !py-0.5 text-xs font-black {color}";
    }

    private static string FormatMoney(decimal value) => $"{value:N0} đ";

    private static bool ShouldShowCancelReason(StatusHistoryEntryResponse entry)
    {
        var status = string.IsNullOrWhiteSpace(entry.OrderStatus) ? entry.Status : entry.OrderStatus;
        return status is Constant.OrderStatus.Cancelled
            or Constant.OrderStatus.DeliveryFailed
            or "Đã hủy"
            or "Cancelled"
            or "Đã hủy bởi người dùng";
    }

    private static List<StatusHistoryEntryResponse> ParseStatusHistory(string? json)
    {
        if (string.IsNullOrWhiteSpace(json))
        {
            return new List<StatusHistoryEntryResponse>();
        }

        try
        {
            return JsonSerializer.Deserialize<List<StatusHistoryEntryResponse>>(json, StatusHistoryJsonOptions)
                ?? new List<StatusHistoryEntryResponse>();
        }
        catch
        {
            return new List<StatusHistoryEntryResponse>();
        }
    }
}
