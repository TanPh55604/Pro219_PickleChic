@attribute [Route(RouterConfig.Customer.OrderDetail)]
@layout MainLayout
@using System.Text.Json

<PageTitle>PickleChic WEB - Hóa đơn</PageTitle>

<div class="min-h-[calc(100vh-180px)] !bg-slate-50 !px-4 !pt-8 !pb-14">
    <div class="mx-auto w-full max-w-4xl">
        <div class="flex flex-col !gap-4 md:flex-row md:items-center md:justify-between">
            <div>
                <p class="text-sm font-bold tracking-[0.25em] text-[#d71920] uppercase">
                    Hóa đơn đơn hàng
                </p>

                <h1 class="!mt-2 text-3xl font-black tracking-tight text-slate-950">
                    @(_order?.OrderCode ?? "Chi tiết đơn hàng")
                </h1>
            </div>

            <div class="flex flex-wrap items-center !gap-3">
                <a href="@RouterConfig.Customer.Orders"
                   class="inline-flex items-center justify-center !gap-2 !rounded-full !border !border-slate-300 !bg-white !px-5 !py-2.5 text-sm font-black text-slate-900 transition hover:!border-[#d71920] hover:!text-[#d71920]">
                    <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" />
                    Đơn hàng của tôi
                </a>

                @if (CanCancelOrder)
                {
                    <button type="button"
                            disabled="@_isCancelling"
                            @onclick="CancelOrderAsync"
                            class="inline-flex items-center justify-center !gap-2 !rounded-full !border !border-[#d71920] !bg-white !px-5 !py-2.5 text-sm font-black text-[#d71920] transition hover:!bg-[#d71920] hover:!text-white disabled:opacity-50">
                        @if (_isCancelling)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="!text-[#d71920]" />
                            <span>Đang hủy...</span>
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Cancel" Size="Size.Small" />
                            <span>Hủy đơn hàng</span>
                        }
                    </button>
                }

                <a href="@RouterConfig.Customer.Products"
                   class="inline-flex items-center justify-center !gap-2 !rounded-full !border !border-slate-300 !bg-white !px-5 !py-2.5 text-sm font-black text-slate-900 transition hover:!border-[#d71920] hover:!text-[#d71920]">
                    <MudIcon Icon="@Icons.Material.Filled.ShoppingBag" Size="Size.Small" />
                    Tiếp tục mua sắm
                </a>
            </div>
        </div>

        @if (_isLoading)
        {
            <div class="!mt-10 flex justify-center !py-16">
                <MudProgressCircular Color="Color.Error" Indeterminate="true" />
            </div>
        }
        else if (_order is null)
        {
            <div class="!mt-8 !rounded-3xl !border !border-slate-200 !bg-white !p-10 text-center shadow-sm">
                <div class="mx-auto flex !h-16 !w-16 items-center justify-center !rounded-full !bg-slate-100 text-slate-400">
                    <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Size="Size.Large" />
                </div>

                <h2 class="!mt-5 text-2xl font-black text-slate-950">
                    Không tìm thấy hóa đơn
                </h2>

                <p class="!mt-2 text-sm text-slate-500">
                    @(_errorMessage ?? "Đơn hàng không tồn tại hoặc bạn không có quyền xem.")
                </p>
            </div>
        }
        else
        {
            <div class="!mt-8 !space-y-6">
                @if (CanPayOnline)
                {
                    <div class="flex flex-col !gap-4 !rounded-3xl !border !border-amber-200 !bg-amber-50 !p-5 sm:flex-row sm:items-center sm:justify-between">
                        <div>
                            <p class="text-sm font-black text-amber-900">
                                Đơn hàng chưa thanh toán
                            </p>
                            @if (_order.PaymentExpiration.HasValue)
                            {
                                <p class="!mt-1 text-sm text-amber-800">
                                    Hết hạn thanh toán: @_order.PaymentExpiration.Value.ToString("HH:mm dd/MM/yyyy")
                                </p>
                            }
                        </div>

                        <button type="button"
                                @onclick="OpenPaymentLink"
                                class="inline-flex shrink-0 items-center justify-center !gap-2 !rounded-full !border !border-black !bg-black !px-5 !py-2.5 text-sm font-black !text-white transition hover:!border-[#d71920] hover:!bg-[#d71920]">
                            <MudIcon Icon="@Icons.Material.Filled.Payment" Size="Size.Small" />
                            Thanh toán ngay
                        </button>
                    </div>
                }
                <div class="grid !gap-4 md:grid-cols-3">
                    <div class="!rounded-3xl !border !border-slate-200 !bg-white !p-5 shadow-sm">
                        <p class="text-xs font-bold tracking-wide text-slate-400 uppercase">Ngày đặt</p>
                        <p class="!mt-2 text-sm font-black text-slate-950">@_order.OrderDate.ToString("HH:mm dd/MM/yyyy")</p>
                    </div>

                    <div class="!rounded-3xl !border !border-slate-200 !bg-white !p-5 shadow-sm">
                        <p class="text-xs font-bold tracking-wide text-slate-400 uppercase">Trạng thái đơn</p>
                        <p class="!mt-2 text-sm font-black text-slate-950">@_order.OrderStatus</p>
                    </div>

                    <div class="!rounded-3xl !border !border-slate-200 !bg-white !p-5 shadow-sm">
                        <p class="text-xs font-bold tracking-wide text-slate-400 uppercase">Thanh toán</p>
                        <p class="!mt-2 text-sm font-black text-slate-950">@_order.PaymentStatus</p>
                    </div>
                </div>

                <div class="!rounded-3xl !border !border-slate-200 !bg-white !p-6 shadow-sm">
                    <h2 class="text-lg font-black text-slate-950">Thông tin nhận hàng</h2>

                    <div class="!mt-4 !space-y-2 text-sm">
                        @if (IsInStoreFulfillment)
                        {
                            <p class="font-black text-slate-950">@InStoreReceiverSummary</p>
                        }
                        else
                        {
                            <p class="font-black text-slate-950">@_order.ReceiverName · @_order.ReceiverPhone</p>
                            <p class="leading-6 text-slate-500">@_order.FullAddress</p>
                        }

                        @if (!string.IsNullOrWhiteSpace(_order.Notes))
                        {
                            <p class="!mt-3 text-slate-500">
                                <span class="font-black text-slate-950">Ghi chú:</span> @_order.Notes
                            </p>
                        }
                    </div>
                </div>

                <div class="overflow-hidden !rounded-3xl !border !border-slate-200 !bg-white shadow-sm">
                    <div class="!border-b !border-slate-200 !bg-slate-50 !px-6 !py-4">
                        <h2 class="text-lg font-black text-slate-950">Sản phẩm</h2>
                    </div>

                    <div class="divide-y divide-slate-200">
                        @foreach (var item in _order.OrderItems)
                        {
                            <div class="flex flex-col !gap-3 !p-5 md:!px-6 md:flex-row md:items-center md:justify-between">
                                <div class="min-w-0 flex-1">
                                    <p class="font-black text-slate-950">@item.ProductName</p>
                                    <p class="!mt-1 text-sm font-semibold text-slate-500">@item.VariantName</p>

                                    @if (item.Attributes.Any())
                                    {
                                        <p class="!mt-1 text-xs text-slate-400">
                                            @string.Join(" · ", item.Attributes)
                                        </p>
                                    }
                                </div>

                                <div class="flex items-center justify-between !gap-6 text-sm md:justify-end">
                                    <span class="font-semibold text-slate-500">
                                        @FormatMoney(item.UnitPrice) × @item.Quantity
                                    </span>
                                    <span class="font-black text-[#d71920]">
                                        @FormatMoney(item.Subtotal)
                                    </span>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="!rounded-3xl !border !border-slate-200 !bg-white !p-6 shadow-sm">
                    <div class="!space-y-3 text-sm">
                        <div class="flex items-center justify-between">
                            <span class="font-semibold text-slate-500">Tạm tính</span>
                            <span class="font-black text-slate-950">@FormatMoney(_order.TotalPrice)</span>
                        </div>

                        <div class="flex items-center justify-between">
                            <span class="font-semibold text-slate-500">Giảm giá</span>
                            <span class="font-black text-[#d71920]">-@FormatMoney(_order.DiscountAmount)</span>
                        </div>

                        <div class="flex items-center justify-between">
                            <span class="font-semibold text-slate-500">Phí vận chuyển</span>
                            <span class="font-black text-slate-950">@FormatMoney(_order.ShippingFee)</span>
                        </div>

                        <div class="!border-t !border-slate-200 !pt-4">
                            <div class="flex items-end justify-between">
                                <span class="text-base font-black text-slate-950">Tổng cộng</span>
                                <span class="text-2xl font-black text-[#d71920]">@FormatMoney(_order.FinalPrice)</span>
                            </div>
                        </div>
                    </div>
                </div>

                @if (_statusHistory.Count > 0)
                {
                    <div class="!rounded-3xl !border !border-slate-200 !bg-white !p-6 shadow-sm">
                        <h2 class="text-lg font-black text-slate-950">Lịch sử đơn hàng</h2>

                        <div class="!mt-4 !space-y-3">
                            @foreach (var entry in _statusHistory.OrderByDescending(e => e.Index))
                            {
                                <div class="flex flex-col !gap-1 !rounded-2xl !bg-slate-50 !p-4 md:flex-row md:items-start md:justify-between">
                                    <div class="!space-y-1">
                                        <p class="font-black text-slate-950">@entry.OrderStatus</p>
                                        <p class="text-sm text-slate-500">Thanh toán: @entry.PaymentStatus</p>
                                        @if (ShouldShowCancelReason(entry) && !string.IsNullOrWhiteSpace(entry.Reasons))
                                        {
                                            <p class="text-sm text-slate-700">
                                                <span class="font-semibold text-slate-500">Lý do:</span>
                                                @entry.Reasons
                                            </p>
                                        }
                                    </div>
                                    <span class="shrink-0 text-sm text-slate-400">@entry.DateTime</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private static readonly JsonSerializerOptions StatusHistoryJsonOptions = new()
    {
        PropertyNameCaseInsensitive = true
    };

    [Parameter]
    public int Id { get; set; }

    private UserOrderDetailResponse? _order;
    private List<StatusHistoryEntryResponse> _statusHistory = new();
    private bool _isLoading = true;
    private bool _isCancelling;
    private string? _errorMessage;

    private bool CanPayOnline =>
        _order is not null
        && !string.IsNullOrWhiteSpace(_order.PaymentLink)
        && _order.PaymentStatus == Constant.PaymentStatus.Pending
        && IsCancellableStatus(_order);

    private bool CanCancelOrder =>
        _order is not null
        && IsCancellableStatus(_order);

    private bool IsGuestCustomer =>
        _order is not null
        && (string.Equals(_order.CustomerType, "Guest", StringComparison.OrdinalIgnoreCase)
            || string.Equals(_order.CustomerType, "GuestOrder", StringComparison.OrdinalIgnoreCase)
            || string.Equals(_order.ReceiverName, "Khách vãng lai", StringComparison.OrdinalIgnoreCase));

    private bool IsInStoreFulfillment =>
        _order is not null
        && (_order.BOPIS == true
            || (_order.IsOrderPOS && _order.ShippingFee <= 0)
            || string.Equals(_order.ReceiverName, "Nhận tại quầy", StringComparison.OrdinalIgnoreCase)
            || string.Equals(_order.ReceiverName, "Khách vãng lai", StringComparison.OrdinalIgnoreCase)
            || (_order.ShippingFee <= 0
                && !string.IsNullOrWhiteSpace(_order.PurchaseChannel)
                && (_order.PurchaseChannel.Contains("POS", StringComparison.OrdinalIgnoreCase)
                    || _order.PurchaseChannel.Contains("cửa hàng", StringComparison.OrdinalIgnoreCase)
                    || _order.PurchaseChannel.Contains("quầy", StringComparison.OrdinalIgnoreCase))));

    private string InStoreReceiverSummary
    {
        get
        {
            var label = _order?.BOPIS == true ? "lấy tại quầy" : "mua tại quầy";
            return IsGuestCustomer
                ? $"Khách vãng lai - {label}"
                : $"Nhận tại quầy - {label}";
        }
    }

    private static bool IsCancellableStatus(UserOrderDetailResponse order)
    {
        if (order.Status is Constant.OrderStatus.Code.Pending
            or Constant.OrderStatus.Code.Processing
            or Constant.OrderStatus.Code.WaitingForPayment)
        {
            return true;
        }

        return order.OrderStatus is Constant.OrderStatus.Pending
            or Constant.OrderStatus.Processing
            or Constant.OrderStatus.WaitingForPayment;
    }

    protected override async Task OnInitializedAsync()
    {
        if (!await _authStorageService.IsAuthenticatedAsync())
        {
            _navigation.NavigateTo(RouterConfig.Customer.Login);
            return;
        }

        await LoadOrderAsync();
    }

    private async Task LoadOrderAsync()
    {
        _isLoading = true;

        var result = await _customerOrderService.GetUserOrderDetailAsync(Id);

        if (!result.Success || result.Data is null)
        {
            _errorMessage = string.IsNullOrWhiteSpace(result.Message)
                ? "Không thể tải hóa đơn."
                : result.Message;
            _order = null;
            _statusHistory = new();
        }
        else
        {
            _order = result.Data;
            _statusHistory = ParseStatusHistory(_order.StatusHistory);
            _errorMessage = null;
        }

        _isLoading = false;
    }

    private async Task CancelOrderAsync()
    {
        if (_order is null || !CanCancelOrder || _isCancelling)
        {
            return;
        }

        var parameters = new DialogParameters<OrderCancelDialog>
        {
            { x => x.OrderCode, _order.OrderCode },
            { x => x.ReasonOptions, Constant.OrderCancelReason.Customer }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialog = await _dialogService.ShowAsync<OrderCancelDialog>(
            "Hủy đơn hàng",
            parameters,
            options);

        var dialogResult = await dialog.Result;
        if (dialogResult is null || dialogResult.Canceled || dialogResult.Data is not CancelOrderDialogResult cancelData)
        {
            return;
        }

        _isCancelling = true;
        StateHasChanged();

        try
        {
            var requireAuth = await _authStorageService.IsAuthenticatedAsync();
            var result = await _customerOrderService.CancelUserOrderAsync(
                _order.Id,
                new CancelOrderRequest
                {
                    CancelReason = cancelData.CancelReason,
                    CancelDetail = cancelData.CancelDetail
                },
                requireAuth: requireAuth);

            if (!result.Success || result.Data is null)
            {
                _snackbar.Add(
                    string.IsNullOrWhiteSpace(result.Message)
                        ? "Không thể hủy đơn hàng"
                        : result.Message,
                    Severity.Error);
                return;
            }

            _order = result.Data;
            _statusHistory = ParseStatusHistory(_order.StatusHistory);
            _snackbar.Add($"Đã hủy đơn {_order.OrderCode}", Severity.Success);
        }
        finally
        {
            _isCancelling = false;
        }
    }

    private void OpenPaymentLink()
    {
        if (_order is null || string.IsNullOrWhiteSpace(_order.PaymentLink))
        {
            return;
        }

        _navigation.NavigateTo(_order.PaymentLink, forceLoad: true);
    }

    private static bool ShouldShowCancelReason(StatusHistoryEntryResponse entry)
    {
        var status = string.IsNullOrWhiteSpace(entry.OrderStatus) ? entry.Status : entry.OrderStatus;
        return status is Constant.OrderStatus.Cancelled
            or "Đã hủy"
            or "Cancelled"
            or "Đã hủy bởi người dùng";
    }

    private static List<StatusHistoryEntryResponse> ParseStatusHistory(string? json)
    {
        if (string.IsNullOrWhiteSpace(json))
        {
            return new List<StatusHistoryEntryResponse>();
        }

        try
        {
            return JsonSerializer.Deserialize<List<StatusHistoryEntryResponse>>(json, StatusHistoryJsonOptions)
                ?? new List<StatusHistoryEntryResponse>();
        }
        catch
        {
            return new List<StatusHistoryEntryResponse>();
        }
    }

    private static string FormatMoney(decimal value)
    {
        return $"{value:N0} đ";
    }
}
