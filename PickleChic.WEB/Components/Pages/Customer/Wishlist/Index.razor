@attribute [Route(RouterConfig.Customer.Wishlists)]
@layout MainLayout

<PageTitle>PickleChic WEB - Wishlist</PageTitle>

<div class="min-h-[calc(100vh-180px)] !bg-slate-50 !px-4 !pt-8 !pb-14">
    <div class="mx-auto w-full max-w-7xl">
        <div class="flex flex-col !gap-4 md:flex-row md:items-center md:justify-between">
            <div>
                <p class="text-sm font-bold tracking-[0.25em] text-[#d71920] uppercase">
                    Tài khoản
                </p>

                <h1 class="!mt-2 text-3xl font-black tracking-tight text-slate-950">
                    Sản phẩm yêu thích
                </h1>

                <p class="!mt-2 text-sm text-slate-500">
                    Danh sách sản phẩm bạn đã lưu để xem lại sau
                </p>
            </div>

            <a href="@RouterConfig.Customer.Products"
               class="inline-flex items-center justify-center !gap-2 !rounded-full !border !border-slate-300 !bg-white !px-5 !py-2.5 text-sm font-black text-slate-900 transition hover:!border-[#d71920] hover:!text-[#d71920]">
                <MudIcon Icon="@Icons.Material.Filled.ShoppingBag" Size="Size.Small" />
                Tiếp tục mua sắm
            </a>
        </div>

        @if (_isLoading)
        {
            <div class="!mt-10 flex justify-center !py-16">
                <MudProgressCircular Color="Color.Error" Indeterminate="true" />
            </div>
        }
        else if (!_isAuthenticated)
        {
            <div class="!mt-8 !rounded-3xl !border !border-slate-200 !bg-white !p-10 text-center shadow-sm">
                <div class="mx-auto flex !h-16 !w-16 items-center justify-center !rounded-full !bg-slate-100 text-slate-400">
                    <MudIcon Icon="@Icons.Material.Filled.Login" Size="Size.Large" />
                </div>

                <h2 class="!mt-5 text-2xl font-black text-slate-950">
                    Đăng nhập để xem yêu thích
                </h2>

                <p class="!mt-2 text-sm text-slate-500">
                    Vui lòng đăng nhập để quản lý danh sách sản phẩm yêu thích.
                </p>

                <a href="@RouterConfig.Customer.Login"
                   class="!mt-6 inline-flex items-center justify-center !rounded-full !bg-black !px-7 !py-3 text-sm font-black !text-white transition hover:!bg-[#d71920]">
                    Đăng nhập
                </a>
            </div>
        }
        else if (_cards.Count == 0)
        {
            <div class="!mt-8 !rounded-3xl !border !border-slate-200 !bg-white !p-10 text-center shadow-sm">
                <div class="mx-auto flex !h-16 !w-16 items-center justify-center !rounded-full !bg-slate-100 text-slate-400">
                    <MudIcon Icon="@Icons.Material.Filled.FavoriteBorder" Size="Size.Large" />
                </div>

                <h2 class="!mt-5 text-2xl font-black text-slate-950">
                    Chưa có sản phẩm yêu thích
                </h2>

                <p class="!mt-2 text-sm text-slate-500">
                    Hãy nhấn ♥ trên trang sản phẩm để lưu lại tại đây.
                </p>

                <a href="@RouterConfig.Customer.Products"
                   class="!mt-6 inline-flex items-center justify-center !rounded-full !bg-black !px-7 !py-3 text-sm font-black !text-white transition hover:!bg-[#d71920]">
                    Khám phá sản phẩm
                </a>
            </div>
        }
        else
        {
            <div class="!mt-8 grid !gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
                @foreach (var item in _cards)
                {
                    <div class="relative">
                        <CustomerProductCard Item="@item.Card" ShowStockStatus="true" />

                        <button type="button"
                                @onclick="() => RemoveAsync(item)"
                                disabled="@_isBusy"
                                title="Bỏ yêu thích"
                                class="absolute top-3 right-3 z-20 inline-flex !h-10 !w-10 items-center justify-center !rounded-full !border !border-white/80 !bg-white/95 text-[#d71920] shadow-sm transition hover:!bg-[#d71920] hover:!text-white disabled:opacity-50">
                            <MudIcon Icon="@Icons.Material.Filled.Favorite" Size="Size.Small" />
                        </button>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private bool _isLoading = true;
    private bool _isAuthenticated;
    private bool _isBusy;
    private List<WishlistCardItem> _cards = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            _isAuthenticated = await _authStorageService.IsAuthenticatedAsync();
            if (!_isAuthenticated)
            {
                _cards = new();
                return;
            }

            var productsTask = _customerWishlistService.GetMyProductsAsync();
            var entriesTask = _customerWishlistService.GetMyEntriesAsync();
            await Task.WhenAll(productsTask, entriesTask);

            var productsResult = await productsTask;
            var entriesResult = await entriesTask;

            if (!productsResult.Success)
            {
                _snackbar.Add(
                    string.IsNullOrWhiteSpace(productsResult.Message)
                        ? "Không thể tải danh sách yêu thích"
                        : productsResult.Message,
                    Severity.Error);
                _cards = new();
                return;
            }

            var entries = entriesResult.Success
                ? entriesResult.Data ?? new List<WishlistItemResponse>()
                : new List<WishlistItemResponse>();

            _cards = (productsResult.Data ?? new List<WishlistProductResponse>())
                .Select(p =>
                {
                    var variant = p.ProductVariants
                        .Where(v => v.Status != -1)
                        .OrderByDescending(v => v.StockQuantity > 0)
                        .ThenBy(v => v.Price)
                        .FirstOrDefault();

                    var wishlistId = entries.FirstOrDefault(e => e.ProductId == p.Id)?.Id;

                    return new WishlistCardItem
                    {
                        ProductId = p.Id,
                        WishlistId = wishlistId,
                        Card = new ProductCardModel
                        {
                            ProductId = p.Id,
                            VariantId = variant?.Id ?? 0,
                            Name = string.IsNullOrWhiteSpace(variant?.VariantName)
                                ? p.ProductName
                                : $"{p.ProductName} - {variant!.VariantName}",
                            ImageUrl = variant?.Images.FirstOrDefault(i => i.IsMain)?.URL
                                       ?? variant?.Images.FirstOrDefault()?.URL,
                            Price = variant?.Price ?? 0,
                            BrandName = p.BrandName,
                            CategoryName = p.CategoryName,
                            InStock = variant is { StockQuantity: > 0, Status: not -1 },
                            StockQuantity = variant?.StockQuantity ?? 0,
                            Tag = variant is { StockQuantity: > 0, Status: not -1 } ? null : "Hết hàng"
                        }
                    };
                })
                .ToList();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RemoveAsync(WishlistCardItem item)
    {
        if (_isBusy)
        {
            return;
        }

        _isBusy = true;
        try
        {
            var wishlistId = item.WishlistId;
            if (!wishlistId.HasValue)
            {
                var state = await _customerWishlistService.GetFavoriteStateAsync(item.ProductId);
                wishlistId = state.Success ? state.Data.WishlistId : null;
            }

            if (!wishlistId.HasValue)
            {
                _snackbar.Add("Không tìm thấy mục yêu thích để xóa", Severity.Warning);
                return;
            }

            var result = await _customerWishlistService.RemoveAsync(wishlistId.Value);
            if (!result.Success)
            {
                _snackbar.Add(
                    string.IsNullOrWhiteSpace(result.Message)
                        ? "Không thể bỏ yêu thích"
                        : result.Message,
                    Severity.Error);
                return;
            }

            _cards.RemoveAll(x => x.ProductId == item.ProductId);
            _snackbar.Add("Đã bỏ khỏi danh sách yêu thích", Severity.Success);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private sealed class WishlistCardItem
    {
        public int ProductId { get; set; }
        public int? WishlistId { get; set; }
        public ProductCardModel Card { get; set; } = new();
    }
}
