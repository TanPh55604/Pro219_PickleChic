@implements IDisposable

<MudDrawer Open="Open"
           OpenChanged="OnOpenChanged"
           Anchor="Anchor.End"
           Variant="DrawerVariant.Temporary"
           Elevation="8"
           Height="100lvh"
           Width="420px"
           Overlay="true"
           OverlayAutoClose="true"
           Class="!fixed !bg-white">
    <div class="overscroll-hidden flex flex-col">
        <div class="flex shrink-0 items-center justify-between !border-b !border-slate-200 !px-5 !py-4">
            <div>
                <p class="text-xs font-bold tracking-[0.22em] text-[#d71920] uppercase">
                    PickleChic WEB
                </p>

                <h2 class="!mt-1 text-xl font-black text-slate-950">
                    Giỏ hàng
                </h2>
            </div>

            <button type="button"
                    @onclick="Close"
                    class="flex !h-10 !w-10 items-center justify-center !rounded-full !border !border-slate-200 text-slate-600 transition hover:!border-[#d71920] hover:!text-[#d71920]">
                <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
            </button>
        </div>

        @if (_hasLoaded && !_cartItems.Any())
        {
            <div class="flex min-h-0 flex-1 flex-col items-center justify-center !px-6 text-center">
                <div class="flex !h-16 !w-16 items-center justify-center !rounded-full !bg-slate-100 text-slate-400">
                    <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Size="Size.Large" />
                </div>

                <h3 class="!mt-5 text-xl font-black text-slate-950">
                    Giỏ hàng đang trống
                </h3>

                <p class="!mt-2 text-sm leading-6 text-slate-500">
                    Hãy thêm sản phẩm yêu thích vào giỏ hàng của bạn.
                </p>

                <a href="@RouterConfig.Customer.Products"
                   class="!mt-6 inline-flex items-center justify-center !rounded-full !bg-black !px-7 !py-3 text-sm font-black !text-white transition hover:!bg-[#d71920]">
                    Mua sắm ngay
                </a>
            </div>
        }
        else
        {
            <div class="h-[calc(100lvh-365px)] overflow-y-auto !px-5 !py-4 @(IsBusy ? "pointer-events-none opacity-60" : string.Empty)">
                <div class="!space-y-4">
                    @foreach (var item in _cartItems)
                    {
                        <div class="flex !gap-3 !rounded-2xl !border !border-slate-200 !bg-white !p-3">
                            <a href="@item.ProductUrl"
                               class="relative flex !h-[4.25rem] !w-[4.25rem] shrink-0 items-center justify-center overflow-hidden !rounded-xl !border !border-slate-200 !bg-white !p-1.5">
                                @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl"
                                         alt=""
                                         class="max-h-full max-w-full object-contain"
                                         onerror="this.classList.add('hidden'); var f=this.nextElementSibling; if(f) f.classList.remove('hidden');" />
                                    <span class="hidden text-slate-300">
                                        <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Small" />
                                    </span>
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Image"
                                             Class="text-slate-300"
                                             Size="Size.Small" />
                                }
                            </a>

                            <div class="min-w-0 flex-1">
                                <a href="@item.ProductUrl"
                                   class="line-clamp-2 text-sm leading-5 font-black text-slate-950 transition hover:!text-[#d71920]">
                                    @item.Name
                                </a>

                                <p class="!mt-1 text-xs font-semibold text-slate-500">
                                    @item.Variant
                                </p>

                                @if (item.Quantity >= item.StockQuantity)
                                {
                                    <p class="!mt-1 text-xs font-semibold text-[#d71920]">
                                        Tối đa @item.StockQuantity sản phẩm
                                    </p>
                                }

                                <div class="!mt-3 flex items-center justify-between !gap-3">
                                    <p class="text-sm font-black text-[#d71920]">
                                        @FormatMoney(item.Price)
                                    </p>

                                    <button type="button"
                                            disabled="@IsBusy"
                                            @onclick="() => RemoveItemAsync(item)"
                                            class="text-slate-400 transition hover:!text-[#d71920] disabled:opacity-50">
                                        <MudIcon Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small" />
                                    </button>
                                </div>

                                <div class="!mt-3 flex items-center !gap-2">
                                    <button type="button"
                                            disabled="@(IsBusy || item.Quantity <= 1)"
                                            @onclick="() => DecreaseQuantityAsync(item)"
                                            class="flex !h-8 !w-8 items-center justify-center !rounded-full !border !border-slate-300 !bg-white text-slate-900 transition hover:!border-[#d71920] hover:!text-[#d71920] disabled:!cursor-not-allowed disabled:opacity-50">
                                        <MudIcon Icon="@Icons.Material.Filled.Remove" Size="Size.Small" />
                                    </button>

                                    <div class="flex !h-8 !w-10 items-center justify-center !rounded-full !border !border-slate-300 text-sm font-black text-slate-900">
                                        @item.Quantity
                                    </div>

                                    <button type="button"
                                            disabled="@(IsBusy || !item.CanIncrease)"
                                            title="@(item.CanIncrease ? null : "Không đủ số lượng trong kho")"
                                            @onclick="() => IncreaseQuantityAsync(item)"
                                            class="flex !h-8 !w-8 items-center justify-center !rounded-full !border !border-slate-300 !bg-white text-slate-900 transition hover:!border-[#d71920] hover:!text-[#d71920] disabled:!cursor-not-allowed disabled:opacity-50">
                                        <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="shrink-0 !border-t !border-slate-200 !bg-white !p-5">
                <div class="!space-y-3">
                    <div class="flex items-center justify-between text-sm">
                        <span class="font-semibold text-slate-500">Tạm tính</span>
                        <span class="font-black text-slate-950">@FormatMoney(SubTotal)</span>
                    </div>

                    <div class="flex items-center justify-between text-sm">
                        <span class="font-semibold text-slate-500">Phí vận chuyển</span>
                        <span class="font-black text-slate-950">@FormatMoney(0)</span>
                    </div>

                    <div class="!border-t !border-slate-200 !pt-4">
                        <div class="flex items-end justify-between">
                            <span class="text-base font-black text-slate-950">Tổng cộng</span>
                            <span class="text-2xl font-black text-[#d71920]">@FormatMoney(Total)</span>
                        </div>
                    </div>
                </div>

                <div class="!mt-5 !space-y-3">
                    <button type="button"
                            disabled="@IsBusy"
                            @onclick="() => NavigateAndCloseAsync(RouterConfig.Customer.Checkout)"
                            class="inline-flex w-full items-center justify-center !gap-2 !rounded-full !border !border-black !bg-black !px-6 !py-3 text-sm font-black !text-white shadow-sm transition hover:!border-[#d71920] hover:!bg-[#d71920] hover:!text-white">
                        <MudIcon Icon="@Icons.Material.Filled.Payment" Size="Size.Small" />
                        Thanh toán
                    </button>

                    <button type="button"
                            disabled="@IsBusy"
                            @onclick="() => NavigateAndCloseAsync(RouterConfig.Customer.Cart)"
                            class="inline-flex w-full items-center justify-center !gap-2 !rounded-full !border !border-slate-300 !bg-white !px-6 !py-3 text-sm font-black text-slate-900 transition hover:!border-[#d71920] hover:!text-[#d71920]">
                        <MudIcon Icon="@Icons.Material.Filled.ShoppingCartCheckout" Size="Size.Small" />
                        Xem giỏ hàng chi tiết
                    </button>
                </div>
            </div>
        }
    </div>
</MudDrawer>

@code {
    [Parameter] public bool Open { get; set; }

    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    private List<CartLineModel> _cartItems = new();

    private bool _isLoading;

    private bool _isUpdating;

    private bool _hasLoaded;

    private bool IsBusy => _isLoading || _isUpdating;

    private decimal SubTotal => _cartItems.Sum(x => x.LineTotal);

    private decimal Total => SubTotal;

    protected override void OnInitialized()
    {
        _cartService.CartChanged += OnCartChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Open)
        {
            await LoadCartAsync();
        }
    }

    private void OnCartChanged()
    {
        _ = InvokeAsync(async () =>
        {
            if (Open)
            {
                await LoadCartAsync();
            }
        });
    }

    private async Task LoadCartAsync()
    {
        _isLoading = true;
        StateHasChanged();

        var result = await _cartService.GetItemsAsync();

        if (!result.Success)
        {
            _snackbar.Add(result.Message, Severity.Error);
            _cartItems = new List<CartLineModel>();
        }
        else
        {
            _cartItems = result.Data?.ToList() ?? new List<CartLineModel>();
        }

        _isLoading = false;
        _hasLoaded = true;
        StateHasChanged();
    }

    private async Task OnOpenChanged(bool value)
    {
        await OpenChanged.InvokeAsync(value);
    }

    private async Task Close()
    {
        Open = false;
        await OpenChanged.InvokeAsync(Open);
    }

    private async Task NavigateAndCloseAsync(string url)
    {
        await Close();
        _navigation.NavigateTo(url);
    }

    private async Task IncreaseQuantityAsync(CartLineModel item)
    {
        if (!item.CanIncrease || IsBusy)
        {
            _snackbar.Add("Không đủ số lượng trong kho", Severity.Warning);
            return;
        }

        await UpdateQuantityAsync(item, item.Quantity + 1);
    }

    private async Task DecreaseQuantityAsync(CartLineModel item)
    {
        if (item.Quantity <= 1 || IsBusy)
        {
            return;
        }

        await UpdateQuantityAsync(item, item.Quantity - 1);
    }

    private async Task UpdateQuantityAsync(CartLineModel item, int newQuantity)
    {
        _isUpdating = true;
        StateHasChanged();

        var result = await _cartService.UpdateQuantityAsync(item, newQuantity);

        if (!result.Success)
        {
            _snackbar.Add(result.Message, Severity.Error);
        }
        else
        {
            await LoadCartAsync();
        }

        _isUpdating = false;
        StateHasChanged();
    }

    private async Task RemoveItemAsync(CartLineModel item)
    {
        if (IsBusy)
        {
            return;
        }

        _isUpdating = true;
        StateHasChanged();

        var result = await _cartService.RemoveItemAsync(item.Id);

        if (!result.Success)
        {
            _snackbar.Add(result.Message, Severity.Error);
        }
        else
        {
            _snackbar.Add("Đã xóa sản phẩm khỏi giỏ hàng", Severity.Info);
            await LoadCartAsync();
        }

        _isUpdating = false;
        StateHasChanged();
    }

    private static string FormatMoney(decimal value)
    {
        return $"{value:N0} đ";
    }

    public void Dispose()
    {
        _cartService.CartChanged -= OnCartChanged;
    }
}
