@attribute [Route(RouterConfig.Customer.Cart)]
@layout MainLayout

<PageTitle>PickleChic WEB - Cart</PageTitle>

<div class="min-h-[calc(100vh-180px)] !bg-slate-50 !px-4 !pt-8 !pb-14">
    <div class="mx-auto w-full max-w-7xl">
        <div class="flex flex-col !gap-4 md:flex-row md:items-center md:justify-between">
            <div>
                <p class="text-sm font-bold tracking-[0.25em] text-[#d71920] uppercase">
                    PickleChic WEB
                </p>

                <h1 class="!mt-2 text-3xl font-black tracking-tight text-slate-950">
                    Giỏ hàng của bạn
                </h1>
            </div>

            <a href="@RouterConfig.Customer.Products"
               class="inline-flex items-center justify-center !gap-2 !rounded-full !border !border-slate-300 !bg-white !px-5 !py-2.5 text-sm font-black text-slate-900 transition hover:!border-[#d71920] hover:!text-[#d71920]">
                <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" />
                Tiếp tục mua sắm
            </a>
        </div>

        @if (!_cartItems.Any())
        {
            <div class="!mt-8 !rounded-3xl !border !border-slate-200 !bg-white !p-10 text-center shadow-sm">
                <div class="mx-auto flex !h-16 !w-16 items-center justify-center !rounded-full !bg-slate-100 text-slate-400">
                    <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Size="Size.Large" />
                </div>

                <h2 class="!mt-5 text-2xl font-black text-slate-950">
                    Giỏ hàng đang trống
                </h2>

                <p class="!mt-2 text-sm text-slate-500">
                    Hãy thêm sản phẩm yêu thích vào giỏ hàng của bạn.
                </p>

                <a href="@RouterConfig.Customer.Products"
                   class="!mt-6 inline-flex items-center justify-center !rounded-full !bg-black !px-7 !py-3 text-sm font-black !text-white transition hover:!bg-[#d71920]">
                    Mua sắm ngay
                </a>
            </div>
        }
        else
        {
            <div class="!mt-8 grid !gap-6 lg:grid-cols-12">
                <section class="lg:col-span-8">
                    <div class="overflow-hidden !rounded-3xl !border !border-slate-200 !bg-white shadow-sm">
                        <div class="hidden !border-b !border-slate-200 !bg-slate-50 !px-6 !py-4 text-sm font-black text-slate-500 md:grid md:grid-cols-12 md:items-center">
                            <div class="md:col-span-6">Sản phẩm</div>
                            <div class="text-center md:col-span-2">Đơn giá</div>
                            <div class="text-center md:col-span-2">Số lượng</div>
                            <div class="text-right md:col-span-2">Tạm tính</div>
                        </div>

                        <div class="divide-y divide-slate-200">
                            @foreach (var item in _cartItems)
                            {
                                <div class="!p-5 md:!gap-4 md:!px-6 md:grid md:grid-cols-12 md:items-center">
                                    <div class="flex min-w-0 !gap-4 md:col-span-6">
                                        <a href="@item.ProductUrl"
                                           class="flex !h-24 !w-24 shrink-0 items-center justify-center overflow-hidden !rounded-2xl !bg-slate-100">
                                            <MudIcon Icon="@Icons.Material.Filled.Image"
                                                     Class="text-slate-400" />
                                        </a>

                                        <div class="min-w-0 flex-1">
                                            <a href="@item.ProductUrl"
                                               class="line-clamp-2 text-base leading-6 font-black text-slate-950 transition hover:!text-[#d71920]">
                                                @item.Name
                                            </a>

                                            <p class="!mt-1 text-sm font-semibold text-slate-500">
                                                @item.Variant
                                            </p>

                                            <button type="button"
                                                    @onclick="() => RemoveItem(item.Id)"
                                                    class="!mt-3 inline-flex items-center !gap-1 text-sm font-bold text-slate-500 transition hover:!text-[#d71920]">
                                                <MudIcon Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small" />
                                                Xóa sản phẩm
                                            </button>
                                        </div>
                                    </div>

                                    <div class="!mt-5 flex items-center justify-between md:!mt-0 md:col-span-2 md:block md:text-center">
                                        <span class="text-sm font-semibold text-slate-500 md:hidden">
                                            Đơn giá
                                        </span>

                                        <span class="text-base font-black text-slate-950">
                                            @FormatMoney(item.Price)
                                        </span>
                                    </div>

                                    <div class="!mt-5 flex items-center justify-between md:!mt-0 md:col-span-2 md:justify-center">
                                        <span class="text-sm font-semibold text-slate-500 md:hidden">
                                            Số lượng
                                        </span>

                                        <div class="flex items-center !gap-2">
                                            <button type="button"
                                                    @onclick="() => DecreaseQuantity(item.Id)"
                                                    class="flex !h-9 !w-9 items-center justify-center !rounded-full !border !border-slate-300 !bg-white text-slate-900 transition hover:!border-[#d71920] hover:!text-[#d71920]">
                                                <MudIcon Icon="@Icons.Material.Filled.Remove" Size="Size.Small" />
                                            </button>

                                            <div class="flex !h-9 !w-12 items-center justify-center !rounded-full !border !border-slate-300 !bg-white text-sm font-black text-slate-900">
                                                @item.Quantity
                                            </div>

                                            <button type="button"
                                                    @onclick="() => IncreaseQuantity(item.Id)"
                                                    class="flex !h-9 !w-9 items-center justify-center !rounded-full !border !border-slate-300 !bg-white text-slate-900 transition hover:!border-[#d71920] hover:!text-[#d71920]">
                                                <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
                                            </button>
                                        </div>
                                    </div>

                                    <div class="!mt-5 flex items-center justify-between md:!mt-0 md:col-span-2 md:block md:text-right">
                                        <span class="text-sm font-semibold text-slate-500 md:hidden">
                                            Tạm tính
                                        </span>

                                        <span class="text-lg font-black text-[#d71920]">
                                            @FormatMoney(item.LineTotal)
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </section>

                <aside class="lg:col-span-4">
                    <div class="sticky top-32 !rounded-3xl !border !border-slate-200 !bg-white !p-6 shadow-sm">
                        <h2 class="text-xl font-black text-slate-950">
                            Tóm tắt đơn hàng
                        </h2>

                        <div class="!mt-5 !space-y-4">
                            <div class="flex items-center justify-between text-sm">
                                <span class="font-semibold text-slate-500">Số lượng sản phẩm</span>
                                <span class="font-black text-slate-950">@TotalQuantity</span>
                            </div>

                            <div class="flex items-center justify-between text-sm">
                                <span class="font-semibold text-slate-500">Tạm tính</span>
                                <span class="font-black text-slate-950">@FormatMoney(SubTotal)</span>
                            </div>

                            <div class="flex items-center justify-between text-sm">
                                <span class="font-semibold text-slate-500">Phí vận chuyển</span>
                                <span class="font-black text-slate-950">0 đ</span>
                            </div>
                        </div>

                        <div class="!mt-5 !border-t !border-slate-200 !pt-5">
                            <div class="flex items-end justify-between">
                                <span class="text-base font-black text-slate-950">Tổng cộng</span>
                                <span class="text-2xl font-black text-[#d71920]">@FormatMoney(Total)</span>
                            </div>
                        </div>

                        <div class="!mt-6 !space-y-3">
                            <a href="@RouterConfig.Customer.Checkout"
                               class="inline-flex w-full items-center justify-center !gap-2 !rounded-full !border !border-black !bg-black !px-6 !py-3 text-sm font-black !text-white shadow-sm transition hover:!border-[#d71920] hover:!bg-[#d71920] hover:!text-white">
                                <MudIcon Icon="@Icons.Material.Filled.Payment" Size="Size.Small" />
                                Thanh toán
                            </a>

                            <a href="@RouterConfig.Customer.Products"
                               class="inline-flex w-full items-center justify-center !gap-2 !rounded-full !border !border-slate-300 !bg-white !px-6 !py-3 text-sm font-black text-slate-900 transition hover:!border-[#d71920] hover:!text-[#d71920]">
                                <MudIcon Icon="@Icons.Material.Filled.ShoppingBag" Size="Size.Small" />
                                Mua thêm sản phẩm
                            </a>
                        </div>
                    </div>
                </aside>
            </div>
        }
    </div>
</div>

@code {
    private List<CartItem> _cartItems = new()
    {
        new()
        {
            Id = 1,
            Name = "Perseus Pro V Ben Johns Blaze Red 16mm",
            Variant = "Màu: Blaze Red / Độ dày: 16mm",
            Price = 7890000,
            Quantity = 1,
            ProductUrl = "/products/perseus-pro-v-ben-johns-blaze-red-16mm"
        },
        new()
        {
            Id = 2,
            Name = "Kosmos Pro V Rally Rocket 16mm",
            Variant = "Màu: Rally Rocket / Độ dày: 16mm",
            Price = 8990000,
            Quantity = 2,
            ProductUrl = "/products/kosmos-pro-v-rally-rocket-16mm"
        },
        new()
        {
            Id = 3,
            Name = "Hyperion Pro V Ben Johns Bolt Blue 16mm",
            Variant = "Màu: Bolt Blue / Độ dày: 16mm",
            Price = 7890000,
            Quantity = 1,
            ProductUrl = "/products/hyperion-pro-v-ben-johns-bolt-blue-16mm"
        }
    };

    private int TotalQuantity => _cartItems.Sum(x => x.Quantity);

    private decimal SubTotal => _cartItems.Sum(x => x.LineTotal);

    private decimal Total => SubTotal;

    private void IncreaseQuantity(int id)
    {
        var item = _cartItems.FirstOrDefault(x => x.Id == id);

        if (item is null)
        {
            return;
        }

        item.Quantity++;
    }

    private void DecreaseQuantity(int id)
    {
        var item = _cartItems.FirstOrDefault(x => x.Id == id);

        if (item is null)
        {
            return;
        }

        if (item.Quantity > 1)
        {
            item.Quantity--;
            return;
        }

        RemoveItem(id);
    }

    private void RemoveItem(int id)
    {
        var item = _cartItems.FirstOrDefault(x => x.Id == id);

        if (item is null)
        {
            return;
        }

        _cartItems.Remove(item);
    }

    private static string FormatMoney(decimal value)
    {
        return $"{value:N0} đ";
    }

    private class CartItem
    {
        public int Id { get; set; }

        public string Name { get; set; } = string.Empty;

        public string Variant { get; set; } = string.Empty;

        public decimal Price { get; set; }

        public int Quantity { get; set; }

        public string ProductUrl { get; set; } = string.Empty;

        public decimal LineTotal => Price * Quantity;
    }
}