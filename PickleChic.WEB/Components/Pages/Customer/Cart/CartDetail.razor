@attribute [Route(RouterConfig.Customer.Cart)]
@layout MainLayout

<PageTitle>PickleChic WEB - Cart</PageTitle>

<div class="min-h-[calc(100vh-180px)] !bg-slate-50 !px-4 !pt-8 !pb-14">
    <div class="mx-auto w-full max-w-7xl">
        <div class="flex flex-col !gap-4 md:flex-row md:items-center md:justify-between">
            <div>
                <p class="text-sm font-bold tracking-[0.25em] text-[#d71920] uppercase">
                    PickleChic WEB
                </p>

                <h1 class="!mt-2 text-3xl font-black tracking-tight text-slate-950">
                    Giỏ hàng của bạn
                </h1>
            </div>

            <a href="@RouterConfig.Customer.Products"
               class="inline-flex items-center justify-center !gap-2 !rounded-full !border !border-slate-300 !bg-white !px-5 !py-2.5 text-sm font-black text-slate-900 transition hover:!border-[#d71920] hover:!text-[#d71920]">
                <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" />
                Tiếp tục mua sắm
            </a>
        </div>

        @if (_hasLoaded && !_usesServerCart)
        {
            <div class="!mt-8 !rounded-3xl !border !border-slate-200 !bg-white !p-10 text-center shadow-sm">
                <div class="mx-auto flex !h-16 !w-16 items-center justify-center !rounded-full !bg-slate-100 text-slate-400">
                    <MudIcon Icon="@Icons.Material.Filled.Login" Size="Size.Large" />
                </div>

                <h2 class="!mt-5 text-2xl font-black text-slate-950">
                    Đăng nhập để xem giỏ hàng
                </h2>

                <p class="!mt-2 text-sm text-slate-500">
                    Vui lòng đăng nhập để quản lý sản phẩm trong giỏ hàng của bạn.
                </p>

                <a href="@RouterConfig.Customer.Login"
                   class="!mt-6 inline-flex items-center justify-center !rounded-full !bg-black !px-7 !py-3 text-sm font-black !text-white transition hover:!bg-[#d71920]">
                    Đăng nhập
                </a>
            </div>
        }
        else if (_hasLoaded && !_cartItems.Any())
        {
            <div class="!mt-8 !rounded-3xl !border !border-slate-200 !bg-white !p-10 text-center shadow-sm">
                <div class="mx-auto flex !h-16 !w-16 items-center justify-center !rounded-full !bg-slate-100 text-slate-400">
                    <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Size="Size.Large" />
                </div>

                <h2 class="!mt-5 text-2xl font-black text-slate-950">
                    Giỏ hàng đang trống
                </h2>

                <p class="!mt-2 text-sm text-slate-500">
                    Hãy thêm sản phẩm yêu thích vào giỏ hàng của bạn.
                </p>

                <a href="@RouterConfig.Customer.Products"
                   class="!mt-6 inline-flex items-center justify-center !rounded-full !bg-black !px-7 !py-3 text-sm font-black !text-white transition hover:!bg-[#d71920]">
                    Mua sắm ngay
                </a>
            </div>
        }
        else
        {
            <div class="!mt-8 grid items-start !gap-6 lg:grid-cols-12 @(IsBusy ? "pointer-events-none opacity-60" : string.Empty)">
                <section class="lg:col-span-8">
                    <div class="overflow-hidden !rounded-3xl !border !border-slate-200 !bg-white shadow-sm">
                        <div class="hidden !border-b !border-slate-200 !bg-slate-50 !px-6 !py-4 text-sm font-black text-slate-500 md:grid md:grid-cols-[minmax(0,1fr)_7.5rem_9rem_8rem] md:items-center md:!gap-4">
                            <div>Sản phẩm</div>
                            <div class="text-center">Đơn giá</div>
                            <div class="text-center">Số lượng</div>
                            <div class="text-right">Tạm tính</div>
                        </div>

                        <div class="divide-y divide-slate-200">
                            @foreach (var item in _cartItems)
                            {
                                <div class="!p-5 md:!gap-4 md:!px-6 md:grid md:grid-cols-[minmax(0,1fr)_7.5rem_9rem_8rem] md:items-center">
                                    <div class="flex min-w-0 !gap-3.5">
                                        <a href="@item.ProductUrl"
                                           class="relative flex !h-[4.75rem] !w-[4.75rem] shrink-0 items-center justify-center overflow-hidden !rounded-xl !border !border-slate-200 !bg-white !p-1.5">
                                            @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                            {
                                                <img src="@item.ImageUrl"
                                                     alt=""
                                                     class="max-h-full max-w-full object-contain"
                                                     onerror="this.classList.add('hidden'); var f=this.nextElementSibling; if(f) f.classList.remove('hidden');" />
                                                <span class="hidden text-slate-300">
                                                    <MudIcon Icon="@Icons.Material.Filled.Image" />
                                                </span>
                                            }
                                            else
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.Image"
                                                         Class="text-slate-300" />
                                            }
                                        </a>

                                        <div class="min-w-0 flex-1">
                                            <a href="@item.ProductUrl"
                                               class="line-clamp-2 text-base leading-6 font-black text-slate-950 transition hover:!text-[#d71920]">
                                                @item.Name
                                            </a>

                                            <p class="!mt-1 text-sm font-semibold text-slate-500">
                                                @item.Variant
                                            </p>

                                            @if (item.Quantity >= item.StockQuantity)
                                            {
                                                <p class="!mt-1 text-xs font-semibold text-[#d71920]">
                                                    Tối đa @item.StockQuantity sản phẩm
                                                </p>
                                            }

                                            <button type="button"
                                                    disabled="@IsBusy"
                                                    @onclick="() => RemoveItemAsync(item)"
                                                    class="!mt-3 inline-flex items-center !gap-1 text-sm font-bold text-slate-500 transition hover:!text-[#d71920] disabled:opacity-50">
                                                <MudIcon Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small" />
                                                Xóa sản phẩm
                                            </button>
                                        </div>
                                    </div>

                                    <div class="!mt-5 flex items-center justify-between md:!mt-0 md:block md:text-center">
                                        <span class="text-sm font-semibold text-slate-500 md:hidden">
                                            Đơn giá
                                        </span>

                                        <span class="text-base font-black text-slate-950">
                                            @FormatMoney(item.Price)
                                        </span>
                                    </div>

                                    <div class="!mt-5 flex items-center justify-between md:!mt-0 md:justify-center">
                                        <span class="text-sm font-semibold text-slate-500 md:hidden">
                                            Số lượng
                                        </span>

                                        <div class="flex items-center !gap-2">
                                            <button type="button"
                                                    disabled="@(IsBusy || item.Quantity <= 1)"
                                                    @onclick="() => DecreaseQuantityAsync(item)"
                                                    class="flex !h-9 !w-9 items-center justify-center !rounded-full !border !border-slate-300 !bg-white text-slate-900 transition hover:!border-[#d71920] hover:!text-[#d71920] disabled:!cursor-not-allowed disabled:opacity-50">
                                                <MudIcon Icon="@Icons.Material.Filled.Remove" Size="Size.Small" />
                                            </button>

                                            <div class="flex !h-9 !w-12 items-center justify-center !rounded-full !border !border-slate-300 !bg-white text-sm font-black text-slate-900">
                                                @item.Quantity
                                            </div>

                                            <button type="button"
                                                    disabled="@(IsBusy || !item.CanIncrease)"
                                                    title="@(item.CanIncrease ? null : "Không đủ số lượng trong kho")"
                                                    @onclick="() => IncreaseQuantityAsync(item)"
                                                    class="flex !h-9 !w-9 items-center justify-center !rounded-full !border !border-slate-300 !bg-white text-slate-900 transition hover:!border-[#d71920] hover:!text-[#d71920] disabled:!cursor-not-allowed disabled:opacity-50">
                                                <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
                                            </button>
                                        </div>
                                    </div>

                                    <div class="!mt-5 flex items-center justify-between md:!mt-0 md:block md:text-right">
                                        <span class="text-sm font-semibold text-slate-500 md:hidden">
                                            Tạm tính
                                        </span>

                                        <span class="text-lg font-black text-[#d71920]">
                                            @FormatMoney(item.LineTotal)
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </section>

                <aside class="sticky top-24 lg:col-span-4 lg:self-start">
                    <div class="!rounded-3xl !border !border-slate-200 !bg-white !p-6 shadow-sm">
                        <h2 class="text-xl font-black text-slate-950">
                            Tóm tắt đơn hàng
                        </h2>

                        <div class="!mt-5 !space-y-4">
                            <div class="flex items-center justify-between text-sm">
                                <span class="font-semibold text-slate-500">Số lượng sản phẩm</span>
                                <span class="font-black text-slate-950">@TotalQuantity</span>
                            </div>

                            <div class="flex items-center justify-between text-sm">
                                <span class="font-semibold text-slate-500">Tạm tính</span>
                                <span class="font-black text-slate-950">@FormatMoney(SubTotal)</span>
                            </div>

                            <div class="flex items-center justify-between text-sm">
                                <span class="font-semibold text-slate-500">Phí vận chuyển</span>
                                <span class="font-black text-slate-950">0 đ</span>
                            </div>
                        </div>

                        <div class="!mt-5 !border-t !border-slate-200 !pt-5">
                            <div class="flex items-end justify-between">
                                <span class="text-base font-black text-slate-950">Tổng cộng</span>
                                <span class="text-2xl font-black text-[#d71920]">@FormatMoney(Total)</span>
                            </div>
                        </div>

                        <div class="!mt-6 !space-y-3">
                            <a href="@RouterConfig.Customer.Checkout"
                               aria-disabled="@IsBusy"
                               class="inline-flex w-full items-center justify-center !gap-2 !rounded-full !border !border-black !bg-black !px-6 !py-3 text-sm font-black !text-white shadow-sm transition hover:!border-[#d71920] hover:!bg-[#d71920] hover:!text-white @(IsBusy ? "!pointer-events-none !opacity-50" : string.Empty)">
                                <MudIcon Icon="@Icons.Material.Filled.Payment" Size="Size.Small" />
                                Thanh toán
                            </a>

                            <a href="@RouterConfig.Customer.Products"
                               class="inline-flex w-full items-center justify-center !gap-2 !rounded-full !border !border-slate-300 !bg-white !px-6 !py-3 text-sm font-black text-slate-900 transition hover:!border-[#d71920] hover:!text-[#d71920]">
                                <MudIcon Icon="@Icons.Material.Filled.ShoppingBag" Size="Size.Small" />
                                Mua thêm sản phẩm
                            </a>
                        </div>
                    </div>
                </aside>
            </div>
        }
    </div>
</div>

@code {
    private List<CartLineModel> _cartItems = new();

    private bool _isLoading;

    private bool _isUpdating;

    private bool _hasLoaded;

    private bool _usesServerCart;

    private bool IsBusy => _isLoading || _isUpdating;

    private int TotalQuantity => _cartItems.Sum(x => x.Quantity);

    private decimal SubTotal => _cartItems.Sum(x => x.LineTotal);

    private decimal Total => SubTotal;

    protected override async Task OnInitializedAsync()
    {
        await LoadCartAsync();
    }

    private async Task LoadCartAsync()
    {
        _isLoading = true;
        StateHasChanged();

        _usesServerCart = await _cartService.UsesServerCartAsync();

        if (!_usesServerCart)
        {
            _cartItems = new List<CartLineModel>();
            _isLoading = false;
            _hasLoaded = true;
            StateHasChanged();
            return;
        }

        var result = await _cartService.GetItemsAsync();

        if (!result.Success)
        {
            _snackbar.Add(result.Message, Severity.Error);
            _cartItems = new List<CartLineModel>();
        }
        else
        {
            _cartItems = result.Data?.ToList() ?? new List<CartLineModel>();
        }

        _isLoading = false;
        _hasLoaded = true;
        StateHasChanged();
    }

    private async Task IncreaseQuantityAsync(CartLineModel item)
    {
        if (!item.CanIncrease || IsBusy)
        {
            _snackbar.Add("Không đủ số lượng trong kho", Severity.Warning);
            return;
        }

        await UpdateQuantityAsync(item, item.Quantity + 1);
    }

    private async Task DecreaseQuantityAsync(CartLineModel item)
    {
        if (IsBusy)
        {
            return;
        }

        if (item.Quantity <= 1)
        {
            await RemoveItemAsync(item);
            return;
        }

        await UpdateQuantityAsync(item, item.Quantity - 1);
    }

    private async Task UpdateQuantityAsync(CartLineModel item, int newQuantity)
    {
        _isUpdating = true;
        StateHasChanged();

        var result = await _cartService.UpdateQuantityAsync(item, newQuantity);

        if (!result.Success)
        {
            _snackbar.Add(result.Message, Severity.Error);
        }
        else
        {
            await LoadCartAsync();
        }

        _isUpdating = false;
        StateHasChanged();
    }

    private async Task RemoveItemAsync(CartLineModel item)
    {
        if (IsBusy)
        {
            return;
        }

        _isUpdating = true;
        StateHasChanged();

        var result = await _cartService.RemoveItemAsync(item.Id);

        if (!result.Success)
        {
            _snackbar.Add(result.Message, Severity.Error);
        }
        else
        {
            _snackbar.Add("Đã xóa sản phẩm khỏi giỏ hàng", Severity.Info);
            await LoadCartAsync();
        }

        _isUpdating = false;
        StateHasChanged();
    }

    private static string FormatMoney(decimal value)
    {
        return $"{value:N0} đ";
    }
}
