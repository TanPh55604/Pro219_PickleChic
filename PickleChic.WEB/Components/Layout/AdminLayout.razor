@inherits LayoutComponentBase
@implements IDisposable

<MudThemeProvider Theme="@ThemeConfig.AdminTheme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@if (_isCheckingAuth)
{
    <Loading />
}
else
{
    <div class="h-screen overflow-hidden !bg-[#f4f5f7] text-slate-900">
        <div class="flex h-full min-h-0">
            <AdminSidebar />

            <main class="flex min-w-0 flex-1 flex-col">
                <AdminHeader />

                <section class="min-h-0 flex-1 overflow-y-auto !p-6">
                    @Body
                </section>
            </main>
        </div>
    </div>
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _isCheckingAuth = true;
    private bool _isRedirecting;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _navigation.LocationChanged += OnLocationChanged;

        await CheckAdminAuthAsync();

        _isCheckingAuth = false;
        await InvokeAsync(StateHasChanged);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = InvokeAsync(CheckAdminAuthAsync);
    }

    private async Task CheckAdminAuthAsync()
    {
        if (_isRedirecting)
        {
            return;
        }

        var isAuthenticated = await _authStorageService.IsAuthenticatedAsync();

        if (!isAuthenticated)
        {
            await EndAdminSessionAsync("expired");
            return;
        }

        var result = await _currentUserService.CheckCurrentUserAsync();

        if (!result.Success || result.Data is null)
        {
            await EndAdminSessionAsync("invalid");
            return;
        }

        if (result.Data.IsCustomer)
        {
            _isRedirecting = true;
            _navigation.NavigateTo(RouterConfig.AccessDenied, replace: true);
        }
    }

    private async Task EndAdminSessionAsync(string reason)
    {
        _isRedirecting = true;
        await _authStorageService.ClearAuthAsync();

        var loginUrl = !_isCheckingAuth
            ? $"{RouterConfig.Admin.Login}?session={reason}"
            : RouterConfig.Admin.Login;

        _navigation.NavigateTo(loginUrl, replace: true);
    }

    public void Dispose()
    {
        _navigation.LocationChanged -= OnLocationChanged;
    }
}
