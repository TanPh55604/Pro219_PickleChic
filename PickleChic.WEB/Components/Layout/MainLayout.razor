@using PickleChic.WEB.Components.Pages.Customer.Cart
@inherits LayoutComponentBase

<MudThemeProvider Theme="@ThemeConfig.CustomerTheme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="flex min-h-screen flex-col bg-white text-neutral-950">
    <CustomerHeader OnCartClick="OpenQuickCart" />

    <main class="flex-1">
        @Body
    </main>

    <CustomerFooter />

    <QuickCartDrawer @bind-Open="_quickCartOpen" />
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _quickCartOpen;

    private void OpenQuickCart()
    {
        _quickCartOpen = true;
    }
}