<aside class="hidden !h-screen !w-72 shrink-0 flex-col !border-r !border-slate-200 !bg-white lg:flex">
    <div class="flex !h-16 shrink-0 items-center gap-3 !border-b !border-slate-200 !px-6">
        <MudAvatar Size="Size.Medium" class="flex !h-10 !w-10 items-center justify-center !rounded-xl !bg-[#A05AFF] !text-white shadow-sm">
            P
        </MudAvatar>

        <div class="min-w-0">
            <p class="truncate text-base font-bold text-[#A05AFF]">PICKLECHIC</p>
            <p class="truncate text-xs text-slate-500">PickleChic Management</p>
        </div>
    </div>

    <nav class="min-h-0 flex-1 !space-y-6 overflow-y-auto !px-4 !py-5">
        @if (HasAnyRead(RouterConfig.Admin.Home, RouterConfig.Admin.Dashboard))
        {
            <div class="!space-y-1">
                <p class="!px-4 !pb-2 text-xs font-semibold tracking-wider text-slate-400 uppercase">
                    Tổng quan
                </p>

                <AdminNavItem Href="@RouterConfig.Admin.Home"
                              Icon="@Icons.Material.Filled.Home"
                              Text="Trang chủ" />

                <AdminNavItem Href="@RouterConfig.Admin.Dashboard"
                              Icon="@Icons.Material.Filled.Dashboard"
                              Text="Thống kê" />
            </div>
        }

        @if (HasAnyRead(RouterConfig.Admin.Staffs, RouterConfig.Admin.Permissions))
        {
            <div class="!space-y-1">
                <p class="!px-4 !pb-2 text-xs font-semibold tracking-wider text-slate-400 uppercase">
                    Quản lý hệ thống
                </p>

                <AdminNavItem Href="@RouterConfig.Admin.Staffs"
                              Icon="@Icons.Material.Filled.ManageAccounts"
                              Text="Quản trị viên" />

                <AdminNavItem Href="@RouterConfig.Admin.Permissions"
                              Icon="@Icons.Material.Filled.Lock"
                              Text="Phân quyền" />
            </div>
        }

        @if (HasAnyRead(
                RouterConfig.Admin.Products,
                RouterConfig.Admin.Categories,
                RouterConfig.Admin.Brands,
                RouterConfig.Admin.Attributes))
        {
            <div class="!space-y-1">
                <p class="!px-4 !pb-2 text-xs font-semibold tracking-wider text-slate-400 uppercase">
                    Sản phẩm
                </p>

                <AdminNavItem Href="@RouterConfig.Admin.Products"
                              Icon="@Icons.Material.Filled.Inventory2"
                              Text="Sản phẩm" />

                <AdminNavItem Href="@RouterConfig.Admin.Categories"
                              Icon="@Icons.Material.Filled.Category"
                              Text="Thể loại" />

                <AdminNavItem Href="@RouterConfig.Admin.Brands"
                              Icon="@Icons.Material.Filled.LocalOffer"
                              Text="Thương hiệu" />

                <AdminNavItem Href="@RouterConfig.Admin.Attributes"
                              Icon="@Icons.Material.Filled.Extension"
                              Text="Thuộc tính" />
            </div>
        }

        @if (HasAnyRead(RouterConfig.Admin.Vouchers))
        {
            <div class="!space-y-1">
                <p class="!px-4 !pb-2 text-xs font-semibold tracking-wider text-slate-400 uppercase">
                    Khuyến mãi
                </p>

                <AdminNavItem Href="@RouterConfig.Admin.Vouchers"
                              Icon="@Icons.Material.Filled.ConfirmationNumber"
                              Text="Mã giảm giá" />

                @* <AdminNavItem Href="@RouterConfig.Admin.Promotions"
                              Icon="@Icons.Material.Filled.Sell"
                              Text="Sản phẩm giảm giá" /> *@
            </div>
        }

        @if (HasAnyRead(RouterConfig.Admin.Orders, RouterConfig.Admin.OfflineSales))
        {
            <div class="!space-y-1">
                <p class="!px-4 !pb-2 text-xs font-semibold tracking-wider text-slate-400 uppercase">
                    Bán hàng
                </p>

                <AdminNavItem Href="@RouterConfig.Admin.Orders"
                              Icon="@Icons.Material.Filled.ReceiptLong"
                              Text="Đơn hàng" />

                <AdminNavItem Href="@RouterConfig.Admin.OfflineSales"
                              Icon="@Icons.Material.Filled.PointOfSale"
                              Text="Bán hàng offline" />
            </div>
        }

        @* <div class="!space-y-1">
            <p class="!px-4 !pb-2 text-xs font-semibold tracking-wider text-slate-400 uppercase">
                Khách hàng
            </p>

            <AdminNavItem Href="@RouterConfig.Admin.Customers"
                          Icon="@Icons.Material.Filled.Groups"
                          Text="Khách hàng" />

        </div> *@

        @if (HasAnyRead(RouterConfig.Admin.Reviews, RouterConfig.Admin.Ranks))
        {
            <div class="!space-y-1">
                <p class="!px-4 !pb-2 text-xs font-semibold tracking-wider text-slate-400 uppercase">
                    Tương tác
                </p>

                <AdminNavItem Href="@RouterConfig.Admin.Reviews"
                              Icon="@Icons.Material.Filled.RateReview"
                              Text="Đánh giá" />

                <AdminNavItem Href="@RouterConfig.Admin.Ranks"
                              Icon="@Icons.Material.Filled.WorkspacePremium"
                              Text="Xếp hạng" />
                @* <AdminNavItem Href="@RouterConfig.Admin.Qna"
                              Icon="@Icons.Material.Filled.QuestionAnswer"
                              Text="Câu hỏi Q&A" /> *@
            </div>
        }
    </nav>

    <div class="shrink-0 !border-t !border-slate-200 !bg-white !p-4">
        <button type="button"
                @onclick="LogoutAsync"
                disabled="@_isLoggingOut"
                class="flex w-full items-center !gap-3 !rounded-xl !border !border-slate-200 !bg-slate-50 !px-3 !py-2.5 text-sm font-semibold text-slate-700 transition hover:!border-[#FE9496]/40 hover:!bg-[#FE9496]/10 hover:!text-[#FE9496] disabled:!cursor-not-allowed disabled:!opacity-60">
            <span class="flex !h-9 !w-9 items-center justify-center !rounded-lg !bg-[#FE9496]/15 text-[#FE9496]">
                <MudIcon Icon="@Icons.Material.Filled.Logout" Size="Size.Small" />
            </span>
            <span>@(_isLoggingOut ? "Đang đăng xuất.." : "Đăng xuất")</span>
        </button>
    </div>
</aside>

@code {
    [CascadingParameter(Name = Constant.CascadingNameParams.Mine)]
    public AuthModel? Mine { get; set; }

    private bool _isLoggingOut;

    private bool HasAnyRead(params string[] hrefs)
    {
        foreach (var href in hrefs)
        {
            var pageCode = PermissionHelper.GetPageCode(href);
            if (string.IsNullOrWhiteSpace(pageCode))
            {
                return true;
            }

            if (PermissionHelper.HasAccess(Mine, pageCode, Constant.ActionButton.Read))
            {
                return true;
            }
        }

        return false;
    }

    private async Task LogoutAsync()
    {
        if (_isLoggingOut)
        {
            return;
        }

        _isLoggingOut = true;

        try
        {
            await _authService.LogoutAsync();
            _snackbar.Add("Đã đăng xuất", Severity.Success);
            _navigation.NavigateTo(RouterConfig.Admin.Login, replace: true);
        }
        finally
        {
            _isLoggingOut = false;
        }
    }
}
