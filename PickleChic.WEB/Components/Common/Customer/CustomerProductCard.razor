<article class="group relative overflow-hidden !rounded-[1.75rem] border border-neutral-200 bg-white text-neutral-950 shadow-sm transition hover:-translate-y-1 hover:border-[#d71920]/30 hover:shadow-xl">
    @if (Item.DiscountPercent > 0)
    {
        <div class="absolute top-4 left-4 z-10 !rounded-full bg-[#d71920] !px-3 !py-1 text-xs font-black !text-white">
            -@Item.DiscountPercent%
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Item.Tag))
    {
        <div class="absolute top-4 right-4 z-10 !rounded-full bg-neutral-950 !px-3 !py-1 text-xs font-black !text-white">
            @Item.Tag
        </div>
    }

    <a href="@Item.ResolvedDetailUrl" class="block aspect-square bg-neutral-100 !p-4">
        @if (!string.IsNullOrWhiteSpace(Item.ImageUrl))
        {
            <div class="flex h-full items-center justify-center !rounded-[1.25rem] bg-white text-center">
                <img src="@Item.ImageUrl"
                     alt="@Item.Name"
                     class="max-h-full max-w-full object-contain transition duration-500 group-hover:scale-105" />
            </div>
        }
        else
        {
            <div class="flex h-full items-center justify-center text-neutral-400">
                <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Large" />
            </div>
        }
    </a>

    <div class="!space-y-3 !p-5">
        @if (!string.IsNullOrWhiteSpace(Item.BrandName))
        {
            <p class="text-xs font-black tracking-wide text-[#d71920] uppercase">
                @Item.BrandName
            </p>
        }

        <h3 class="line-clamp-2 min-h-12 text-sm leading-6 font-black tracking-[-0.02em] uppercase">
            <a href="@Item.ResolvedDetailUrl" class="transition hover:text-[#d71920]">
                @Item.Name
            </a>
        </h3>

        @if (!string.IsNullOrWhiteSpace(Item.CategoryName))
        {
            <p class="text-xs font-semibold text-neutral-500">
                @Item.CategoryName
            </p>
        }

        <div class="flex flex-wrap items-center !gap-2">
            <p class="text-lg font-black text-[#d71920]">
                @Item.DisplayPrice
            </p>

            @if (!string.IsNullOrWhiteSpace(Item.DisplayOldPrice))
            {
                <p class="text-sm font-bold text-neutral-400 line-through">
                    @Item.DisplayOldPrice
                </p>
            }
        </div>

        @if (ShowStockStatus)
        {
            <p class="text-xs font-bold @(Item.InStock ? "text-green-600" : "text-neutral-400")">
                @(Item.InStock ? "Còn hàng" : "Hết hàng")
            </p>
        }

        <div class="grid grid-cols-2 !gap-2 !pt-1">
            <button type="button"
                    disabled="@(!Item.InStock)"
                    @onclick="HandleQuickViewAsync"
                    class="!rounded-full !border !border-neutral-300 !px-3 !py-2 text-xs font-black uppercase transition hover:!border-neutral-950 disabled:!cursor-not-allowed disabled:!opacity-50">
                Xem nhanh
            </button>

            <button type="button"
                    disabled="@(!Item.InStock)"
                    @onclick="HandleBuyNowAsync"
                    class="!rounded-full !bg-neutral-950 !px-3 !py-2 text-xs font-black !text-white uppercase transition hover:!bg-[#d71920] disabled:!cursor-not-allowed disabled:!opacity-50">
                Mua ngay
            </button>
        </div>
    </div>
</article>

@code {
    [Parameter, EditorRequired]
    public ProductCardModel Item { get; set; } = new();

    [Parameter]
    public bool ShowStockStatus { get; set; } = true;

    [Parameter]
    public EventCallback<ProductCardModel> OnQuickView { get; set; }

    [Parameter]
    public EventCallback<ProductCardModel> OnBuyNow { get; set; }

    private async Task HandleQuickViewAsync()
    {
        if (OnQuickView.HasDelegate)
        {
            await OnQuickView.InvokeAsync(Item);
            return;
        }

        var parameters = new DialogParameters<ProductQuickViewDialog>
        {
            { x => x.Item, Item }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            CloseButton = true,
            CloseOnEscapeKey = true,
            NoHeader = true
        };

        await _dialogService.ShowAsync<ProductQuickViewDialog>(null, parameters, options);
    }

    private async Task HandleBuyNowAsync()
    {
        if (OnBuyNow.HasDelegate)
        {
            await OnBuyNow.InvokeAsync(Item);
            return;
        }

        if (Item.VariantId <= 0)
        {
            _snackbar.Add("Không xác định được biến thể sản phẩm", Severity.Warning);
            return;
        }

        if (!await _cartService.UsesServerCartAsync())
        {
            _snackbar.Add("Vui lòng đăng nhập để thêm vào giỏ hàng", Severity.Info);
            _navigation.NavigateTo(RouterConfig.Customer.Login);
            return;
        }

        var result = await _cartService.AddItemAsync(Item.VariantId, 1);

        if (!result.Success)
        {
            _snackbar.Add(result.Message, Severity.Error);
            return;
        }

        _snackbar.Add(result.Message, Severity.Success);
        _navigation.NavigateTo(RouterConfig.Customer.Checkout);
    }
}
