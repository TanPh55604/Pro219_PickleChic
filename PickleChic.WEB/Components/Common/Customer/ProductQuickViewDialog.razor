<MudDialog Class="!rounded-3xl">
    <DialogContent>
        <div class="!-mx-2 grid !gap-6 md:grid-cols-2 md:!gap-8">
            <div class="flex aspect-square items-center justify-center overflow-hidden !rounded-2xl !bg-neutral-100 !p-6">
                @if (!string.IsNullOrWhiteSpace(Item.ImageUrl))
                {
                    <img src="@Item.ImageUrl"
                         alt="@Item.Name"
                         class="max-h-full max-w-full object-contain" />
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Large" Class="text-neutral-400" />
                }
            </div>

            <div class="flex flex-col">
                @if (!string.IsNullOrWhiteSpace(Item.BrandName))
                {
                    <p class="text-xs font-black tracking-[0.22em] text-[#d71920] uppercase">
                        @Item.BrandName
                    </p>
                }

                <h2 class="!mt-2 text-2xl font-black leading-8 tracking-[-0.03em] text-neutral-950 uppercase">
                    @Item.Name
                </h2>

                @if (!string.IsNullOrWhiteSpace(Item.CategoryName))
                {
                    <p class="!mt-2 text-sm font-semibold text-neutral-500">
                        @Item.CategoryName
                    </p>
                }

                <div class="!mt-4 flex flex-wrap items-center !gap-3">
                    <p class="text-2xl font-black text-[#d71920]">
                        @Item.DisplayPrice
                    </p>

                    @if (!string.IsNullOrWhiteSpace(Item.DisplayOldPrice))
                    {
                        <p class="text-base font-bold text-neutral-400 line-through">
                            @Item.DisplayOldPrice
                        </p>
                    }

                    @if (Item.DiscountPercent > 0)
                    {
                        <span class="!rounded-full bg-[#d71920] !px-3 !py-1 text-xs font-black !text-white">
                            -@Item.DiscountPercent%
                        </span>
                    }
                </div>

                <p class="!mt-3 text-sm font-bold @(Item.InStock ? "text-green-600" : "text-neutral-400")">
                    @GetStockLabel()
                </p>

                @if (Item.InStock)
                {
                    <div class="!mt-6">
                        <p class="text-sm font-bold text-neutral-700">
                            Số lượng
                        </p>

                        <div class="!mt-3 flex items-center !gap-3">
                            <button type="button"
                                    disabled="@(_isSubmitting || _quantity <= 1)"
                                    @onclick="DecreaseQuantity"
                                    class="flex !h-10 !w-10 items-center justify-center !rounded-full !border !border-neutral-300 !bg-white text-neutral-900 transition hover:!border-[#d71920] hover:!text-[#d71920] disabled:!cursor-not-allowed disabled:opacity-50">
                                <MudIcon Icon="@Icons.Material.Filled.Remove" Size="Size.Small" />
                            </button>

                            <div class="flex !h-10 !w-14 items-center justify-center !rounded-full !border !border-neutral-300 text-base font-black text-neutral-900">
                                @_quantity
                            </div>

                            <button type="button"
                                    disabled="@(_isSubmitting || !CanIncrease)"
                                    title="@(CanIncrease ? null : "Không đủ số lượng trong kho")"
                                    @onclick="IncreaseQuantity"
                                    class="flex !h-10 !w-10 items-center justify-center !rounded-full !border !border-neutral-300 !bg-white text-neutral-900 transition hover:!border-[#d71920] hover:!text-[#d71920] disabled:!cursor-not-allowed disabled:opacity-50">
                                <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
                            </button>

                            @if (!CanIncrease && EffectiveStock > 0)
                            {
                                <span class="text-xs font-semibold text-[#d71920]">
                                    Tối đa @EffectiveStock
                                </span>
                            }
                        </div>
                    </div>
                }

                <div class="!mt-auto !pt-8 !space-y-3">
                    <button type="button"
                            disabled="@(!CanPurchase || _isSubmitting)"
                            @onclick="AddToCartAsync"
                            class="inline-flex w-full items-center justify-center !gap-2 !rounded-full !border !border-neutral-950 !bg-white !px-6 !py-3 text-sm font-black text-neutral-950 transition hover:!border-[#d71920] hover:!text-[#d71920] disabled:!cursor-not-allowed disabled:opacity-50">
                        <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Size="Size.Small" />
                        Thêm giỏ hàng
                    </button>

                    <button type="button"
                            disabled="@(!CanPurchase || _isSubmitting)"
                            @onclick="BuyNowAsync"
                            class="inline-flex w-full items-center justify-center !gap-2 !rounded-full !border !border-neutral-950 !bg-neutral-950 !px-6 !py-3 text-sm font-black !text-white transition hover:!border-[#d71920] hover:!bg-[#d71920] disabled:!cursor-not-allowed disabled:opacity-50">
                        <MudIcon Icon="@Icons.Material.Filled.Bolt" Size="Size.Small" />
                        Mua ngay
                    </button>

                    <a href="@Item.ResolvedDetailUrl"
                       class="inline-flex w-full items-center justify-center !gap-2 !rounded-full !border !border-neutral-300 !px-6 !py-3 text-sm font-black text-neutral-700 transition hover:!border-[#d71920] hover:!text-[#d71920]">
                        Xem chi tiết sản phẩm
                    </a>
                </div>
            </div>
        </div>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public ProductCardModel Item { get; set; } = new();

    private int _quantity = 1;

    private bool _isSubmitting;

    private int EffectiveStock =>
        Item.StockQuantity > 0
            ? Item.StockQuantity
            : Item.InStock ? 99 : 0;

    private bool CanIncrease => _quantity < EffectiveStock;

    private bool CanPurchase => Item.InStock && Item.VariantId > 0;

    protected override void OnParametersSet()
    {
        _quantity = Item.InStock ? 1 : 0;
    }

    private string GetStockLabel()
    {
        if (!Item.InStock)
        {
            return "Hết hàng";
        }

        if (Item.StockQuantity > 0)
        {
            return $"Còn {Item.StockQuantity} sản phẩm";
        }

        return "Còn hàng";
    }

    private void IncreaseQuantity()
    {
        if (!CanIncrease)
        {
            _snackbar.Add("Không đủ số lượng trong kho", Severity.Warning);
            return;
        }

        _quantity++;
    }

    private void DecreaseQuantity()
    {
        if (_quantity > 1)
        {
            _quantity--;
        }
    }

    private async Task AddToCartAsync()
    {
        var added = await TryAddToCartAsync();

        if (added)
        {
            MudDialog.Close();
        }
    }

    private async Task BuyNowAsync()
    {
        var added = await TryAddToCartAsync();

        if (added)
        {
            MudDialog.Close();
            _navigation.NavigateTo(RouterConfig.Customer.Checkout);
        }
    }

    private async Task<bool> TryAddToCartAsync()
    {
        if (!CanPurchase)
        {
            if (Item.VariantId <= 0)
            {
                _snackbar.Add("Sản phẩm demo chưa hỗ trợ mua trực tuyến", Severity.Warning);
            }

            return false;
        }

        if (!await _cartService.UsesServerCartAsync())
        {
            _snackbar.Add("Vui lòng đăng nhập để thêm vào giỏ hàng", Severity.Info);
            MudDialog.Close();
            _navigation.NavigateTo(RouterConfig.Customer.Login);
            return false;
        }

        if (_quantity > EffectiveStock)
        {
            _snackbar.Add("Không đủ số lượng trong kho", Severity.Warning);
            return false;
        }

        _isSubmitting = true;
        StateHasChanged();

        var result = await _cartService.AddItemAsync(Item.VariantId, _quantity);

        _isSubmitting = false;
        StateHasChanged();

        if (!result.Success)
        {
            _snackbar.Add(result.Message, Severity.Error);
            return false;
        }

        _snackbar.Add(result.Message, Severity.Success);
        return true;
    }
}
