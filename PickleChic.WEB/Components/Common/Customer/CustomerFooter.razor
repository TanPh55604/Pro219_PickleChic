<footer class="!bg-neutral-950 !text-white">
    <div class="mx-auto grid max-w-7xl !gap-10 !px-4 !py-14 md:grid-cols-[1.4fr_0.8fr_0.8fr_0.8fr]">
        <div>
            <p class="text-4xl font-black tracking-[-0.07em] uppercase">
                PickleChic
            </p>

            <p class="!mt-5 max-w-sm text-sm leading-7 !text-neutral-300">
                Cửa hàng pickleball phong cách PickleChic, tập trung vào vợt, phụ kiện,
                trang phục và trải nghiệm mua hàng rõ ràng.
            </p>

            <div class="!mt-6 flex items-center !gap-3">
                <div class="flex !h-10 !w-10 items-center justify-center !rounded-full !bg-[#d71920] text-sm font-black !text-white">
                    P
                </div>

                <div>
                    <p class="text-sm font-black tracking-[0.18em] !text-white uppercase">
                        PickleChic Store
                    </p>
                    <p class="!mt-1 text-xs font-semibold !text-neutral-400">
                        Pickleball Việt Nam
                    </p>
                </div>
            </div>
        </div>

        <div>
            <h4 class="text-sm font-black tracking-[0.22em] !text-white uppercase">
                Sản phẩm
            </h4>

            <ul class="!mt-5 !space-y-3 text-sm font-semibold">
                <li>
                    <a href="#" class="!text-neutral-300 transition hover:!text-[#d71920]">
                        Vợt Pickleball
                    </a>
                </li>
                <li>
                    <a href="#" class="!text-neutral-300 transition hover:!text-[#d71920]">
                        Phụ kiện
                    </a>
                </li>
                <li>
                    <a href="#" class="!text-neutral-300 transition hover:!text-[#d71920]">
                        Trang phục
                    </a>
                </li>
                <li>
                    <a href="#" class="!text-neutral-300 transition hover:!text-[#d71920]">
                        Giày Pickleball
                    </a>
                </li>
            </ul>
        </div>

        <div>
            <h4 class="text-sm font-black tracking-[0.22em] !text-white uppercase">
                Hỗ trợ
            </h4>

            <ul class="!mt-5 !space-y-3 text-sm font-semibold">
                <li>
                    <a href="#" class="!text-neutral-300 transition hover:!text-[#d71920]">
                        Hỏi đáp
                    </a>
                </li>
                <li>
                    <a href="#" class="!text-neutral-300 transition hover:!text-[#d71920]">
                        Liên hệ
                    </a>
                </li>
                <li>
                    <a href="#" class="!text-neutral-300 transition hover:!text-[#d71920]">
                        Chính sách đổi trả
                    </a>
                </li>
                <li>
                    <a href="#" class="!text-neutral-300 transition hover:!text-[#d71920]">
                        Giao hàng
                    </a>
                </li>
            </ul>
        </div>

        <div>
            <h4 class="text-sm font-black tracking-[0.22em] !text-white uppercase">
                Theo dõi
            </h4>

            <p class="!mt-5 text-sm leading-6 !text-neutral-300">
                Cập nhật sản phẩm mới, ưu đãi và nội dung pickleball từ PickleChic.
            </p>

            <div class="!mt-5 flex items-center !gap-3">
                <a href="#"
                   class="flex !h-10 !w-10 items-center justify-center !rounded-full !border !border-white/10 !bg-white/5 !text-white transition hover:!border-[#d71920] hover:!bg-[#d71920] hover:!text-white"
                   title="Facebook">
                    <MudIcon Icon="@Icons.Custom.Brands.Facebook" Size="Size.Small" />
                </a>

                <a href="#"
                   class="flex !h-10 !w-10 items-center justify-center !rounded-full !border !border-white/10 !bg-white/5 !text-white transition hover:!border-[#d71920] hover:!bg-[#d71920] hover:!text-white"
                   title="Instagram">
                    <MudIcon Icon="@Icons.Custom.Brands.Instagram" Size="Size.Small" />
                </a>

                <a href="#"
                   class="flex !h-10 !w-10 items-center justify-center !rounded-full !border !border-white/10 !bg-white/5 !text-white transition hover:!border-[#d71920] hover:!bg-[#d71920] hover:!text-white"
                   title="TikTok">
                    <MudIcon Icon="@Icons.Material.Filled.MusicNote" Size="Size.Small" />
                </a>

                <a href="#"
                   class="flex !h-10 !w-10 items-center justify-center !rounded-full !border !border-white/10 !bg-white/5 !text-white transition hover:!border-[#d71920] hover:!bg-[#d71920] hover:!text-white"
                   title="YouTube">
                    <MudIcon Icon="@Icons.Custom.Brands.YouTube" Size="Size.Small" />
                </a>
            </div>
        </div>
    </div>

    <div class="!border-t !border-white/10">
        <div class="mx-auto flex max-w-7xl flex-col items-center justify-between !gap-3 !px-4 !py-5 text-xs font-bold tracking-[0.18em] !text-neutral-400 uppercase md:flex-row">
            <p>
                © @DateTime.Now.Year PickleChic Store
            </p>

            <p>
                UI Concept For Pickleball Shop
            </p>
        </div>
    </div>
</footer>